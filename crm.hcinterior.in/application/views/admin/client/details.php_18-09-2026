<script>
    $(document).on('click', '#savePaymentPlan', function() {

        var client_id = $(this).data('client');
        var payment_plan = $('#payment_plan').val();

        if (payment_plan == '') {
            alert('Please select payment plan');
            return false;
        }

        $.ajax({
            url: '<?= base_url("admin/client/update_payment_plan") ?>',
            type: 'POST',
            dataType: 'json',
            data: {
                client_id: client_id,
                payment_plan: payment_plan
            },
            success: function(res) {

                console.log(res);

                if (res.status == 'success') {
                    location.reload();
                } else {
                    alert('Something went wrong');
                }
            },
            error: function(xhr) {
                console.log(xhr.responseText);
                alert('Ajax Error');
            }
        });

    });


    $(document).on('click', '#updateOperationStatus', function() {

        var $btn = $(this);
        var client_id = $btn.data('client-id');
        var operation_status = $('#operation_status').val();

        if (operation_status == '') {
            alert('Please select operation status');
            return false;
        }

        if (!confirm('Are you sure you want to change status to ' + operation_status + '?')) {
            return false;
        }

        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Please wait...');

        $.ajax({
            url: '<?= base_url("admin/client/update_operation_status") ?>',
            type: 'POST',
            dataType: 'json',
            data: {
                client_id: client_id,
                operation_status: operation_status
            },

            success: function(res) {

                if (res.status == 'success') {
                    location.reload();
                } else {
                    $btn.prop('disabled', false).text('Update');
                    alert(res.message || 'Something went wrong');
                }

            },

            error: function(xhr) {
                $btn.prop('disabled', false).text('Update');
                console.log(xhr.responseText);
                alert('Ajax Error');
            }
        });

    });
</script>

