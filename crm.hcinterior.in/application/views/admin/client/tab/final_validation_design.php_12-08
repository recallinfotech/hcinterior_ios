  <div class="panel panel-custom">

  
    <header class="panel-heading">
        <div class="panel-title"><strong><?= lang('Final Validation') . ' ' . lang('Design') ?></strong>
            <div class="pull-right hidden-print">

            </div>

        </div>
    </header>

    <div class="  mb-lg  m-5">

    <form method="GET">

        <div class="col-md-4">

            <label>
                <strong>Design Style</strong>
            </label>

            <select
                name="design_style"
                class="form-control"
            >
                <option value="">
                    All Design Styles
                </option>

                <option
                    value="Pre Validation Design"
                    <?= ($this->input->get('design_style')
                        == 'Pre Validation Design')
                        ? 'selected'
                        : '' ?>
                >
                    Pre Validation Design
                </option>

                <option
                    value="Post Validation Design"
                    <?= ($this->input->get('design_style')
                        == 'Post Validation Design')
                        ? 'selected'
                        : '' ?>
                >
                    Post Validation Design
                </option>

            </select>

        </div>

        <div class="col-md-3">

            <label>
                <strong>Is Final</strong>
            </label>

            <select
                name="is_final"
                class="form-control"
            >
                <option value="">
                    All
                </option>

                <option
                    value="1"
                    <?= ($this->input->get('is_final')
                        == '1')
                        ? 'selected'
                        : '' ?>
                >
                    Yes
                </option>

                <option
                    value="0"
                    <?= ($this->input->get('is_final')
                        == '0')
                        ? 'selected'
                        : '' ?>
                >
                    No
                </option>

            </select>

        </div>

        <div class="col-md-3">

            <label>
                <strong>Status</strong>
            </label>

            <select
                name="status"
                class="form-control"
            >
                <option value="">All</option>

                <option
                    value="Approved"
                    <?= ($this->input->get('status')
                        == 'Approved')
                        ? 'selected'
                        : '' ?>
                >
                    Approved
                </option>

                <option
                    value="Pending"
                    <?= ($this->input->get('status')
                        == 'Pending')
                        ? 'selected'
                        : '' ?>
                >
                    Pending
                </option>

                <option
                    value="Reject"
                    <?= ($this->input->get('status')
                        == 'Reject')
                        ? 'selected'
                        : '' ?>
                >
                    Reject
                </option>

            </select>

        </div>

        <div class="col-md-2" style="margin-top:25px;">

            <button
                type="submit"
                class="btn btn-primary"
            >
                Filter
            </button>

            <a
                href="<?= current_url() ?>"
                class="btn btn-default"
            >
                Reset
            </a>

        </div>

    </form>

</div>

    <div class="panel-body">

    

<table  class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Client</th>
            <th>File Name</th>
            <th>File</th>
            <th>Is Final</th>
    <th>Design</th>
            <th width="10%">URL</th>
            <th>Status</th>
            <th>Uploaded By</th>
            <th>Date</th>
        </tr>
    </thead>

    <tbody>

    <?php if(!empty($two_d_design)){ ?>

        <?php foreach($two_d_design as $design){ ?>

            <tr>

              <td>
    <a
        href="<?= base_url('admin/client/details/'.$design->client_id) ?>"
        target="_blank"
        style="font-weight:600;color:#23b7e5;"
    >
        <?= $design->client_name ?>
        (<?= $design->client_sr_id ?>)
    </a>
</td>

                <td>
                    

                    <?= $design->file_name ?>
                </td>

                <td>
                    <?php
                    $files = json_decode($design->upload_file);

                    if(!empty($files)){
                        foreach($files as $file){

                            if($file->is_image){
                                echo '<img
                                    src="'.base_url($file->path).'"
                                    width="60"
                                    class="preview-design"
                                    style="margin-right:5px;">';
                            } else {

                                echo '<a target="_blank"
                                    href="'.base_url($file->path).'">
                                    '.$file->fileName.'
                                </a><br>';
                            }
                        }
                    }
                    ?>
                </td>

              <td>
    <span class="label label-<?=
        ($design->is_final == 1)
        ? 'success'
        : 'warning';
    ?>">
        <?= ($design->is_final == 1)
            ? 'Yes'
            : 'No'; ?>
    </span>
</td>

<td><?= $design->design_style ?></td>

                <td><a class="btn btn-primary" target="_blank" href="<?= $design->upload_url ?>"> View </a></td>

             <td>
    <span class="label label-<?=
        $design->status == 'Approved'
            ? 'success'
            : (
                $design->status == 'Pending'
                    ? 'warning'
                    : 'danger'
            );
    ?>">

        <?= $design->status ?>

    </span>
</td>

                <td>
                    <?= !empty($design->fullname)
                        ? $design->fullname
                        : '-' ?>
                </td>

                <td>
                    <?= date(
                        'd M Y h:i A',
                        strtotime($design->created_date)
                    ) ?>
                </td>

            </tr>

        <?php } ?>

    <?php } else { ?>

        <tr>
            <td colspan="8" class="text-center">
                No Final Designs Found
            </td>
        </tr>

    <?php } ?>

    </tbody>
</table>
</div>
</div>
