 public function update_timeline()
{
    $tasks = $this->input->post('tasks');

    if (!empty($tasks)) {

        foreach ($tasks as $task) {

            $start = !empty($task['start_date']) ? $task['start_date'] : NULL;
            $end   = !empty($task['end_date'])   ? $task['end_date']   : NULL;

            $duration = NULL;

            if (!empty($start) && !empty($end)) {
                $start_date = new DateTime($start);
                $end_date   = new DateTime($end);
                $diff       = $start_date->diff($end_date);
                $duration   = $diff->days;
            }

            $this->db->where('id', $task['id']);
            $this->db->update('tbl_client_timeline', [
                'start_date' => $start,
                'end_date'   => $end,
                'duration'   => $duration
            ]);
        }
    }


 
    set_message('success', 'Timeline Updated Successfully');
    redirect($_SERVER['HTTP_REFERER']);
}



public function assign_default_user_permissions($client_id, $user_id, $profile, $permissions = [])
{
    // 1️⃣ Check if already assigned in team
    $exists = $this->db->where([
        'client_id' => $client_id,
        'user_id'   => $user_id,
        'member_profile' => $profile
    ])->get('tbl_client_assign_team')->row();

    if(empty($exists)){

        $this->db->insert('tbl_client_assign_team', [
            'client_id'     => $client_id,
            'user_id'       => $user_id,
            'member_profile'=> $profile,
            'created_date'  => date('Y-m-d H:i:s'),
            'updated_date'  => date('Y-m-d H:i:s'),
            'added_by'      => $this->session->userdata('user_id')
        ]);
    }

    // 2️⃣ Delete old permissions (optional safe reset)
    $this->db->where([
        'client_id' => $client_id,
        'user_id'   => $user_id
    ])->delete('operation_permissions');

    // 3️⃣ Insert default permissions
    if(!empty($permissions)){
        foreach ($permissions as $perm){

            $this->db->insert('operation_permissions', [
                'client_id'     => $client_id,
                'user_id'       => $user_id,
                'profile'       => $profile,
                'permission_key'=> $perm,
                'created_at'    => date('Y-m-d H:i:s')
            ]);
        }
    }

    return true;
}



