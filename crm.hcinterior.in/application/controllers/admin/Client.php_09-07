  public function dispatch_request_status()
{
    if (!$this->input->post('design_id')) {
        set_message('error', 'Invalid Client');
        redirect('admin/client/manage_client');
    }

    $design_id  = $this->input->post('design_id', true);
    $client_id  = $this->input->post('client_id', true);
    $status     = $this->input->post('status');
    $remarks    = $this->input->post('remark');

    $is_return      = $this->input->post('is_return');
    $return_remark  = $this->input->post('return_remark');
    $is_recived     = $this->input->post('is_recived');
    $recived_date   = $this->input->post('recived_date');

    $data = array();

    // -------- APPROVE / HOLD --------
    if (!empty($status)) {

        $data['status'] = $status;
        $data['status_approve_by'] = $this->session->userdata('user_id');
        $data['status_approve_date'] = date('Y-m-d H:i:s');

        if ($status == 'Reject') {
            $data['remark'] = $remarks;
        } else {
            $data['remark'] = null;
        }
    }

    // -------- RETURN --------
    if ($is_return !== null) {
        $data['is_return'] = $is_return;
        $data['return_remark'] = $return_remark;
    }

    // -------- RECEIVE --------
    if ($is_recived !== null) {
        $data['is_recived'] = $is_recived;

        if ($is_recived == 1) {
            $data['recived_date'] = !empty($recived_date) ? $recived_date : date('Y-m-d');
        }
    }

    // Remove empty values
    foreach ($data as $key => $value) {
        if ($value === '' || $value === null) {
            unset($data[$key]);
        }
    }

    $this->db->where('id', $design_id);
    $update = $this->db->update('tbl_client_dispatch', $data);

    if ($update) {
        set_message('success', 'Dispatch updated successfully');
    } else {
        set_message('error', 'Something went wrong, please try again');
    }

    redirect($_SERVER['HTTP_REFERER']);
}

   
public function new_mom($id = NULL)
{

 
    $client_id = $this->input->post('client_id', true);

    if (empty($client_id)) {
        redirect($_SERVER['HTTP_REFERER']);
    }

    $n_data['client_id']     = $client_id;
    $n_data['file_name']     = $this->input->post('file_name', true);
    $n_data['status']     = 'Pending';
    $n_data['design_type']     = $this->input->post('design_type', true);
    $n_data['created_date']  = date('Y-m-d H:i:s');
    $n_data['updated_date']  = date('Y-m-d H:i:s');

  

    $upload_file = [];
$target_path = getcwd() . "/uploads/";

if (!empty($_FILES['design_files']['name'][0])) {

    $files = $_FILES['design_files'];

    for ($i = 0; $i < count($files['name']); $i++) {

        if ($files['error'][$i] == 0) {

            $original_name = $files['name'][$i];
            $tmp_name      = $files['tmp_name'][$i];
            $ext           = strtolower(pathinfo($original_name, PATHINFO_EXTENSION));

            $allowed_ext = ['jpg','jpeg','png','pdf','dwg','ppt','pptx'];

            if (!in_array($ext, $allowed_ext)) {
                continue;
            }

            $new_name = time() . '_' . uniqid() . '.' . $ext;
            move_uploaded_file($tmp_name, $target_path . $new_name);

            $upload_file[] = [
                'fileName' => $new_name,
                'path'     => 'uploads/' . $new_name,
                'fullPath' => $target_path . $new_name,
                'size'     => round($files['size'][$i] / 1024, 2),
                'is_image' => in_array($ext, ['jpg','jpeg','png']) ? 1 : 0,
            ];
        }
    }
}


    // Existing files (Edit mode)
    $fileName  = $this->input->post('fileName', true);
    $path      = $this->input->post('path', true);
    $fullPath  = $this->input->post('fullPath', true);
    $size      = $this->input->post('size', true);
    $is_image  = $this->input->post('is_image', true);

    if (!empty($fileName)) {
        foreach ($fileName as $key => $name) {
            $upload_file[] = array(
                'fileName' => $name,
                'path'     => $path[$key],
                'fullPath' => $fullPath[$key],
                'size'     => $size[$key],
                'is_image' => $is_image[$key],
            );
        }
    }

  //  $n_data['upload_file'] = !empty($upload_file) ? json_encode($upload_file) : NULL;

  $n_data['upload_file'] = !empty($upload_file)
    ? json_encode($upload_file)
    : NULL;

    /* ===============================
       SAVE DATA
       =============================== */

    $this->client_model->_table_name  = 'tbl_client_mom';
    $this->client_model->_primary_key = 'id';

  $save =  $this->client_model->save($n_data, $id);



       if ($save) {
 

    $role_permission_map = [

    'SPM' => ['kt_accept'],

    //'Design Manager' => ['execution_timeline'],

    'Project Manager' => ['validation_accept', 'kt_ack'],

    'Supervisor' => ['store_purchase_request', 'purchase_request'],

    'QC' => ['final_drawing', 'three_d', 'drawing']

];

          
         


$team_members = get_client_team_members($client_id);

// print_r($team_members);
// exit();
$allowed_roles = ['SPM', 'Project Manager', 'Project Coordinator'];

foreach ($team_members as $member) {

    $role = $member->member_profile;
    $user_id = $member->user_id;

     if (!in_array($role, $allowed_roles)) {
        continue;
    }


     if ($user_id == $this->session->userdata('user_id')) {
        continue;
    }


     $client = $this->db
        ->where('client_id', $client_id)
        ->get('tbl_client')
        ->row();
 
    $clientName = $client->name ?? 'N/A';
 
    $subject = 'MOM/Checklist has been successfully uploaded for Mr. Manish '.$clientName;

    $message = 'MOM/Checklist has been successfully uploaded for Mr. Manish '.$clientName;


    add_notification([
        'to_user_id'   => $user_id,
        'from_user_id' => $this->session->userdata('user_id'),
        'description' =>  $message,
        'link' => 'admin/client/details/'.$client_id.'/mom',
        'value' => $message,
    ]);

    show_notification($user_ids);


    if (isset($role_permission_map[$role])) {

        $permissions = $role_permission_map[$role];

        foreach ($permissions as $perm) {

            $perm_exists = $this->db
                ->where('client_id', $client_id)
                ->where('user_id', $user_id)
                ->where('permission_key', $perm)
                ->get('operation_permissions')
                ->row();

            if (!$perm_exists) {

                $this->db->insert('operation_permissions', [
                    'client_id'     => $client_id,
                    'user_id'       => $user_id,
                    'permission_key'=> $perm,
                    'created_at'    => date('Y-m-d H:i:s')
                ]);

            }

        }

    }

}

    }




    set_message('success', 'MOM uploaded successfully');

    redirect('admin/client/details/' . $client_id . '/mom');
}



