     if (!in_array($role, $allowed_roles)) {
        continue;
    }
     if ($user_id == $this->session->userdata('user_id')) {
        continue;
    }
     $client = $this->db
        ->where('client_id', $client_id)
        ->get('tbl_client')
        ->row();
 
 
        $clientName = $client->name ?? 'N/A';
        $userName = $_SESSION['user_name'] ?? 'User';
          $subject =  ' Purchase request for '.$clientName. 'BOM' ;
         $message = ' Purchase request for '.$clientName. 'BOM' ;

         
       
    add_notification([
        'to_user_id'   => $user_id,
        'from_user_id' => $this->session->userdata('user_id'),
        'description' =>  $message,
        'link' => 'admin/client/details/'.$client_id.'/purchase_request',
        'value' => $message,
    ]);
    show_notification([$user_id]);
}

}

    set_message('success', 'Purchase uploaded successfully');

    redirect('admin/client/details/' . $client_id . '/purchase_request');
}



   
public function new_dispatch($id = NULL)
{
    $client_id = $this->input->post('client_id', true);

    if (empty($client_id)) {
        redirect($_SERVER['HTTP_REFERER']);
    }

    $n_data['client_id']     = $client_id;
    $n_data['file_name']     = $this->input->post('file_name', true);
     $n_data['created_date']  = date('Y-m-d H:i:s');
    $n_data['updated_date']  = date('Y-m-d H:i:s');
    $n_data['upload_url']  = $this->input->post('upload_url', true);

    /* ===============================
       FILE UPLOAD LOGIC (FROM TICKETS)
       =============================== */

    $upload_file = array();
    $files = $this->input->post("files", true);
    $target_path = getcwd() . "/uploads/";

    // Dropzone uploaded files
    if (!empty($files) && is_array($files)) {
        foreach ($files as $key => $file) {
            if (!empty($file)) {

                $file_name = $this->input->post('file_name_' . $file, true);
                $new_file_name = move_temp_file($file_name, $target_path);

                $file_ext = explode(".", $new_file_name);
                $is_image = check_image_extension($new_file_name);
                $size = $this->input->post('file_size_' . $file, true) / 1000;

                if ($new_file_name) {
                    $upload_file[] = array(
                        "fileName"  => $new_file_name,
                        "path"      => "uploads/" . $new_file_name,
                        "fullPath"  => getcwd() . "/uploads/" . $new_file_name,
                        "ext"       => '.' . end($file_ext),
                        "size"      => round($size, 2),
                        "is_image"  => $is_image,
                    );
                }
            }
        }
    }

    // Existing files (Edit mode)
    $fileName  = $this->input->post('fileName', true);
    $path      = $this->input->post('path', true);
    $fullPath  = $this->input->post('fullPath', true);
    $size      = $this->input->post('size', true);
    $is_image  = $this->input->post('is_image', true);

    if (!empty($fileName)) {
        foreach ($fileName as $key => $name) {
            $upload_file[] = array(
                'fileName' => $name,
                'path'     => $path[$key],
                'fullPath' => $fullPath[$key],
                'size'     => $size[$key],
                'is_image' => $is_image[$key],
            );
        }
    }

    $n_data['upload_file'] = !empty($upload_file) ? json_encode($upload_file) : NULL;

    /* ===============================
       SAVE DATA
       =============================== */

    $this->client_model->_table_name  = 'tbl_client_dispatch';
    $this->client_model->_primary_key = 'id';

    $this->client_model->save($n_data, $id);

    set_message('success', 'Purchase uploaded successfully');

    redirect('admin/client/details/' . $client_id . '/dispatch');
}




   
