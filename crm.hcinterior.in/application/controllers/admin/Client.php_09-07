        foreach ($permission_list as $perm) {

            $this->db->insert('operation_permissions', [
                'client_id'     => $client_id,
                'user_id'       => $user_id,
                'permission_key'=> $perm,
                'created_at'    => date('Y-m-d H:i:s')
            ]);
        }
    }
}


