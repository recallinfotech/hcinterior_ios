    $custom_where = [];

/*
|--------------------------------------------------------------------------
| COMMON FUNCTION
|--------------------------------------------------------------------------
*/

function filter_timeline_range($table_field, $from, $to, $db)
{
    if (empty($from) || empty($to)) {
        return [];
    }

    $rows = $db
        ->select('client_id, '.$table_field)
        ->get('timeline_manual_dates')
        ->result();

    $client_ids = [];

    foreach ($rows as $row) {

        $value = $row->$table_field;

        if (empty($value)) {
            continue;
        }

        /*
        |--------------------------------------------------------------------------
        | HANDLE RANGE
        |--------------------------------------------------------------------------
        | Example:
        | 30-05-2026 - 04-06-2026
        */

        if (strpos($value, ' - ') !== false) {

            $dates = explode(' - ', $value);

        } else {

            $dates = [$value];
        }

        foreach ($dates as $single_date) {

            $single_date = trim($single_date);

            $date = DateTime::createFromFormat('d-m-Y', $single_date);

            if (!$date) {
                continue;
            }

            $current = $date->format('Y-m-d');

            if ($current >= $from && $current <= $to) {

                $client_ids[] = $row->client_id;
                break;
            }
        }
    }

    return array_unique($client_ids);
}

