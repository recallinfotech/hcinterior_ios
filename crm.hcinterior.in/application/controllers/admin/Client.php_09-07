                "data" => $data
            );

        echo json_encode($output);
        exit;
        } else {
            redirect('admin/dashboard');
        }
    }




    private function getTaskStatus_list($client_id, $task_name)
{
    $row = $this->db
        ->select('status')
        ->where('client_id', $client_id)
        ->where('task_name', $task_name)
        ->get('timeline_task_status')
        ->row();

    return (!empty($row) && $row->status == 'Done') ? 1 : 0;
}


 public function get_client_assign_users()
{
    $client_id = $this->input->post('client_id');

    $login_user_id = $this->session->userdata('user_id');

    $users = $this->db
        ->select('tbl_account_details.user_id, tbl_account_details.fullname')
        ->from('tbl_client_assign_team')
        ->join(
            'tbl_account_details',
            'tbl_account_details.user_id = tbl_client_assign_team.user_id'
        )
        ->where('tbl_client_assign_team.client_id', $client_id)
        ->where('tbl_client_assign_team.user_id !=', $login_user_id)
        ->order_by('tbl_account_details.fullname', 'ASC')
        ->get()
        ->result();

    echo '<option value="">Select User</option>';

    foreach ($users as $user) {

        echo '<option value="'.$user->user_id.'">'
            .$user->fullname.
            '</option>';
    }
}

        public function save_escalation()
        {
            $data = [
                'client_id'   => $this->input->post('client_id'),
                'raised_by'   => $this->session->userdata('user_id'),
                'assigned_to' => $this->input->post('assigned_to'),
                'remark'      => $this->input->post('remark'),
                'status'      => 'Open',
                'created_at'  => date('Y-m-d H:i:s')
            ];

            $exists = $this->db
            ->where('client_id', $this->input->post('client_id'))
            ->where('assigned_to', $this->input->post('assigned_to'))
            ->where_in('status', ['Open','Replied','Reopened'])
            ->get('tbl_client_escalation')
            ->row();

        if($exists){

            set_message(
                'error',
                'Active escalation already exists. Please reply on it.'
            );

            redirect($_SERVER['HTTP_REFERER']);
        }

            $this->db->insert('tbl_client_escalation', $data);

            set_message('success', 'Escalation created successfully');

            redirect($_SERVER['HTTP_REFERER']);
        }

        public function save_escalation_reply()
        {
            $escalation_id = $this->input->post('escalation_id');

            $this->db->insert(
                'tbl_client_escalation_comments',
                [
                    'escalation_id' => $escalation_id,
                    'user_id'       => $this->session->userdata('user_id'),
                    'comment'       => $this->input->post('comment'),
                    'created_at'    => date('Y-m-d H:i:s')
                ]
            );

            $this->db
                ->where('id', $escalation_id)
                ->update(
                    'tbl_client_escalation',
                    [
                        'status' => 'Replied'
                    ]
                );

            echo 1;
        }


        public function get_escalation_history()
        {
        $client_id = $this->input->post('client_id');

            $active = $this->db
                ->where('client_id', $client_id)
                ->where_in('status', ['Open','Replied','Reopened'])
                ->order_by('id', 'DESC')
                ->get('tbl_client_escalation')
                ->row();


        
            $current_user = $this->session->userdata('user_id');
        $user_type    = $this->session->userdata('user_type');

        $this->db->where('client_id', $client_id);

        /*
        |--------------------------------------------------------------------------
        | ADMIN -> SAB DEKHEGA
        |--------------------------------------------------------------------------
        */

        if ($user_type != 1) {

            /*
            |--------------------------------------------------------------------------
            | NORMAL USER
            |--------------------------------------------------------------------------
            | Sirf:
            | Raised By Me
            | Assigned To Me
            */

            $this->db->group_start();

            $this->db->where('raised_by', $current_user);

            $this->db->or_where('assigned_to', $current_user);

            $this->db->group_end();
        }

        $rows = $this->db
            ->order_by('id', 'DESC')
            ->get('tbl_client_escalation')
            ->result();

        
            $html = '';

            if (empty($rows)) {

                $html .= '
                <div class="alert alert-info">
                    No escalation found
                </div>';

            } else {

                $html .= '
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Assigned To</th>
                            <th>Remark</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th width="180">Action</th>
                        </tr>
                    </thead>
                    <tbody>';

                foreach ($rows as $row) {

                    $user = $this->db
                        ->select('fullname')
                        ->where('user_id', $row->assigned_to)
                        ->get('tbl_account_details')
                        ->row();

                    // status badge
                    $status_badge = '';

                    if ($row->status == 'Open') {
                        $status_badge = '<span class="label label-warning">Open</span>';
                    } elseif ($row->status == 'Replied') {
                        $status_badge = '<span class="label label-info">Replied</span>';
                    } elseif ($row->status == 'Reopened') {
                        $status_badge = '<span class="label label-danger">Reopened</span>';
                    } elseif ($row->status == 'Closed') {
                        $status_badge = '<span class="label label-success">Closed</span>';
                    }

                    $html .= '<tr>';

                    $html .= '<td>'.$row->id.'</td>';

                    $html .= '<td>'
                            .(!empty($user) ? $user->fullname : '-')
                            .'</td>';

                    $html .= '<td>'.$row->remark.'</td>';

                    $html .= '<td>'.$status_badge.'</td>';

                    $html .= '<td>'
                            .date('d M Y h:i A', strtotime($row->created_at))
                            .'</td>';

                    $html .= '<td>';

                    /*
                    |--------------------------------------------------------------------------
                    | ASSIGNED USER CAN REPLY
                    |--------------------------------------------------------------------------
                    */

                    if (
                        $row->assigned_to == $current_user &&
                        ($row->status == 'Open' || $row->status == 'Reopened')
                    ) {

                        $html .= '
                        <button
                            type="button"
                            class="btn btn-xs btn-info reply_escalation_btn"
                            data-id="'.$row->id.'">

                            <i class="fa fa-reply"></i> Reply

                        </button> ';
                    }

                    /*
                    |--------------------------------------------------------------------------
                    | RAISED USER CAN APPROVE / REOPEN
                    |--------------------------------------------------------------------------
                    */

                   
                        $html .= '
                        <button
                            type="button"
                            class="btn btn-xs btn-warning approve_escalation_btn"
                            data-id="'.$row->id.'">

                            <i class="fa fa-check"></i>

                        </button>

                        <button
                            type="button"
                            class="btn btn-xs btn-danger reopen_escalation_btn"
                            data-id="'.$row->id.'">

                            <i class="fa fa-refresh"></i>

                        </button>';
                     



                    if(
            $row->raised_by == $this->session->userdata('user_id')
            && $row->status != 'Closed'
        ){
            $html .= '
            <button
                type="button"
                class="btn btn-success btn-xs close_escalation_btn"
                data-id="'.$row->id.'">

                <i class="fa fa-check"></i>   Close

            </button>';
        }

                    /*
                    |--------------------------------------------------------------------------
                    | VIEW COMMENTS
                    |--------------------------------------------------------------------------
                    */

                    $html .= '
                    <button
                        type="button"
                        class="btn btn-xs btn-primary view_escalation_btn"
                        data-id="'.$row->id.'">

                        <i class="fa fa-eye"></i>

                    </button>';

                    $html .= '</td>';

                    $html .= '</tr>';
                }

                $html .= '
                    </tbody>
                </table>';
            }

        
            echo json_encode([
            'html' => $html,
            'active_escalation_id' => !empty($active)
                ? $active->id
                : 0
        ]);
        }



public function close_escalation()
{
    $escalation_id = $this->input->post('escalation_id');

    $this->db
        ->where('id', $escalation_id)
        ->update(
            'tbl_client_escalation',
            [
                'status' => 'Closed',
                'updated_at' => date('Y-m-d H:i:s')
            ]
        );

    echo json_encode([
        'status' => true
    ]);
}


public function get_escalation_comments()
{
    $escalation_id = $this->input->post('escalation_id');

    $comments = $this->db
        ->where('escalation_id', $escalation_id)
        ->order_by('id', 'ASC')
        ->get('tbl_client_escalation_comments')
        ->result();

    $html = '';

    if(empty($comments)){

        $html .= '
        <div class="alert alert-info">
            No replies yet
        </div>';

    }else{

        foreach($comments as $comment){

            $user = $this->db
                ->select('fullname')
                ->where('user_id', $comment->user_id)
                ->get('tbl_account_details')
                ->row();

            $html .= '
            <div class="panel panel-default" style="margin-bottom:10px;">
                <div class="panel-body">

                    <strong>'
                        .($user->fullname ?? 'User').
                    '</strong>

                    <br>

                    '.$comment->comment.'

                    <hr style="margin:8px 0">

                    <small>'
                        .date(
                            'd M Y h:i A',
                            strtotime($comment->created_at)
                        ).
                    '</small>

                </div>
            </div>';
        }
    }

    echo $html;
}
 

public function hold_client()
{
    $client_id = $this->input->post('client_id');

    $this->db
        ->where('client_id',$client_id)
        ->update('tbl_client',[
            'client_hold' => 1
        ]);

    echo json_encode([
        'status' => 'success'
    ]);
}



public function esclation()
{
    $data['title'] = 'Escalation List';

    $user_id   = $this->session->userdata('user_id');
    $user_type = $this->session->userdata('user_type');

    $this->db
        ->select('
            e.*,
            c.name as client_name,
            c.mobile as client_phone,
            r.fullname as raised_by_name,
            a.fullname as assigned_to_name
        ')
        ->from('tbl_client_escalation e')
        ->join('tbl_client c', 'c.client_id = e.client_id', 'left')
        ->join('tbl_account_details r', 'r.user_id = e.raised_by', 'left')
        ->join('tbl_account_details a', 'a.user_id = e.assigned_to', 'left');

    // Admin ko sab dikhega
    if ($user_type != 1) {

        $this->db->group_start();

        $this->db->where('e.raised_by', $user_id);

        $this->db->or_where('e.assigned_to', $user_id);

        $this->db->group_end();
    }

    $data['escalations'] = $this->db
        ->order_by('e.id', 'DESC')
        ->get()
        ->result();

    $data['subview'] = $this->load->view(
        'admin/client/esclation',
        $data,
        TRUE
    );

    $this->load->view('admin/_layout_main', $data);
}

public function esclation_pending()
{
    $data['title'] = 'Escalation List';

    $user_id   = $this->session->userdata('user_id');
    $user_type = $this->session->userdata('user_type');

    $this->db
        ->select('
            e.*,
            c.name as client_name,
            c.mobile as client_phone,
            r.fullname as raised_by_name,
            a.fullname as assigned_to_name
        ')
        ->from('tbl_client_escalation e')
        ->join('tbl_client c', 'c.client_id = e.client_id', 'left')
        ->join('tbl_account_details r', 'r.user_id = e.raised_by', 'left')
        ->join('tbl_account_details a', 'a.user_id = e.assigned_to', 'left')
           ->where('e.status !=', 'Closed');

    // Admin ko sab dikhega
    if ($user_type != 1) {

        $this->db->group_start();

        $this->db->where('e.raised_by', $user_id);

        $this->db->or_where('e.assigned_to', $user_id);

        $this->db->group_end();
    }

    $data['escalations'] = $this->db
        ->order_by('e.id', 'DESC')
        ->get()
        ->result();

    $data['subview'] = $this->load->view(
        'admin/client/esclation_pending',
        $data,
        TRUE
    );

    $this->load->view('admin/_layout_main', $data);
}


      public function go_ahead()
{
    // Security check
    if (!$this->input->post('client_id')) {
        set_message('error', 'Invalid Client');
        redirect('admin/client/manage_client');
    }

    $client_id = $this->input->post('client_id', true);

    // Prepare update data
    $data = array(
        'go_ahead' => 'Done',
        'go_ahead_by' => $this->session->userdata('user_id'),
        'go_ahead_date' => date('Y-m-d H:i:s')
    );

    // Remove empty values
    foreach ($data as $key => $value) {
        if ($value === '' || $value === null) {
            unset($data[$key]);
        }
    }

    // Update query
    $this->db->where('client_id', $client_id);
    $update = $this->db->update('tbl_client', $data);

    if ($update) {

     // ========================================
// 🔥 ASSIGN TEAM BASED ON DESIGNATION
// ========================================
 

 

$designation_role_permission_map = [

    111 => [
        'role' => 'QC Factory',
        'permissions' => [
           'boq_without_price',
              'boq',
              'bom',
              'dispatch',
               'purchase_request',
              'on_site_purchase_request',
              'project_timeline',
              'timelines',
        ]
    ],

     112 => [
