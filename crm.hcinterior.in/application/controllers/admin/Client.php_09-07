    public function delete_notes($id, $client_id)
    {
        $notes_info = $this->db->where('notes_id', $id)->get('tbl_notes')->row();
        if (empty($notes_info)) {
            $type = "error";
            $message = "No Record Found";
            set_message($type, $message);
            redirect('admin/client/details/' . $client_id . '/notes');
        }
        $activities = array(
            'user' => $this->session->userdata('user_id'),
            'module' => 'client',
            'module_field_id' => $this->session->userdata('user_id'),
            'activity' => ('activity_deleted_notes'),
            'icon' => 'fa-user',
            'value1' => $notes_info->notes
        );
        $this->client_model->_table_name = 'tbl_activities';
        $this->client_model->_primary_key = "activities_id";
        $this->client_model->save($activities);
        
        $this->client_model->_table_name = 'tbl_notes';
        $this->client_model->_primary_key = 'notes_id';
        $this->client_model->delete($id);
        redirect('admin/client/details/' . $client_id . '/notes');
    }
    
    
    public function new_client()
    {
        $data['title'] = lang('new_client');
        $data['languages'] = $this->db->where('active', 1)->order_by('name', 'ASC')->get('tbl_languages')->result();
        // get all currencies
        $this->client_model->_table_name = 'tbl_currencies';
        $this->client_model->_order_by = 'name';
        $data['currencies'] = $this->client_model->get();
        $data['subview'] = $this->load->view('admin/client/new_client', $data, FALSE);
        $this->load->view('admin/_layout_modal', $data);
    }
    
    public function update_client()
    {
        $created = can_action('4', 'created');
        if (!empty($created)) {
            $data = $this->client_model->array_from_post(array(
                'name', 'email', 'short_note', 'website', 'phone', 'mobile', 'fax', 'address', 'city', 'zipcode', 'currency',
                'skype_id', 'linkedin', 'facebook', 'twitter', 'language', 'country', 'vat', 'hosting_company', 'hostname', 'port', 'username', 'latitude', 'longitude', 'customer_group_id'
            ));
            
            $password = $this->input->post('password', true);
            if (!empty($password)) {
                $data['password'] = encrypt($password);
            }
            
            if (!empty($_FILES['profile_photo']['name'])) {
                $val = $this->client_model->uploadImage('profile_photo');
                $val == TRUE || redirect('admin/client/manage_client');
                $data['profile_photo'] = $val['path'];
            }
            
            $this->client_model->_table_name = 'tbl_client';
            $this->client_model->_primary_key = "client_id";
            $id = $this->client_model->save($data);
            $action = ('activity_update_company');
            save_custom_field(12, $id);
            
            $activities = array(
                'user' => $this->session->userdata('user_id'),
                'module' => 'client',
                'module_field_id' => $id,
                'activity' => $action,
                'icon' => 'fa-user',
                'value1' => $data['name']
            );
            $this->client_model->_table_name = 'tbl_activities';
            $this->client_model->_primary_key = "activities_id";
            $this->client_model->save($activities);
            //            messages for user
            $type = "success";
            $message = lang('client_updated');
            set_message($type, $message);
        }
        if (!empty($id)) {
            $result = array(
                'id' => $id,
                'name' => $data['name'],
                'status' => $type,
                'message' => $message,
            );
        } else {
            $result = array(
                'status' => 'error',
                'message' => lang('there_in_no_value'),
            );
        }
        echo json_encode($result);
        exit();
    }




    public function sendMailCommon($data = [])
{
    $this->load->model('settings_model');
    $this->load->database();

    $emails = [];

    // 🔹 Case 1: Single User
    if (!empty($data['user_id'])) {
        $this->db->select('email');
        $this->db->from('tbl_users');
        $this->db->where('user_id', $data['user_id']);
        $user = $this->db->get()->row();

        if (!empty($user->email)) {
            $emails[] = $user->email;
        }
    }

    // 🔹 Case 2: Designation Users
    if (!empty($data['designation_id'])) {
        $this->db->select('u.email');
        $this->db->from('tbl_users u');
        $this->db->join('tbl_account_details ad', 'ad.user_id = u.user_id', 'left');
        $this->db->where('ad.designations_id', $data['designation_id']);
        $users = $this->db->get()->result();

        foreach ($users as $u) {
            if (!empty($u->email)) {
                $emails[] = $u->email;
            }
        }
    }

    // 🔹 Duplicate हटाओ
    $emails = array_unique($emails);

    // 🔹 Mail भेजो
    foreach ($emails as $email) {

        $params['subject'] = $data['subject'];
        $params['message'] = $data['message'];
        $params['resourceed_file'] = '';
        $params['recipient'] = $email;

        $this->settings_model->send_email($params, true);

        echo $email . "<br>";
    }

    echo "Mail Sent";
}


public function add_payment_record($id = null)
{
    $data = array(
        'client_id'          => $this->input->post('client_id'),
        'paid_amount'        => $this->input->post('paid_amount'),
        'payment_mode'       => $this->input->post('payment_mode'),
        'payment_date'       => $this->input->post('payment_date'),
        'transaction_detail' => $this->input->post('transaction_detail'),
        'status'             => $this->input->post('status'),
        'updated_date'       => date('Y-m-d H:i:s')
    );

    if (empty($id)) {

        $data['created_date'] = date('Y-m-d H:i:s');

        $this->db->insert(
            'tbl_client_payment_record',
            $data
        );

        set_message('success', 'Payment record added successfully');

    } else {

        $this->db
            ->where('id', $id)
            ->update(
                'tbl_client_payment_record',
                $data
            );

        set_message('success', 'Payment record updated successfully');
    }

    redirect($_SERVER['HTTP_REFERER']);
}

public function update_payment_plan()
{
    $client_id = $this->input->post('client_id');
    $payment_plan = $this->input->post('payment_plan');

    if (empty($client_id) || empty($payment_plan)) {
        echo json_encode([
            'status' => 'error',
            'message' => 'Invalid Request'
        ]);
        exit;
    }

    $this->db->where('client_id', $client_id);
    $update = $this->db->update('tbl_client', [
        'payment_plan' => $payment_plan
    ]);

    if ($update) {
        echo json_encode([
            'status' => 'success'
        ]);
    } else {
        echo json_encode([
            'status' => 'error'
        ]);
    }

    exit;
}

 
public function payment_schedule_pdf($client_id)
{
    $data['client_details'] = $this->db
        ->where('client_id', $client_id)
        ->get('tbl_client')
        ->row();

    $data['payments'] = get_result(
        'tbl_client_payment_record',
        [
            'client_id' => $client_id
        ]
    );

    $html = $this->load->view(
        'admin/client/details/payment_schedule_pdf',
        $data,
        true
    );

    // Dompdf
    $options = new \Dompdf\Options();
    $options->set('isHtml5ParserEnabled', true);
    $options->set('isRemoteEnabled', true);

    $dompdf = new \Dompdf\Dompdf($options);

    $dompdf->loadHtml($html);
    $dompdf->setPaper('A4', 'portrait');
    $dompdf->render();

    $dompdf->stream(
        'payment_schedule_' . $client_id . '.pdf',
        [
            'Attachment' => false
        ]
    );
}




