 public function update_timeline()
{
    $tasks = $this->input->post('tasks');
    $client_id = $this->input->post('client_id');

    if (!empty($tasks)) {

        foreach ($tasks as $task) {

            $start = !empty($task['start_date']) ? $task['start_date'] : NULL;
            $end   = !empty($task['end_date'])   ? $task['end_date']   : NULL;

            $duration = NULL;

            if (!empty($start) && !empty($end)) {
                $start_date = new DateTime($start);
                $end_date   = new DateTime($end);
                $diff       = $start_date->diff($end_date);
                $duration   = $diff->days;
            }

            $this->db->where('id', $task['id']);
            $this->db->update('tbl_client_timeline', [
                'start_date' => $start,
                'end_date'   => $end,
                'duration'   => $duration
            ]);


 }

 
$team_members = get_client_team_members($client_id);
$allowed_roles = ['Designer', 'Project Coordinator', 'SPM', 'Operation Manager'];

foreach ($team_members as $member) {

    $role = $member->member_profile;
    $user_id = $member->user_id;
    
 
     if (!in_array($role, $allowed_roles)) {
        continue;
    }


     if ($user_id == $this->session->userdata('user_id')) {
        continue;
    }


     $client = $this->db
        ->where('client_id', $client_id)
        ->get('tbl_client')
        ->row();
 
    $clientName = $client->name ?? 'N/A';
     $userName = $_SESSION['user_name'] ?? 'User';
    $subject = 'Execution timeline for ' .$clientName. 'is updated';

    $message =  'Execution timeline for ' .$clientName. 'is updated';

 

    add_notification([
        'to_user_id'   => $user_id,
        'from_user_id' => $this->session->userdata('user_id'),
        'description' =>  $message,
        'link' => 'admin/client/details/'.$client_id.'/project_timeline',
        'value' => $message,
    ]);

    show_notification([$user_id]);


}



       
    }


 
    set_message('success', 'Timeline Updated Successfully');
    redirect($_SERVER['HTTP_REFERER']);
}



public function assign_default_user_permissions($client_id, $user_id, $profile, $permissions = [])
{
    // 1️⃣ Check if already assigned in team
    $exists = $this->db->where([
        'client_id' => $client_id,
        'user_id'   => $user_id,
        'member_profile' => $profile
    ])->get('tbl_client_assign_team')->row();

    if(empty($exists)){

        $this->db->insert('tbl_client_assign_team', [
            'client_id'     => $client_id,
            'user_id'       => $user_id,
            'member_profile'=> $profile,
            'created_date'  => date('Y-m-d H:i:s'),
            'updated_date'  => date('Y-m-d H:i:s'),
            'added_by'      => $this->session->userdata('user_id')
        ]);
    }

    // 2️⃣ Delete old permissions (optional safe reset)
    $this->db->where([
        'client_id' => $client_id,
        'user_id'   => $user_id
    ])->delete('operation_permissions');

    // 3️⃣ Insert default permissions
    if(!empty($permissions)){
        foreach ($permissions as $perm){

            $this->db->insert('operation_permissions', [
                'client_id'     => $client_id,
                'user_id'       => $user_id,
                'profile'       => $profile,
                'permission_key'=> $perm,
                'created_at'    => date('Y-m-d H:i:s')
            ]);
        }
    }

    return true;
}



    public function change_client_status($id = null)
    {
        $edited = can_action('4', 'edited');
        if (empty($edited)) {
            $type = "error";
            $message = "No Record Found";
            echo json_encode(array("status" => $type, "message" => $message));
            exit();
        }
        $data['active'] = $this->input->post('active', true);
        $this->client_model->_table_name = 'tbl_client';
        $this->client_model->_primary_key = "client_id";
        $this->client_model->save($data, $id);
        // save into activities
        $activities = array(
            'user' => $this->session->userdata('user_id'),
            'module' => 'client',
            'module_field_id' => $id,
            'activity' => 'activity_change_status',
            'icon' => 'fa-ticket',
            'value1' => $data['active'],
        );
        // Update into tbl_project
        $this->client_model->_table_name = "tbl_activities"; //table name
        $this->client_model->_primary_key = "activities_id";
        $this->client_model->save($activities);
        $type = "success";
        $message = lang('update_client_status');
        echo json_encode(array("status" => $type, "message" => $message));
        exit();
    }
    
