    public function clientListFactory($type = null)
    {

    $kt_meeting_from = $this->input->get_post('kt_meeting_from');
    $kt_meeting_to   = $this->input->get_post('kt_meeting_to');


    $site_validation_from = $this->input->get_post('site_validation_from');
    $site_validation_to   = $this->input->get_post('site_validation_to');

    $dispatch_date_from = $this->input->get_post('dispatch_date_from');
    $dispatch_date_to   = $this->input->get_post('dispatch_date_to');

    $site_start_date_from = $this->input->get_post('site_start_date_from');
    $site_start_date_to   = $this->input->get_post('site_start_date_to');

    $hand_over_request_date_from = $this->input->get_post('hand_over_request_date_from');
    $hand_over_request_date_to   = $this->input->get_post('hand_over_request_date_to');

    $assign_user_id = $this->input->get_post('assign_user_id');
    $user_id            = $this->session->userdata('user_id');
	$user_type          = $this->session->userdata('user_type'); // admin = 1
	$designation_id     = $this->session->userdata('designations_id'); // project coordinator = 45

 

        $user_id = $this->session->userdata('user_id');

        // Get assigned clients for logged-in user
        $assign_team = $this->db
            ->select('client_id')
            ->where('user_id', $user_id)
            ->get('tbl_client_assign_team')
            ->result();

        // Extract client_ids into array
        $assigned_client_ids = [];
        if (!empty($assign_team)) {
            foreach ($assign_team as $row) {
                $assigned_client_ids[] = $row->client_id;
            }
        }
 
        if ($this->input->is_ajax_request()) {
            $this->load->model('datatables');
            $this->datatables->table = 'tbl_client';
            $this->datatables->join_table = array('tbl_customer_group', 'tbl_account_details');
            $this->datatables->join_where = array('tbl_customer_group.customer_group_id=tbl_client.customer_group_id', 'tbl_account_details.user_id=tbl_client.primary_contact');
            $custom_field = custom_form_table_search(12);
            $main_column = array('tbl_client.name', 'tbl_client.email', 'tbl_client.client_sr_id', 'tbl_account_details.fullname', 'short_note', 'website', 'tbl_customer_group.customer_group');
            $action_array = array('tbl_client.client_id');
            $result = array_merge($main_column, $custom_field, $action_array);
            $this->datatables->column_order = $result;
            $this->datatables->column_search = $result;
            
            $this->datatables->order = array('client_id' => 'desc');
           

          $user_id = $this->session->userdata('user_id');

                $permission_lead_ids = [];

        $leads = $this->db->select('leads_id, permission')->get('tbl_leads')->result();

        foreach ($leads as $lead) {
            if (!empty($lead->permission)) {
                $perm = json_decode($lead->permission, true);

                if (!empty($perm) && array_key_exists($user_id, $perm)) {
                    $permission_lead_ids[] = $lead->leads_id;
                }
            }
        }

        $assign_team = $this->db
            ->select('client_id')
            ->where('user_id', $user_id)
            ->get('tbl_client_assign_team')
            ->result();

        $assigned_client_ids = [];
        foreach ($assign_team as $row) {
            $assigned_client_ids[] = $row->client_id;
        }
        
