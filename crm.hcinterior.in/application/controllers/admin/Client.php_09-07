foreach ($team_members as $member) {

    $role = $member->member_profile;
    $user_id = $member->user_id;

 
 
    if (isset($role_permission_map[$role])) {

        $permissions = $role_permission_map[$role];

        foreach ($permissions as $perm) {

            $perm_exists = $this->db
                ->where('client_id', $client_id)
                ->where('user_id', $user_id)
                ->where('permission_key', $perm)
                ->get('operation_permissions')
                ->row();

            if (!$perm_exists) {

                $this->db->insert('operation_permissions', [
                    'client_id'     => $client_id,
                    'user_id'       => $user_id,
                    'permission_key'=> $perm,
                    'created_at'    => date('Y-m-d H:i:s')
                ]);

            }

        }

    }

}

}




    }



    set_message('success', 'Client KT Request successfully');
  
   // redirect('admin/client/details/' . $client_id . '/kt');
 redirect($_SERVER['HTTP_REFERER']);

}



 public function add_dispatch_query()
{
    $dispatch_id = $this->input->post('dispatch_id', true);
    $client_id   = $this->input->post('client_id', true);
    $remarks     = $this->input->post('remarks', true);

    $file_name = null;

    // ✅ ensure folder exists
    $upload_path = FCPATH . 'uploads/';
    if (!is_dir($upload_path)) {
        mkdir($upload_path, 0777, true);
    }

    if (!empty($_FILES['file']['name'])) {

        $config['upload_path']   = $upload_path;
        $config['allowed_types'] = '*';
        $config['encrypt_name']  = true;

        $this->load->library('upload', $config);

        if ($this->upload->do_upload('file')) {

            $upload_data = $this->upload->data();
            $file_name = $upload_data['file_name'];

        } else {

            // ❌ debug error
            set_message('error', $this->upload->display_errors());
            redirect($_SERVER['HTTP_REFERER']);
        }
    }

    $data = [
        'client_id'   => $client_id,
        'dispatch_id' => $dispatch_id,
        'remarks'     => $remarks,
        'file_name'   => $file_name,
        'uploaded_by' => $this->session->userdata('user_id'),
        'created_date'=> date('Y-m-d H:i:s'),
        'updated_date'=> date('Y-m-d H:i:s')
    ];

    $save = $this->db->insert('tbl_client_dispatch_item_query', $data);


    if($save){
        
 $team_members = get_client_team_members($client_id);
$allowed_roles = ['Designer', 'Project Coordinator', 'Factory Production Team'];

foreach ($team_members as $member) {
    $role = $member->member_profile;
    $user_id = $member->user_id;
     if (!in_array($role, $allowed_roles)) {
        continue;
    }
     if ($user_id == $this->session->userdata('user_id')) {
        continue;
    }
     $client = $this->db
        ->where('client_id', $client_id)
        ->get('tbl_client')
        ->row();
 
     $dispatch = $this->db
        ->where('id', $dispatch_id)
        ->get('tbl_client_dispatch')
        ->row();
 
 
        $clientName = $client->name ?? 'N/A';
        $userName = $_SESSION['user_name'] ?? 'User';
          $subject =  ' Purchase request for '.$clientName. 'BOM' ;
         $message = 'Query for   '.$clientName. ' s ('. $dispatch->file_name.') has been raised' ;

         
       
    add_notification([
        'to_user_id'   => $user_id,
        'from_user_id' => $this->session->userdata('user_id'),
        'description' =>  $message,
        'link' => 'admin/client/details/'.$client_id.'/purchase_request',
        'value' => $message,
    ]);
    show_notification([$user_id]);
}

}

    set_message('success', 'Query added successfully');
    redirect($_SERVER['HTTP_REFERER']);
}


    public function client_request_status()
{

// print_r($_POST);
// exit();
    // Security check
    if (!$this->input->post('design_id')) {
        set_message('error', 'Invalid Client');
        redirect('admin/client/manage_client');
    }

    $design_id = $this->input->post('design_id', true);
    $client_id = $this->input->post('client_id', true);
    $status    = $this->input->post('status');
    $remarks   = $this->input->post('remark');
    $request_done   = $this->input->post('request_done');
    $request_type   = $this->input->post('request_type');

  if($request_done == 'Done' && $request_type == 'KT1') {

    $data = array(
        'status' => 'Approved',
        'request_done' => $request_done,
        'status_approve_by' => $this->session->userdata('user_id'),
        'status_approve_date' => date('Y-m-d H:i:s'),
    );

} else if ($request_done == 'Reject' && $request_type == 'KT1') {

    $data = array(
        'status' => 'Approved',
        'request_done' => $request_done,
        'status_approve_by' => $this->session->userdata('user_id'),
        'status_approve_date' => date('Y-m-d H:i:s'),
    );

} else if ($request_done == 'Reject') {

    $data = array(
        'status' => 'Pending',
        'status_approve_by' => $this->session->userdata('user_id'),
        'status_approve_date' => date('Y-m-d H:i:s'),
    );

} else {

    $data = array(
        'status' => $this->input->post('status', true),
        'loose_furniture_dispatch_date' => $this->input->post('loose_furniture_dispatch_date', true),
        'status_approve_by' => $this->session->userdata('user_id'),
        'status_approve_date' => date('Y-m-d H:i:s'),
    );

}
      if ($status == 'Reject' || $request_done == 'Reject') {
        $data['remark'] = $remarks;
    } else {
        $data['remark'] = null;
    }


    // Remove empty values
    foreach ($data as $key => $value) {
        if ($value === '' || $value === null) {
            unset($data[$key]);
        }
    }

    // Update query
    $this->db->where('id', $design_id);
    $update = $this->db->update('tbl_client_service_request', $data);

    
    
