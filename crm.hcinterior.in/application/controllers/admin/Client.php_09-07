        $site_validation_from,
        $site_validation_to,
        $this->db
    );

    if (!empty($client_ids)) {

        $custom_where[] = [
            'type'  => 'where_in',
            'field' => 'client_id',
            'value' => $client_ids
        ];

    } else {

