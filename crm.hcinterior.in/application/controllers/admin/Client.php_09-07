   Go Ahead
</button>';

}  

}
    
    
    else {
       $action .= '<i class="fa fa-handshake-o" style="color: green; font-size:20px"></i>';  
    }
    }


    

    // ===== TRACKER =====

$design_finalization  = $this->getTaskStatus_list($client_details->client_id, 'design_finalization', $this);
$material_selection   = $this->getTaskStatus_list($client_details->client_id, 'material_selection', $this);
$wall_electrical      = $this->getTaskStatus_list($client_details->client_id, 'wall_electrical_drawing', $this);
$site_start           = $this->getTaskStatus_list($client_details->client_id, 'site_start_date', $this);
$dispatch             = $this->getTaskStatus_list($client_details->client_id, 'dispatch_date', $this);

$modularDrawing = $this->db
    ->where('client_id', $client_details->client_id)
    ->where('design_type', 'Modular Design')
    ->where('is_final', 1)
    ->where('status', 'Approved')
    ->get('tbl_client_two_d_design')
    ->row();

$validation = $this->db
    ->where('client_id', $client_details->client_id)
    ->order_by('id','DESC')
    ->limit(1)
    ->get('tbl_client_validation_files')
    ->row();

$validation_status = (
    !empty($validation) &&
    !empty($validation->validation_checklist) &&
    !empty($validation->manual_correction_file)
) ? 1 : 0;

$handover_status = $this->db
    ->where('client_id',$client_details->client_id)
    ->where('go_ahead','Done')
    ->count_all_results('tbl_client') > 0 ? 1 : 0;

$tracker = [
    'Civil Drawing'       => $this->db->where('client_id',$client_details->client_id)->count_all_results('tbl_client_two_d_design') > 0 ? 1 : 0,
    'Design Finalization' => $design_finalization,
    'Material Selection'  => $material_selection,
    '3D'                  => $this->db->where('client_id',$client_details->client_id)->where('request_type','3d Design')->count_all_results('tbl_client_service_request') > 0 ? 1 : 0,
    'Validation'          => $validation_status,
    'Wall Electrical'     => $wall_electrical,
    'Production File'     => !empty($modularDrawing) ? 1 : 0,
    'Site Start'          => $site_start,
    'BOM'                 => $this->db->where('client_id',$client_details->client_id)->where('request_type','bom')->count_all_results('tbl_client_service_request') > 0 ? 1 : 0,
    'Dispatch'            => $dispatch,
    'Handover'            => $handover_status,
];

$phases = [
    1 => ['Civil Drawing','Design Finalization','Material Selection','3D','Validation','Wall Electrical','Production File'],
    2 => ['Site Start'],
    3 => ['BOM','Dispatch'],
    4 => ['Handover']
];

$currentPhase = 1;

foreach($phases as $phaseNo => $items){

    $complete = true;

    foreach($items as $item){

        if(empty($tracker[$item])){
            $complete = false;
            $currentPhase = $phaseNo;
            break;
        }
    }

    if(!$complete){
        break;
    }

    $currentPhase = 4;
}

//$sub_array[] = '<span class="label label-info">Phase '.$currentPhase.'</span>';
   

   
              //  $sub_array[] = $action;
                $data[] = $sub_array;
            }
            
           $output = array(
                "draw" => intval($_POST["draw"]),
                "recordsTotal" => $this->datatables->get_all_data($where),
                "recordsFiltered" => $this->datatables
                    ->count_filtered_custom($where, null, $custom_where),
                "data" => $data
            );

        echo json_encode($output);
        exit;
        } else {
            redirect('admin/dashboard');
        }
    }


}