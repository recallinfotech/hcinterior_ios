    public function get_role_users()
    {
        $role_name = $this->input->post('role_name');

        $users = $this->db
            ->select('tbl_account_details.user_id, tbl_account_details.fullname')
            ->from('tbl_client_assign_team')
            ->join(
                'tbl_account_details',
                'tbl_account_details.user_id = tbl_client_assign_team.user_id',
                'left'
            )
            ->where('tbl_client_assign_team.member_profile', $role_name)
            ->group_by('tbl_client_assign_team.user_id')
            ->order_by('tbl_account_details.fullname', 'ASC')
            ->get()
            ->result();

        echo '<option value="">Select User</option>';

        foreach ($users as $user) {

            echo '<option value="' . $user->user_id . '">'
                . $user->fullname .
                '</option>';
        }
    }

    public function create_client($id = NULL)
    {
        if (!empty($id)) {
            if (is_numeric($id)) {
                $data['active'] = 2;
                // get all Client info by client id
                $this->client_model->_table_name = "tbl_client"; //table name
                $this->client_model->_order_by = "client_id";
                $data['client_info'] = $this->client_model->get_by(array('client_id' => $id), TRUE);
                $edited = can_action('4', 'edited');
                if (empty($data['client_info']) || empty($edited)) {
                    $type = "error";
                    $message = "No Record Found";
                    set_message($type, $message);
                    redirect('admin/client/manage_client');
                }
            } else if ($id == 'new') {
                $data['active'] = 2;
            }
        } else {
            $data['active'] = 2;
        }
        $data['title'] = lang('manage_client'); //Page title
        $data['page'] = lang('client');

        // get all country
        $this->client_model->_table_name = "tbl_countries"; //table name
        $this->client_model->_order_by = "id";
        $data['countries'] = $this->client_model->get();

        // get all currencies
        $this->client_model->_table_name = 'tbl_currencies';
        $this->client_model->_order_by = 'name';
        $data['currencies'] = $this->client_model->get();

        $data['assign_user'] = $this->client_model->allowed_user('4');
        if (!empty(staff())) {
            $data['showing_created'] = true;
        }
        // get all language
        $data['languages'] = $this->db->where('active', 1)->order_by('name', 'ASC')->get('tbl_languages')->result();

        $data['subview'] = $this->load->view('admin/client/create_client', $data, TRUE);
        $this->load->view('admin/_layout_main', $data); //page load
    }

