    public function upload_on_site_purchase_photos_ajax()
    {
        $purchase_id = $this->input->post('purchase_id', true);

        if (empty($purchase_id)) {
            echo json_encode(['success' => false, 'message' => 'Invalid Purchase ID']);
            return;
        }

        $purchase = $this->db->where('id', $purchase_id)->get('tbl_client_on_site_purchase')->row();
        if (!$purchase) {
            echo json_encode(['success' => false, 'message' => 'Purchase Request not found']);
            return;
        }

        $existing_files = [];
        if (!empty($purchase->upload_file)) {
            $decoded = json_decode($purchase->upload_file, true);
            if (is_array($decoded)) {
                $existing_files = $decoded;
            }
        }

        $uploaded_count = 0;
        $target_dir = getcwd() . "/uploads/";
        if (!file_exists($target_dir)) {
            mkdir($target_dir, 0777, true);
        }

        if (!empty($_FILES['photos']['name'])) {
            $files_count = is_array($_FILES['photos']['name']) ? count($_FILES['photos']['name']) : 1;

            if (is_array($_FILES['photos']['name'])) {
                for ($i = 0; $i < $files_count; $i++) {
                    if ($_FILES['photos']['error'][$i] == 0) {
                        $tmp_name = $_FILES['photos']['tmp_name'][$i];
                        $orig_name = $_FILES['photos']['name'][$i];
                        $file_ext = strtolower(pathinfo($orig_name, PATHINFO_EXTENSION));

                        $allowed_exts = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'pdf'];
                        if (!in_array($file_ext, $allowed_exts)) {
                            continue;
                        }

                        $new_filename = 'ospr_' . $purchase_id . '_' . time() . '_' . rand(100, 999) . '.' . $file_ext;
                        $dest_path = $target_dir . $new_filename;

                        if (move_uploaded_file($tmp_name, $dest_path)) {
                            $is_image = in_array($file_ext, ['jpg', 'jpeg', 'png', 'gif', 'webp']);
                            $existing_files[] = [
                                'fileName' => $new_filename,
                                'path'     => 'uploads/' . $new_filename,
                                'fullPath' => $dest_path,
                                'ext'      => '.' . $file_ext,
                                'is_image' => $is_image,
                                'date'     => date('d M Y, h:i A')
                            ];
                            $uploaded_count++;
                        }
                    }
                }
            } else {
                if ($_FILES['photos']['error'] == 0) {
                    $tmp_name = $_FILES['photos']['tmp_name'];
                    $orig_name = $_FILES['photos']['name'];
                    $file_ext = strtolower(pathinfo($orig_name, PATHINFO_EXTENSION));

                    $allowed_exts = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'pdf'];
                    if (in_array($file_ext, $allowed_exts)) {
                        $new_filename = 'ospr_' . $purchase_id . '_' . time() . '_' . rand(100, 999) . '.' . $file_ext;
                        $dest_path = $target_dir . $new_filename;

                        if (move_uploaded_file($tmp_name, $dest_path)) {
                            $is_image = in_array($file_ext, ['jpg', 'jpeg', 'png', 'gif', 'webp']);
                            $existing_files[] = [
                                'fileName' => $new_filename,
                                'path'     => 'uploads/' . $new_filename,
                                'fullPath' => $dest_path,
                                'ext'      => '.' . $file_ext,
                                'is_image' => $is_image,
                                'date'     => date('d M Y, h:i A')
                            ];
                            $uploaded_count++;
                        }
                    }
                }
            }
        }

        if ($uploaded_count > 0) {
            $this->db->where('id', $purchase_id)->update('tbl_client_on_site_purchase', [
                'upload_file'  => json_encode($existing_files),
                'updated_date' => date('Y-m-d H:i:s')
            ]);
        }

        echo json_encode([
            'success'        => true,
            'uploaded_count' => $uploaded_count,
            'photos'         => $existing_files,
            'purchase_id'    => $purchase_id
        ]);
    }

    public function delete_on_site_purchase_photo_ajax()
    {
        $purchase_id = $this->input->post('purchase_id', true);
        $file_name   = $this->input->post('file_name', true);

        if (empty($purchase_id) || empty($file_name)) {
            echo json_encode(['success' => false, 'message' => 'Invalid Parameters']);
            return;
        }

        $purchase = $this->db->where('id', $purchase_id)->get('tbl_client_on_site_purchase')->row();
        if (!$purchase || empty($purchase->upload_file)) {
            echo json_encode(['success' => false, 'message' => 'Purchase Request or files not found']);
            return;
        }

        $files = json_decode($purchase->upload_file, true);
        $updated_files = [];

        if (is_array($files)) {
            foreach ($files as $f) {
                if ($f['fileName'] === $file_name) {
                    if (!empty($f['fullPath']) && file_exists($f['fullPath'])) {
                        @unlink($f['fullPath']);
                    }
                } else {
                    $updated_files[] = $f;
                }
            }
        }

        $this->db->where('id', $purchase_id)->update('tbl_client_on_site_purchase', [
            'upload_file' => !empty($updated_files) ? json_encode($updated_files) : NULL
        ]);

        echo json_encode([
            'success'     => true,
            'photos'      => $updated_files,
            'purchase_id' => $purchase_id
        ]);
    }

