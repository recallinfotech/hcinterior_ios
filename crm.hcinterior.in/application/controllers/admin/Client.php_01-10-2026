    public function new_two_d_design($id = NULL)
    {
        $url          = $this->input->post('url', true);
        $client_id    = $this->input->post('client_id', true);
        $design_type  = $this->input->post('design_type', true);

        if (empty($client_id)) {
            set_message('error', 'Invalid Client.');
            redirect($_SERVER['HTTP_REFERER']);
        }

        $n_data = [];
        $n_data['client_id']    = $client_id;
        $n_data['file_name']    = $this->input->post('file_name', true);
        $n_data['status']       = ($design_type == 'Civil Design')
            ? 'Approved'
            : 'Pending';

        $n_data['uploaded_by']  = $this->session->userdata('user_id');
        $n_data['design_type']  = $design_type;
        $n_data['design_style'] = $this->input->post('design_style', true);
        $n_data['upload_url']   = $this->input->post('upload_url', true);

        if (empty($id)) {
            $n_data['created_date'] = date('Y-m-d H:i:s');
        }

        $n_data['updated_date'] = date('Y-m-d H:i:s');

        $upload_file = [];

        /*
    ------------------------------------
    UPLOAD DIRECTORY CHECK
    ------------------------------------
    */

        $target_path = FCPATH . 'uploads/';

        if (!is_dir($target_path)) {
            mkdir($target_path, 0777, true);
        }

        if (!is_writable($target_path)) {

            set_message(
                'error',
                'Upload folder is not writable.'
            );

            redirect($_SERVER['HTTP_REFERER']);
        }

        /*
    ------------------------------------
    NEW FILES
    ------------------------------------
    */

        $max_size = 40 * 1024 * 1024; //20 MB

        if (!empty($_FILES['design_files']['name'][0])) {

            $files = $_FILES['design_files'];

            for ($i = 0; $i < count($files['name']); $i++) {

                if ($files['error'][$i] != 0) {

                    set_message(
                        'error',
                        'Error uploading file : '
                            . $files['name'][$i]
                    );

                    redirect($_SERVER['HTTP_REFERER']);
                }

                // Size Validation
                if ($files['size'][$i] > $max_size) {

                    set_message(
                        'error',
                        $files['name'][$i] .
                            ' exceeds 40 MB size limit.'
                    );

                    redirect($_SERVER['HTTP_REFERER']);
                }

                $original_name = $files['name'][$i];

                $ext = strtolower(
                    pathinfo(
                        $original_name,
                        PATHINFO_EXTENSION
                    )
                );

                $allowed_ext = [
                    'jpg',
                    'jpeg',
                    'png',
                    'pdf',
                    'dwg',
                    'ppt',
                    'pptx'
                ];

                if (!in_array($ext, $allowed_ext)) {

                    set_message(
                        'error',
                        $original_name .
                            ' is not a valid file type.'
                    );

                    redirect($_SERVER['HTTP_REFERER']);
                }

                $new_name = time()
                    . '_'
                    . uniqid()
                    . '.'
                    . $ext;

                $uploaded = move_uploaded_file(
                    $files['tmp_name'][$i],
                    $target_path . $new_name
                );

                if (!$uploaded) {

                    set_message(
                        'error',
                        'Unable to upload : '
                            . $original_name
                    );

                    redirect($_SERVER['HTTP_REFERER']);
                }

                $upload_file[] = [
                    'fileName' => $new_name,
                    'path'     => 'uploads/' . $new_name,
                    'fullPath' => $target_path . $new_name,
                    'size'     => round(
                        $files['size'][$i] / 1024,
                        2
                    ),
                    'is_image' => in_array(
                        $ext,
                        ['jpg', 'jpeg', 'png']
                    ) ? 1 : 0
                ];
            }
        }

        /*
    ------------------------------------
    EXISTING FILES (EDIT MODE)
    ------------------------------------
    */

        $fileName = $this->input->post('fileName');
        $path     = $this->input->post('path');
        $fullPath = $this->input->post('fullPath');
        $size     = $this->input->post('size');
        $is_image = $this->input->post('is_image');

        if (!empty($fileName)) {

            foreach ($fileName as $key => $name) {

                $upload_file[] = [
                    'fileName' => $name,
                    'path'     => $path[$key],
                    'fullPath' => $fullPath[$key],
                    'size'     => $size[$key],
                    'is_image' => $is_image[$key]
                ];
            }
        }

        /*
    ------------------------------------
    FILE REQUIRED CHECK
    ------------------------------------
    */

        if (empty($upload_file)) {

            set_message(
                'error',
                'Please upload at least one file.'
            );

            redirect($_SERVER['HTTP_REFERER']);
        }

        $n_data['upload_file'] = json_encode($upload_file);

        /*
    ------------------------------------
    SAVE DATA
    ------------------------------------
    */

        $this->client_model->_table_name =
            'tbl_client_two_d_design';

        $this->client_model->_primary_key =
            'id';

        $result = $this->client_model->save(
            $n_data,
            $id
        );

        if (!$result) {

            set_message(
                'error',
                'Unable to save data.'
            );

            redirect($_SERVER['HTTP_REFERER']);
        }

        /*
    ------------------------------------
    SUCCESS
    ------------------------------------
    */

        set_message(
            'success',
            'Design uploaded successfully.'
        );

        if ($url == 'validation') {

            redirect(
                'admin/client/details/'
                    . $client_id .
                    '/validation'
            );
        } else {

            redirect(
                'admin/client/details/'
                    . $client_id .
                    '/2ddesign'
            );
        }
    }



