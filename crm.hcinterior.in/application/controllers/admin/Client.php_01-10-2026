    public function on_site_purchase_request_status_ajax()
    {
        $request_id = $this->input->post('request_id', true);
        $status     = $this->input->post('status', true);
        $remarks    = $this->input->post('approval_remarks', true);

        if (empty($request_id) || empty($status)) {
            echo json_encode(['success' => false, 'message' => 'Invalid Parameters']);
            return;
        }

        $user_id = $this->session->userdata('user_id');
        $approver_name = get_any_field('tbl_account_details', array('user_id' => $user_id), 'fullname');
        $approve_date_fmt = date('d M Y, h:i A');

        $data = array(
            'status'              => $status,
            'status_approve_by'   => $user_id,
            'status_approve_date' => date('Y-m-d H:i:s'),
            'approval_remarks'    => $remarks
        );

        $this->db->where('id', $request_id);
        $update = $this->db->update('tbl_client_on_site_purchase_request', $data);

        if ($update) {
            $parent_status = 'Pending';
            $item_info = $this->db->where('id', $request_id)->get('tbl_client_on_site_purchase_request')->row();
            
            if (!empty($item_info->purchase_id)) {
                $all_items = $this->db->where('purchase_id', $item_info->purchase_id)->get('tbl_client_on_site_purchase_request')->result();
                $received_count = 0;
                $reject_count = 0;
                $total_items = count($all_items);

                foreach ($all_items as $ai) {
                    if ($ai->status == 'Recieved' || $ai->status == 'Received') {
                        $received_count++;
                    } else if ($ai->status == 'Reject' || $ai->status == 'Rejected') {
                        $reject_count++;
                    }
                }

                if ($received_count == $total_items) {
                    $parent_status = 'Recieved';
                } else if ($reject_count == $total_items) {
                    $parent_status = 'Reject';
                } else if ($received_count > 0) {
                    $parent_status = 'Partially Received';
                }

                $this->db->where('id', $item_info->purchase_id)->update('tbl_client_on_site_purchase', array(
                    'status'              => $parent_status,
                    'status_approve_by'   => $user_id,
                    'status_approve_date' => date('Y-m-d H:i:s')
                ));
            }

            echo json_encode([
                'success'        => true,
                'status'         => $status,
                'approver_name'  => $approver_name ?: 'User',
                'approve_date'   => $approve_date_fmt,
                'remarks'        => $remarks,
                'purchase_id'    => $item_info->purchase_id ?? 0,
                'parent_status'  => $parent_status
            ]);
        } else {
            echo json_encode(['success' => false, 'message' => 'Database update failed']);
        }
    }

