    public function update_operation_status()
    {
        $client_id = $this->input->post('client_id');
        $operation_status = $this->input->post('operation_status');

        $allowed_status = ['Hold', 'Unhold', 'Cancelled', 'Completed'];

        if (empty($client_id) || !in_array($operation_status, $allowed_status)) {
            echo json_encode([
                'status' => 'error',
                'message' => 'Invalid status'
            ]);
            return;
        }

        $client_info = $this->db->where('client_id', $client_id)->get('tbl_client')->row();

        $updated = $this->db
            ->where('client_id', $client_id)
            ->update('tbl_client', [
                'operation_status' => $operation_status
            ]);

        if ($updated) {
            // Get all assigned team members for this client from tbl_client_assign_team
            $assigned_team = $this->db
                ->where('client_id', $client_id)
                ->get('tbl_client_assign_team')
                ->result();

            if (!empty($assigned_team)) {
                $client_name = !empty($client_info->name) ? $client_info->name : 'Client';
                $client_sr_id = !empty($client_info->client_sr_id) ? $client_info->client_sr_id : '';

                $subject = "Operation Status Updated to " . $operation_status . " for Client: " . $client_sr_id . " (" . $client_name . ")";
                $message = "Client " . $client_sr_id . " (" . $client_name . ") operation status has been updated to: " . $operation_status . ".";

                $notified_users = [];

                foreach ($assigned_team as $member) {
                    if (!empty($member->user_id) && !in_array($member->user_id, $notified_users)) {
                        $notified_users[] = $member->user_id;

                        // System Notification
                        add_notification([
                            'to_user_id'   => $member->user_id,
                            'from_user_id' => $this->session->userdata('user_id'),
                            'description'  => $message,
                            'link'         => 'admin/client/details/' . $client_id,
                            'value'        => $message,
                        ]);

                        // Email
                        $this->sendMailCommon([
                            'user_id' => $member->user_id,
                            'subject' => $subject,
                            'message' => $message
                        ]);
                    }
                }
            }

            echo json_encode([
                'status' => 'success',
                'message' => 'Operation status updated successfully'
            ]);
        } else {
            echo json_encode([
                'status' => 'error',
                'message' => 'Status update failed'
            ]);
        }
    }


