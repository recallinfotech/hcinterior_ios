    public function new_completion_file($id = NULL)
    {
        $client_id = $this->input->post('client_id', true);

        if (empty($client_id)) {
            redirect($_SERVER['HTTP_REFERER']);
        }

        $n_data['client_id']    = $client_id;
        $n_data['file_name']    = $this->input->post('file_name', true);
        $n_data['status']       = $this->input->post('status', true) ? $this->input->post('status', true) : 'Approved';
        $n_data['uploaded_by']  = $this->session->userdata('user_id');
        $n_data['updated_date'] = date('Y-m-d H:i:s');

        if (empty($id)) {
            $n_data['created_date'] = date('Y-m-d H:i:s');
        }

        $upload_file = array();
        $target_path = getcwd() . "/uploads/";
        if (!is_dir($target_path)) {
            @mkdir($target_path, 0777, true);
        }

        $allowed_images = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'bmp'];
        $allowed_all    = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'bmp', 'pdf'];

        /* ===============================
        1. DIRECT FILE UPLOAD ($_FILES)
        =============================== */
        if (!empty($_FILES['completion_files']['name'][0])) {
            $count = count($_FILES['completion_files']['name']);
            for ($i = 0; $i < $count; $i++) {
                if ($_FILES['completion_files']['error'][$i] === 0 && !empty($_FILES['completion_files']['tmp_name'][$i])) {
                    $orig_name = $_FILES['completion_files']['name'][$i];
                    $ext = strtolower(pathinfo($orig_name, PATHINFO_EXTENSION));

                    if (in_array($ext, $allowed_all)) {
                        $clean_name = time() . '_' . uniqid() . '.' . $ext;
                        if (move_uploaded_file($_FILES['completion_files']['tmp_name'][$i], $target_path . $clean_name)) {
                            $is_img = in_array($ext, $allowed_images) ? 1 : 0;
                            $upload_file[] = array(
                                "fileName"  => $clean_name,
                                "path"      => "uploads/" . $clean_name,
                                "fullPath"  => $target_path . $clean_name,
                                "ext"       => '.' . $ext,
                                "size"      => round($_FILES['completion_files']['size'][$i] / 1024, 2),
                                "is_image"  => $is_img,
                            );
                        }
                    }
                }
            }
        }

        if (!empty($_FILES['manualFiles']['name'][0])) {
            $count = count($_FILES['manualFiles']['name']);
            for ($i = 0; $i < $count; $i++) {
                if ($_FILES['manualFiles']['error'][$i] === 0 && !empty($_FILES['manualFiles']['tmp_name'][$i])) {
                    $orig_name = $_FILES['manualFiles']['name'][$i];
                    $ext = strtolower(pathinfo($orig_name, PATHINFO_EXTENSION));

                    if (in_array($ext, $allowed_all)) {
                        $clean_name = time() . '_' . uniqid() . '.' . $ext;
                        if (move_uploaded_file($_FILES['manualFiles']['tmp_name'][$i], $target_path . $clean_name)) {
                            $is_img = in_array($ext, $allowed_images) ? 1 : 0;
                            $upload_file[] = array(
                                "fileName"  => $clean_name,
                                "path"      => "uploads/" . $clean_name,
                                "fullPath"  => $target_path . $clean_name,
                                "ext"       => '.' . $ext,
                                "size"      => round($_FILES['manualFiles']['size'][$i] / 1024, 2),
                                "is_image"  => $is_img,
                            );
                        }
                    }
                }
            }
        }

        /* ===============================
        2. DROPZONE UPLOADED FILES
        =============================== */
        $files = $this->input->post("files", true);
        if (!empty($files) && is_array($files)) {
            foreach ($files as $key => $file) {
                if (!empty($file)) {
                    $file_name = $this->input->post('file_name_' . $file, true);
                    if (!empty($file_name)) {
                        $new_file_name = move_temp_file($file_name, $target_path);

                        // Robust fallback if file_exists check in move_temp_file failed
                        if (!$new_file_name) {
                            $temp_dir = getcwd() . "/uploads/temp/";
                            $possible_paths = [
                                $temp_dir . $file_name,
                                $temp_dir . urldecode($file_name),
                                $temp_dir . rawurldecode($file_name),
                                $temp_dir . sanitize_file_name($file_name),
                            ];
                            foreach ($possible_paths as $p_path) {
                                if (file_exists($p_path)) {
                                    $new_file_name = unique_filename($target_path, $file_name);
                                    if (copy($p_path, $target_path . $new_file_name)) {
                                        @unlink($p_path);
                                        break;
                                    }
                                }
                            }
                        }

                        if ($new_file_name) {
                            $ext = strtolower(pathinfo($new_file_name, PATHINFO_EXTENSION));
                            $is_img = in_array($ext, $allowed_images) ? 1 : 0;
                            $size_val = $this->input->post('file_size_' . $file, true);
                            $size_kb = !empty($size_val) ? round($size_val / 1000, 2) : 0;

                            $upload_file[] = array(
                                "fileName"  => $new_file_name,
                                "path"      => "uploads/" . $new_file_name,
                                "fullPath"  => $target_path . $new_file_name,
                                "ext"       => '.' . $ext,
                                "size"      => $size_kb,
                                "is_image"  => $is_img,
                            );
                        }
                    }
                }
            }
        }

        /* ===============================
        3. EXISTING FILES (Edit mode)
        =============================== */
        $fileName  = $this->input->post('fileName', true);
        $path      = $this->input->post('path', true);
        $fullPath  = $this->input->post('fullPath', true);
        $size      = $this->input->post('size', true);
        $is_image  = $this->input->post('is_image', true);

        if (!empty($fileName)) {
            foreach ($fileName as $key => $name) {
                $ext = strtolower(pathinfo($name, PATHINFO_EXTENSION));
                $is_img = in_array($ext, $allowed_images) ? 1 : 0;
                $upload_file[] = array(
                    'fileName' => $name,
                    'path'     => $path[$key],
                    'fullPath' => $fullPath[$key],
                    'size'     => $size[$key],
                    'is_image' => isset($is_image[$key]) ? $is_image[$key] : $is_img,
                );
            }
        }

        $n_data['upload_file'] = !empty($upload_file) ? json_encode($upload_file) : NULL;

        /* ===============================
        4. SAVE DATA
        =============================== */
        $this->client_model->_table_name  = 'tbl_client_completion_file';
        $this->client_model->_primary_key = 'id';

        $this->client_model->save($n_data, $id);

        set_message('success', 'Completion file uploaded successfully');

        redirect('admin/client/details/' . $client_id . '/completion_file');
    }

