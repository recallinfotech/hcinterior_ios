    public function new_on_site_purchase_new($id = NULL)
    {
        $client_id = $this->input->post('client_id', true);

        if (empty($client_id)) {
            redirect($_SERVER['HTTP_REFERER']);
        }

        $item_category = $this->input->post('item_category', true);
        $item          = $this->input->post('item', true);
        $qty           = $this->input->post('qty', true);
        $unit          = $this->input->post('unit', true);
        $brand         = $this->input->post('brand', true);
        $other_brand   = $this->input->post('other_brand', true);
        $remarks       = $this->input->post('remarks', true);

        $inserted_count = 0;

        if (!empty($item) && is_array($item)) {

            // 1. Create Parent Purchase Request
            $p_data = array(
                'client_id'      => $client_id,
                'status'         => 'Pending',
                'request_status' => 'Pending',
                'uploaded_by'    => $this->session->userdata('user_id'),
                'created_date'   => date('Y-m-d H:i:s'),
                'updated_date'   => date('Y-m-d H:i:s')
            );
            $this->db->insert('tbl_client_on_site_purchase', $p_data);
            $purchase_id = $this->db->insert_id();

            // Set Purchase Number (e.g. OSPR-0001)
            $purchase_no = 'OSPR-' . sprintf('%04d', $purchase_id);
            $this->db->where('id', $purchase_id)->update('tbl_client_on_site_purchase', array('purchase_no' => $purchase_no));

            // 2. Insert Items for this Purchase Request
            foreach ($item as $key => $val) {
                $cat_val     = isset($item_category[$key]) ? trim($item_category[$key]) : '';
                $item_val    = trim($val);
                $qty_val     = isset($qty[$key]) ? trim($qty[$key]) : '';
                $unit_val    = isset($unit[$key]) ? trim($unit[$key]) : '';
                $brand_val   = isset($brand[$key]) ? trim($brand[$key]) : '';
                if ($brand_val === 'Other' && !empty($other_brand[$key])) {
                    $brand_val = trim($other_brand[$key]);
                }
                $remarks_val = isset($remarks[$key]) ? trim($remarks[$key]) : '';

                if ($item_val != '' || $cat_val != '') {
                    $n_data = array(
                        'client_id'     => $client_id,
                        'purchase_id'   => $purchase_id,
                        'item_category' => $cat_val,
                        'item'          => $item_val,
                        'qty'           => $qty_val,
                        'unit'          => $unit_val,
                        'brand'         => $brand_val,
                        'remarks'       => $remarks_val,
                        'status'        => 'Pending',
                        'created_by'    => $this->session->userdata('user_id'),
                        'created_date'  => date('Y-m-d H:i:s')
                    );
                    $this->db->insert('tbl_client_on_site_purchase_request', $n_data);
                    $inserted_count++;
                }
            }
        }

        if ($inserted_count > 0) {
            $team_members = get_client_team_members($client_id);
            $allowed_roles = ['SPM', 'Factory Purchase Team', 'Project Manager', 'Factory Store', 'Operation Team'];

            foreach ($team_members as $member) {
                $role = $member->member_profile;
                $user_id = $member->user_id;
                if (!in_array($role, $allowed_roles)) {
                    continue;
                }
                if ($user_id == $this->session->userdata('user_id')) {
                    continue;
                }
                $client = $this->db->where('client_id', $client_id)->get('tbl_client')->row();
                $clientName = $client->name ?? 'N/A';
                $message = 'New On Site Purchase Request ' . $purchase_no . ' (' . $inserted_count . ' items) created for ' . $clientName;

                add_notification([
                    'to_user_id'   => $user_id,
                    'from_user_id' => $this->session->userdata('user_id'),
                    'description'  => $message,
                    'link'         => 'admin/client/details/' . $client_id . '/on_site_purchase_request_new',
                    'value'        => $message,
                ]);
                show_notification([$user_id]);
            }
            set_message('success', 'Purchase Request ' . $purchase_no . ' (' . $inserted_count . ' items) created successfully');
        } else {
            set_message('error', 'No valid items provided to save');
        }

        redirect('admin/client/details/' . $client_id . '/on_site_purchase_request_new');
    }

