    public function save_validation_files()
    {
        $client_id = $this->input->post('client_id');

        if (empty($client_id)) {
            redirect($_SERVER['HTTP_REFERER']);
        }

        // 🔥 OLD DATA FETCH
        $existing = $this->db
            ->where('client_id', $client_id)
            ->order_by('id', 'desc')
            ->get('tbl_client_validation_files')
            ->row();

        $data = [
            'client_id'   => $client_id,
            'uploaded_by' => $this->session->userdata('user_id'),
            'updated_date' => date('Y-m-d H:i:s')
        ];

        $target_path = getcwd() . "/uploads/";

        // =========================
        // Validation Checklist
        // =========================
        if (!empty($_FILES['validation_checklist']['name'])) {

            $ext = pathinfo($_FILES['validation_checklist']['name'], PATHINFO_EXTENSION);
            $new_name = time() . '_checklist.' . $ext;

            move_uploaded_file($_FILES['validation_checklist']['tmp_name'], $target_path . $new_name);

            $data['validation_checklist'] = 'uploads/' . $new_name;
        } else {
            // 🔥 OLD VALUE PRESERVE
            $data['validation_checklist'] = $existing->validation_checklist ?? null;
        }

        // =========================
        // Manual Correction
        // =========================
        if (!empty($_FILES['manual_correction_file']['name'])) {

            $ext = pathinfo($_FILES['manual_correction_file']['name'], PATHINFO_EXTENSION);
            $new_name = time() . '_manual.' . $ext;

            move_uploaded_file($_FILES['manual_correction_file']['tmp_name'], $target_path . $new_name);

            $data['manual_correction_file'] = 'uploads/' . $new_name;
        } else {
            // 🔥 OLD VALUE PRESERVE
            $data['manual_correction_file'] = $existing->manual_correction_file ?? null;
        }

        // =========================
        // INSERT OR UPDATE
        // =========================
        if (!empty($existing)) {

            $this->db->where('id', $existing->id);
            $this->db->update('tbl_client_validation_files', $data);
        } else {

            $data['created_date'] = date('Y-m-d H:i:s');
            $this->db->insert('tbl_client_validation_files', $data);
        }




        $team_members = get_client_team_members($client_id);
        $allowed_roles = ['Project Coordinator', 'SPM', 'Project Manager', 'Supervisor'];

        foreach ($team_members as $member) {

            $role = $member->member_profile;
            $user_id = $member->user_id;


            if (!in_array($role, $allowed_roles)) {
                continue;
            }


            if ($user_id == $this->session->userdata('user_id')) {
                continue;
            }


            $client = $this->db
                ->where('client_id', $client_id)
                ->get('tbl_client')
                ->row();

            $clientName = $client->name ?? 'N/A';
            $userName = $_SESSION['user_name'] ?? 'User';
            $subject =  $clientName . ' validation checklist has been updated';
            $message =  $clientName . ' validation checklist has been updated';



            add_notification([
                'to_user_id'   => $user_id,
                'from_user_id' => $this->session->userdata('user_id'),
                'description' =>  $message,
                'link' => 'admin/client/details/' . $client_id . '/validation',
                'value' => $message,
            ]);

            show_notification([$user_id]);
        }



        set_message('success', 'Files updated successfully');
        redirect('admin/client/details/' . $client_id . '/validation');
    }





