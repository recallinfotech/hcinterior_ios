    public function save_escalation()
    {
        $data = [
            'client_id'   => $this->input->post('client_id'),
            'raised_by'   => $this->session->userdata('user_id'),
            'assigned_to' => $this->input->post('assigned_to'),
            'remark'      => $this->input->post('remark'),
            'status'      => 'Open',
            'created_at'  => date('Y-m-d H:i:s')
        ];

        $exists = $this->db
            ->where('client_id', $this->input->post('client_id'))
            ->where('assigned_to', $this->input->post('assigned_to'))
            ->where_in('status', ['Open', 'Replied', 'Reopened'])
            ->get('tbl_client_escalation')
            ->row();

        if ($exists) {

            set_message(
                'error',
                'Active escalation already exists. Please reply on it.'
            );

            redirect($_SERVER['HTTP_REFERER']);
        }

        $this->db->insert('tbl_client_escalation', $data);

        set_message('success', 'Escalation created successfully');

        redirect($_SERVER['HTTP_REFERER']);
    }

