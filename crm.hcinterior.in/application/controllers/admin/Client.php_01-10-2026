        );

        // =========================
        // 🔥 REMARK FILE UPLOAD
        // =========================
        if ($status == 'Reject') {

            $data['remark'] = $remarks;

            if (!empty($_FILES['remark_file']['name'])) {

                $target_path = getcwd() . "/uploads/";
                $file = $_FILES['remark_file'];

                $ext = strtolower(pathinfo($file['name'], PATHINFO_EXTENSION));
                $allowed_ext = ['jpg', 'jpeg', 'png', 'pdf', 'dwg', 'ppt', 'pptx'];

