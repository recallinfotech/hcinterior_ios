    public function get_role_permissions()
    {
        if ($this->input->is_ajax_request()) {

            $role_id   = $this->input->post('role_id');
            $client_id = $this->input->post('client_id');
            $user_id   = $this->input->post('user_id');

            // Role wise all permissions
            $permissions = $this->db
                ->where('role_id', $role_id)
                ->get('permissions')
                ->result();

            // Already assigned permissions for this user + client
            $assigned = $this->db
                ->select('permission_key')
                ->where([
                    'client_id' => $client_id,
                    'user_id'   => $user_id
                ])
                ->get('operation_permissions')
                ->result_array();

            $assigned_keys = array_column($assigned, 'permission_key');

            if (!empty($permissions)) {
                foreach ($permissions as $perm) {

                    $checked = in_array($perm->permission_key, $assigned_keys)
                        ? 'checked'
                        : '';

                    echo '
                <div class="col-md-6">
                    <div class="checkbox">
                        <label>
                            <input type="checkbox" name="permissions[]" 
                                   value="' . $perm->permission_key . '" ' . $checked . '>
                            ' . $perm->permission_label . '
                        </label>
                    </div>
                </div>';
                }
            }
        }
    }


