public function get_departments()
{
    $user_id = $this->session->userdata('user_id');

    // Check karo ki login user kisi department ka head hai ya nahi
    $this->db->select('departments_id, deptname');
    $this->db->where('department_head_id', $user_id);
    $department = $this->db->get('tbl_departments')->result();

    if (!empty($department)) {
        // User department head hai -> sirf uska department
        $departments = $department;
    } else {
        // User department head nahi hai -> sab departments
        $this->db->select('departments_id, deptname');
        $departments = $this->db->get('tbl_departments')->result();
    }

    $response = [];

    foreach ($departments as $dept) {
        $response[] = [
            'id'   => $dept->departments_id,
            'name' => $dept->deptname
        ];
    }

    echo json_encode($response);
    exit;
}

public function get_users_by_department()
{
    $department_id = $this->input->post('departments_id');
   // $department_id = 1 ;

    if ($department_id) {
        // Step 1: Get designation_ids from the department
        $designation_ids = $this->db->select('designations_id')
            ->from('tbl_designations')
            ->where('departments_id', $department_id)
            ->get()->result();

        $designation_ids_array = array_map(function($row) {
            return $row->designations_id;
        }, $designation_ids);

        if (!empty($designation_ids_array)) {
            // Step 2: Get users whose designation_id in those
            $users = $this->db->select('user_id, fullname')
                ->from('tbl_account_details')
                ->where_in('designations_id', $designation_ids_array)
                ->get()->result();
//print_r($users);
            $options = '<option value="">Select User</option>';
            foreach ($users as $user) {
                $options .= "<option value='{$user->user_id}'>{$user->fullname}</option>";
            }
            echo $options;
        } else {
            echo '<option value="">No Users Found</option>';
        }
    } else {
        echo '<option value="">No Users Found</option>';
    }
}




