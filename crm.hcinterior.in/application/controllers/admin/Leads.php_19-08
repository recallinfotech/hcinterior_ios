   public function save_imported()
{
    $this->load->database();

    if (!empty($_FILES['upload_file']['name'])) {
       $file = $_FILES['upload_file']['tmp_name'];

        try {
            $reader = new \PhpOffice\PhpSpreadsheet\Reader\Xlsx();
            $spreadsheet = $reader->load($file);
            $sheetData = $spreadsheet->getActiveSheet()->toArray(null, true, true, false);

            if (count($sheetData) > 1) {
                $headers = array_map('trim', $sheetData[0]); // first row = column names

                for ($i = 1; $i < count($sheetData); $i++) {
                    $row = $sheetData[$i];
                    $data = [];

                    for ($j = 0; $j < count($headers); $j++) {
                        if (!empty($headers[$j])) {
                            $column = trim($headers[$j]);
                            $data[$column] = isset($row[$j]) ? trim($row[$j]) : null;
                        }
                    }

                    // ✅ Auto-fill logic
                    if (empty($data['contact_name'])) {
                        $data['contact_name'] = $data['phone'];
                    }

                    if (empty($data['email']) && !empty($data['phone'])) {
                        $data['email'] = $data['phone'] . '@gmail.com';
                    }

                    if (empty($data['lead_name'])) {
                        $data['lead_name'] = 'lead by ' . $data['phone'];
                    }

                    if (empty($data['company_name'])) {
                        $data['company_name'] = $data['phone'];
                    }

                    if (empty($data['organization'])) {
                        $data['organization'] = $data['phone'];
                    }

                    if (empty($data['mobile'])) {
                        $data['mobile'] = $data['phone'];
                    }

                    if (!empty($data)) {

                    if (!empty($data['permission'])) {
                    $permissionRaw = trim($data['permission'], "\"' ");
                    log_message('debug', 'Raw permission string before decoding: ' . $permissionRaw);

                    $decoded = json_decode($permissionRaw, true);
                    if (json_last_error() === JSON_ERROR_NONE) {
                        $data['permission'] = json_encode($decoded);
                    } else {
                        log_message('error', 'Invalid JSON in permission: ' . json_last_error_msg());
                        $data['permission'] = json_encode(['all']);
                    }
                    } else {
                        $data['permission'] = json_encode(['all']);
                    }
                        $inserted = $this->db->insert('tbl_leads', $data);
                        if (!$inserted) {
                            $error = $this->db->error();
                            log_message('error', 'Row ' . $i . ' insert failed: ' . json_encode($error));
                            log_message('error', 'Data attempted: ' . json_encode($data));
                        }
                    }
                }

                $this->session->set_flashdata('success', 'Leads imported successfully.');
            } else {
                $this->session->set_flashdata('error', 'Excel file is empty.');
            }
        } catch (Exception $e) {
            $this->session->set_flashdata('error', 'Import error: ' . $e->getMessage());
        }
    } else {
        $this->session->set_flashdata('error', 'Please select a file to upload.');
    }

    redirect('admin/leads');
}

    
    
    
    public function save_imported_old()
{

  
    echo CI_VERSION;
 
    // Enable error reporting (for debugging only)
    // ini_set('display_errors', 1);
    // error_reporting(E_ALL);

    // Load PHPExcel
    $this->load->library('excel');
    $file = $_FILES['upload_file']['tmp_name'];

    if (!is_uploaded_file($file)) {
        set_message('error', 'No file was uploaded or file upload failed.');
        redirect('admin/leads');
    }

    // Detect Excel file type
    $valid = false;
    $types = ['Excel2007', 'Excel5', 'CSV'];
    foreach ($types as $type) {
        $reader = PHPExcel_IOFactory::createReader($type);
        if ($reader->canRead($file)) {
            $valid = true;
            break;
        }
    }

    if (!$valid) {
        set_message('error', 'Invalid file type! Please upload XLS, XLSX, or CSV.');
        redirect('admin/leads');
    }

    // Load file
    try {
        $objPHPExcel = PHPExcel_IOFactory::load($file);
    } catch (Exception $e) {
        set_message('error', 'Error loading file: ' . $e->getMessage());
        redirect('admin/leads');
    }

    // Read data from active sheet
    $sheetData = $objPHPExcel->getActiveSheet()->toArray(null, true, true, true);

    // Get permissions
    $permission = $this->input->post('permission', true);
    $assigned = 'all';

    if (!empty($permission) && $permission != 'everyone') {
        $assigned_to = $this->items_model->array_from_post(['assigned_to']);
        $assigned_array = [];

        if (!empty($assigned_to['assigned_to'])) {
            foreach ($assigned_to['assigned_to'] as $assign_user) {
                $assigned_array[$assign_user] = $this->input->post('action_' . $assign_user, true);
            }
        }

        $assigned = !empty($assigned_array) ? json_encode($assigned_array) : 'all';
    }

    $data_template = $this->items_model->array_from_post(['client_id', 'lead_status_id', 'lead_source_id']);
    $my_data = [];

    for ($x = 2; $x <= count($sheetData); $x++) {
        if (empty($sheetData[$x]["A"])) {
            continue; // skip empty rows
        }

        $data = $data_template; // start with base fields
        $data['lead_name']     = trim($sheetData[$x]["A"] ?? '');
        $data['organization']  = trim($sheetData[$x]["B"] ?? '');
        $data['contact_name']  = trim($sheetData[$x]["C"] ?? '');
        $data['email']         = trim($sheetData[$x]["D"] ?? '');
        $data['phone']         = trim($sheetData[$x]["E"] ?? '');
        $data['mobile']        = trim($sheetData[$x]["F"] ?? '');
        $data['address']       = trim($sheetData[$x]["G"] ?? '');
        $data['city']          = trim($sheetData[$x]["H"] ?? '');
        $data['country']       = trim($sheetData[$x]["I"] ?? '');
        $data['facebook']      = trim($sheetData[$x]["J"] ?? '');
        $data['skype']         = trim($sheetData[$x]["K"] ?? '');
        $data['twitter']       = trim($sheetData[$x]["L"] ?? '');
        $data['notes']         = trim($sheetData[$x]["M"] ?? '');
        $data['permission']    = $assigned;

        $my_data[] = $data;
    }

    if (!empty($my_data)) {
        $this->db->insert_batch('tbl_leads', $my_data);
        set_message('success', lang('save_leads'));
    } else {
        set_message('error', 'No valid rows found in the file.');
    }

    redirect('admin/leads');
}

    public function saved_leads($id = NULL)
{
    $created = can_action('55', 'created');
    $edited = can_action('55', 'edited');

    if (!empty($created) || (!empty($edited) && !empty($id))) {
        $this->items_model->_table_name = 'tbl_leads';
        $this->items_model->_primary_key = 'leads_id';

        $data = $this->items_model->array_from_post([
            'client_id', 'lead_name', 'organization', 'language', 'lead_status_id',
            'lead_source_id', 'contact_name', 'email', 'phone', 'mobile',
            'address', 'city', 'state', 'country', 'notes', 'last_contact',
            'property_type', 'possesion', 'possesion_date', 'floor_plan',
            'budget_from', 'budget_to', 'alternate_number', 'region',
            'lead_assign_date', 'lead_followup_date', 'area', 'sub_status'
        ]);

        // Auto-fill logic
        $data['contact_name'] = $data['contact_name'] ?: $data['phone'];
        $data['email'] = $data['email'] ?: ($data['phone'] . '@gmail.com');
        $data['lead_name'] = $data['lead_name'] ?: ('lead by ' . $data['phone']);
        $data['company_name'] = $data['company_name'] ?? $data['phone'];
        $data['organization'] = $data['organization'] ?: $data['phone'];
        $data['mobile'] = $data['mobile'] ?: $data['phone'];

        // Duplicate check
        $where = ['client_id' => $data['client_id'], 'lead_name' => $data['lead_name']];
        $leads_id = !empty($id) ? ['leads_id !=' => $id] : null;

        $check_leads = $this->items_model->check_update('tbl_leads', $where, $leads_id);
        $check_phone = $this->items_model->check_update('tbl_leads', ['phone' => $data['phone']], $leads_id);
        $check_mobile = $this->items_model->check_update('tbl_leads', ['mobile' => $data['mobile']], $leads_id);

        // ✅ Mark duplicate if any similar data exists
        $is_duplicate = (!empty($check_leads) || !empty($check_phone) || !empty($check_mobile));
        $data['is_duplicate'] = $is_duplicate ? 1 : 0;

        // Save permission
        $permission = $this->input->post('permission', true);
        if (!empty($permission)) {
            if ($permission == 'everyone') {
                $assigned = 'all';
            } else {
                $assigned_to = $this->items_model->array_from_post(['assigned_to']);
                $assigned = [];
                if (!empty($assigned_to['assigned_to'])) {
                   foreach ($assigned_to['assigned_to'] as $assign_user) {
                       
                                  $user_info = $this->db->select('tbl_users.fcm_token, tbl_account_details.fullname')
                      ->from('tbl_users')
                      ->join('tbl_account_details', 'tbl_users.user_id = tbl_account_details.user_id', 'left')
                      ->where('tbl_users.user_id', $assign_user)
                      ->get()
                      ->row();


                            //print_r($user_info);

                          

                   $response = $this->notification_lib->send_app_notification(
                        "New Lead Assigned",
                        "Hi {$user_info->fullname}, a new lead '{$data['lead_name']}' has been assigned to you.",
                        "https://hcinterior.in/static-images/promo.jpg",
                        $user_info->fcm_token
                    );

                 //   exit();
                                      
                        $assigned[$assign_user] = $this->input->post('action_' . $assign_user, true);
                    }
                }
                $assigned = !empty($assigned) ? json_encode($assigned) : 'all';
            }
            $data['permission'] = $assigned;
        } else {
            set_message('error', lang('assigned_to') . ' Field is required');
            redirect($_SERVER['HTTP_REFERER'] ?? 'admin/leads');
        }

        // Save lead
        $return_id = $this->items_model->save($data, $id);

        // Secondary update for index_no
        $id = !empty($id) ? $id : $return_id;
        $this->items_model->save(['index_no' => $id], $id);

        // Save custom fields
        save_custom_field(5, $id);

        // Activity log
        $action = !empty($return_id) && empty($id) ? 'activity_save_leads' : 'activity_update_leads';
        $description = $action == 'activity_save_leads' ? 'not_save_leads' : 'not_update_leads';
        $msg = $action == 'activity_save_leads' ? lang('save_leads') : lang('update_leads');

        $activity = [
            'user' => $this->session->userdata('user_id'),
            'module' => 'leads',
            'module_field_id' => $id,
            'activity' => $action,
            'icon' => 'fa-rocket',
            'link' => 'admin/leads/leads_details/' . $id,
            'value1' => $data['lead_name']
        ];
        $this->items_model->_table_name = 'tbl_activities';
        $this->items_model->_primary_key = 'activities_id';
        $this->items_model->save($activity);

        // Notifications
        $leads_info = $this->items_model->check_by(['leads_id' => $id], 'tbl_leads');
        $notifiedUsers = [];

                $assign_by = !empty($notifiedUsers[0]) ? $notifiedUsers[0] : null; // Just take the first user for assign_by
        $log_data = array(
            'lead_id'     => $leads_info->leads_id,
            'status'      => $data['lead_status_id'],
            'update_by'   => $this->session->userdata('user_id'),
            'assign_by'   => $assign_by,
            'createdate'  => date('Y-m-d H:i:s'),
            'other'       => null,
            'is_deleted'  => 0
        );

        $this->items_model->_table_name = 'tbl_status_log';
        $this->items_model->_primary_key = 'status_log_id';
        $this->items_model->save($log_data);


        if (!empty($leads_info->permission) && $leads_info->permission != 'all') {
            $permissionUsers = json_decode($leads_info->permission);
            foreach ($permissionUsers as $user => $v_permission) {
                $notifiedUsers[] = $user;
            }
        } else {
            $notifiedUsers = $this->items_model->allowed_user_id('55');
        }

        foreach ($notifiedUsers as $users) {
            if ($users != $this->session->userdata('user_id')) {
                add_notification([
                    'to_user_id' => $users,
                    'from_user_id' => true,
                    'description' => $description,
                    'link' => 'admin/leads/leads_details/' . $leads_info->leads_id,
                    'value' => lang('lead') . ' ' . $leads_info->lead_name,
                ]);
            }
        }

        show_notification($notifiedUsers);

        set_message("success", $msg);
    }
	
$prev_url = $this->session->userdata('previous_url');
if ($prev_url) {
    redirect($prev_url);
} else {
    redirect('admin/leads');
}
}


