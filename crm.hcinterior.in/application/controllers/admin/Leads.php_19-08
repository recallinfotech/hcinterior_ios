    public function update_users($id)
    {
        // get all assign_user
        $can_edit = $this->items_model->can_action('tbl_leads', 'edit', array('leads_id' => $id));
        if (!empty($can_edit)) {
            // get permission user by menu id
            $data['assign_user'] = $this->items_model->allowed_user('55');

            $data['leads_info'] = $this->items_model->check_by(array('leads_id' => $id), 'tbl_leads');
            $data['modal_subview'] = $this->load->view('admin/leads/_modal_users', $data, FALSE);
            $this->load->view('admin/_layout_modal', $data);
        } else {
            set_message('error', lang('there_in_no_value'));
            if (empty($_SERVER['HTTP_REFERER'])) {
                redirect('admin/leads');
            } else {
                redirect($_SERVER['HTTP_REFERER']);
            }
        }
    }
 

      public function bulk_update_members()
    {

        // print_r($_POST);
        // die;

        if ($this->input->is_ajax_request()) {
            $delete_comments = $this->input->post('delete_comments', true); // <-- add this
            $delete_activities = $this->input->post('delete_activities', true); // <-- add this
            $selected_leads_ids_str = $this->input->post('selected_leads_ids', true);
            $lead_status_id = $this->input->post('lead_status_id');
            $selected_leads_ids = explode(',', $selected_leads_ids_str);
            $assigned_to_users = $this->input->post('assigned_to', true); // This will be an array of user IDs

            if (empty($selected_leads_ids)) {
                echo json_encode(['success' => false, 'message' => lang('No Lead Selected')]);
                return;
            }

            if (empty($assigned_to_users)) {
                echo json_encode(['success' => false, 'message' => lang('assigned_to') . ' ' . lang('Fiels is Required')]); // Or a more specific message
                return;
            }

            $assigned_permission_data = [];
            // Default permission can be 'edit' and 'view' as per your requirement
            $default_actions = ["edit", "view"];

            foreach ($assigned_to_users as $user_id) {
                // Ensure user_id is an integer for safety and consistency
                $user_id = (int)$user_id;
                if ($user_id > 0) {
                    $assigned_permission_data[$user_id] = $default_actions;
                }
            }

            // Convert the permission data to JSON
            if (!empty($assigned_permission_data)) {
                $assigned_json = json_encode($assigned_permission_data);
            } else {
                // If no specific users are selected (though the check above should prevent this),
                // you might default to 'all' or throw an error.
                // For this scenario, we assume at least one user will be selected due to validation.
                $assigned_json = 'all'; // Fallback, though should be caught by empty($assigned_to_users)
            }


            $success_count = 0;
            $failed_count = 0;
            $updated_lead_ids = [];
            
           
            foreach ($selected_leads_ids as $lead_id) {
                $lead_id = (int)$lead_id; // Ensure lead_id is an integer

                // Basic permission check (can_action is crucial for security)
                // Assuming '55' is the module_id for 'leads'
                $can_edit = $this->items_model->can_action('tbl_leads', 'edit', ['leads_id' => $lead_id]);

                // Only allow update if the user has edit permission for that specific lead
                // or if the current user is an administrator (role_id 1)
                if (empty($can_edit) && $this->session->userdata('role_id') != 1) {
                    $failed_count++;
                    continue; // Skip if no permission
                }

                   if($lead_status_id) { 

                $data = [
                    'permission' => $assigned_json,
                    'lead_assign_date' => date('Y-m-d H:i:s'),
                    'lead_followup_date' => date('Y-m-d H:i:s'),
                    'lead_status_id' => $lead_status_id,
                ];
            } else {
                 $data = [
                    'permission' => $assigned_json,
                    'lead_assign_date' => date('Y-m-d H:i:s'),
                    'lead_followup_date' => date('Y-m-d H:i:s'),
                ];
            }
 
                $this->items_model->_table_name = "tbl_leads";
                $this->items_model->_primary_key = "leads_id";
                $update_result = $this->items_model->save($data, $lead_id);

                if ($update_result) {
                    $success_count++;
                    $updated_lead_ids[] = $lead_id;

       
      
                      // ✅ DELETE COMMENTS if checkbox is checked
                if (!empty($delete_activities)) {
        $where = array('module' => 'leads', 'module_field_id' => $lead_id);
        $this->tasks_model->_table_name = "tbl_activities"; // table name
        $this->tasks_model->delete_multiple($where);
                }
                if (!empty($delete_comments)) {
                    $this->db->where('module', 'leads');
                    $this->db->where('module_field_id', $lead_id);
                    $this->db->delete('tbl_task_comment');
                }

                
                    // Log activity for each updated lead
                    $leads_info = $this->items_model->check_by(['leads_id' => $lead_id], 'tbl_leads');
                    if ($leads_info) { // Ensure lead info is retrieved
                        $activities = [
                            'user' => $this->session->userdata('user_id'),
                            'module' => 'leads',
                            'module_field_id' => $lead_id,
                            'activity' => 'activity_bulk_assign_leads', // Consider adding this to your lang file
                            'icon' => 'fa-rocket',
                            'link' => 'admin/leads/leads_details/' . $lead_id,
                            'value1' => $leads_info->lead_name,
                        ];
                        $this->items_model->_table_name = "tbl_activities";
                        $this->items_model->_primary_key = "activities_id";
                        $this->items_model->save($activities);
                    }

                    // Send notifications to newly assigned users
                    // No need to compare with old permissions for simplicity in bulk assign
                    $notifiedUsers = array_keys($assigned_permission_data);

                    foreach ($notifiedUsers as $user_to_notify) {
                        if ($user_to_notify != $this->session->userdata('user_id')) {
                            add_notification([
                                'to_user_id' => $user_to_notify,
                                'from_user_id' => true,
                                'description' => 'assign_to_you_the_lead', // Use existing lang key
                                'link' => 'admin/leads/leads_details/' . $lead_id,
                                'value' => lang('lead') . ' ' . ($leads_info ? $leads_info->lead_name : $lead_id),
                            ]);
                        }
                    }
                    if (!empty($notifiedUsers)) {
                        show_notification($notifiedUsers);
                    }
                } else {
                    $failed_count++;
                }
            }

            if ($success_count > 0) {
                echo json_encode([
                    'success' => true,
                    'message' => sprintf(lang('Leas Assigned Successfully'), $success_count)
                ]);
            } else {
                echo json_encode([
                    'success' => false,
                    'message' => lang('No lead assigned permission decline') // New lang key
                ]);
            }

        } else {
            redirect('admin/dashboard');
        }
    }


     public function update_member($id)
    {


     
        $can_edit = $this->items_model->can_action('tbl_leads', 'edit', array('leads_id' => $id));
              if (!empty($can_edit)) {
                $leads_info = $this->items_model->check_by(array('leads_id' => $id), 'tbl_leads');
                $permission = $this->input->post('permission', true);
                if (!empty($permission)) {

                if ($permission == 'everyone') {
                    $assigned = 'all';
                } else {
                  $assigned_to = $this->items_model->array_from_post(array('assigned_to'));
                    if (!empty($assigned_to['assigned_to'])) {
                        // foreach ($assigned_to['assigned_to'] as $assign_user) {
                        //  $assigned[$assign_user] = $this->input->post('action_' . $assign_user, true);
                        // }

                        
        foreach ($assigned_to['assigned_to'] as $assign_user) {
                       
                          $user_info = $this->db->select('tbl_users.fcm_token, tbl_account_details.fullname')
                      ->from('tbl_users')
                      ->join('tbl_account_details', 'tbl_users.user_id = tbl_account_details.user_id', 'left')
                      ->where('tbl_users.user_id', $assign_user)
                      ->get()
                      ->row();
 
                   $response = $this->notification_lib->send_app_notification(
                        "New Lead Assigned",
                        "Hi {$user_info->fullname}, a new lead '{$data['lead_name']}' has been assigned to you.",
                        "https://hcinterior.in/images/new_hc_logo.png",
                        $user_info->fcm_token
                    );
        
                        $assigned[$assign_user] = $this->input->post('action_' . $assign_user, true);
                    }


                    }
                }
                if (!empty($assigned)) {
                    if ($assigned != 'all') {
                        $assigned = json_encode($assigned);
                    }
                } else {
                    $assigned = 'all';
                }
              $data['permission'] = $assigned;
              $data['lead_assign_date'] = date('Y-m-d H:i:s');
              $data['lead_followup_date'] = date('Y-m-d H:i:s');


            } else {
                set_message('error', lang('assigned_to') . ' Field is required');
                if (empty($_SERVER['HTTP_REFERER'])) {
                    redirect('admin/leads');
                } else {
                    redirect($_SERVER['HTTP_REFERER']);
                }
            }

            //save data into table.
            $this->items_model->_table_name = "tbl_leads"; // table name
            $this->items_model->_primary_key = "leads_id"; // $id
            $this->items_model->save($data, $id);

            $msg = lang('update_leads');
            $activity = 'activity_update_leads';

            // save into activities
            $activities = array(
                'user' => $this->session->userdata('user_id'),
                'module' => 'leads',
                'module_field_id' => $id,
                'activity' => $activity,
                'icon' => 'fa-rocket',
                'link' => 'admin/leads/leads_details/' . $id,
                'value1' => $leads_info->lead_name,
            );
            // Update into tbl_project
            $this->items_model->_table_name = "tbl_activities"; //table name
            $this->items_model->_primary_key = "activities_id";
            $this->items_model->save($activities);

            $notifiedUsers = array();
            if (!empty($leads_info->permission) && $leads_info->permission != 'all') {
                $permissionUsers = json_decode($leads_info->permission);
                
                foreach ($permissionUsers as $user => $v_permission) {
                    array_push($notifiedUsers, $user);
                }

             
            } else {
                $notifiedUsers = $this->items_model->allowed_user_id('55');
                    
            }
            if (!empty($notifiedUsers)) {
                 
                foreach ($notifiedUsers as $users) {

                   
                    if ($users != $this->session->userdata('user_id')) {
                        add_notification(array(
                            'to_user_id' => $users,
                            'from_user_id' => true,
                            'description' => 'assign_to_you_the_lead',
                            'link' => 'admin/leads/leads_details/' . $leads_info->leads_id,
                            'value' => lang('lead') . ' ' . $leads_info->lead_name,
                        ));
                    }
                }
                show_notification($notifiedUsers);
              
            }
                
            $type = "success";
            $message = $msg;
            set_message($type, $message);
        } else {
            set_message('error', lang('there_in_no_value'));
        }
        if (empty($_SERVER['HTTP_REFERER'])) {
            redirect('admin/leads');
        } else {
            redirect($_SERVER['HTTP_REFERER']);
        }
    }
	

    public function change_status($leads_id, $lead_status_id)
    {
        $can_edit = $this->items_model->can_action('tbl_leads', 'edit', array('leads_id' => $leads_id));
        if (!empty($can_edit)) {

            $data['lead_status_id'] = $lead_status_id;
            $this->items_model->_table_name = 'tbl_leads';
            $this->items_model->_primary_key = 'leads_id';
            $this->items_model->save($data, $leads_id);

           

              $leads_info = $this->items_model->check_by(array('leads_id' => $leads_id), 'tbl_leads');

               
                if($lead_status_id==4) {
                // ✅ decode permission JSON
                $permissionUsers = !empty($leads_info->permission) ? json_decode($leads_info->permission, true) : [];

                if (!empty($permissionUsers)) {
                    $userIds = array_keys((array)$permissionUsers); // permission IDs (account_details_id)

                    // Get all users with designation 3
                    $this->db->select('user_id');
                    $this->db->from('tbl_account_details');
                    $this->db->where_in('user_id', $userIds);
                    $this->db->where('designations_id', 3);
                    $designation3Users = $this->db->get()->result_array();

                    $removeIds = array_column($designation3Users, 'user_id');

                    // 🔽 Remove those IDs from permission JSON
                    foreach ($removeIds as $id) {
                        if (isset($permissionUsers[$id])) {
                            unset($permissionUsers[$id]);
                        }
                    }

                    // ✅ New permission JSON
                    $newPermission = json_encode($permissionUsers);

                    // echo "<pre>";
                    // print_r($newPermission);
                    // echo "</pre>";
                        $data['permission'] = $newPermission;
                            $this->items_model->_table_name = 'tbl_leads';
                            $this->items_model->_primary_key = 'leads_id';
                            $this->items_model->save($data, $leads_id);

                }
            }
 
            $notifiedUsers = array();
            if (!empty($leads_info->permission) && $leads_info->permission != 'all') {
                $permissionUsers = json_decode($leads_info->permission);
                foreach ($permissionUsers as $user => $v_permission) {
                    array_push($notifiedUsers, $user);
                }
            } else {
                $notifiedUsers = $this->items_model->allowed_user_id('55');
            }

             // 🔽 Log status change
        $assign_by = !empty($notifiedUsers[0]) ? $notifiedUsers[0] : null; // Just take the first user for assign_by
        $log_data = array(
            'lead_id'     => $leads_info->leads_id,
            'status'      => $lead_status_id,
            'update_by'   => $this->session->userdata('user_id'),
            'assign_by'   => $assign_by,
            'createdate'  => date('Y-m-d H:i:s'),
            'other'       => null,
            'is_deleted'  => 0
        );

        $this->items_model->_table_name = 'tbl_status_log';
        $this->items_model->_primary_key = 'status_log_id';
        $this->items_model->save($log_data);

            if (!empty($notifiedUsers)) {
                foreach ($notifiedUsers as $users) {
                    if ($users != $this->session->userdata('user_id')) {
                        add_notification(array(
                            'to_user_id' => $users,
                            'from_user_id' => true,
                            'description' => 'not_changed_status',
                            'link' => 'admin/leads/leads_details/' . $leads_info->leads_id,
                            'value' => lang('lead') . ' ' . $leads_info->lead_name,
                        ));
                    }
                }
                show_notification($notifiedUsers);
            }
            // messages for user
            $type = "success";
            $message = lang('change_status');
            set_message($type, $message);
        } else {
            set_message('error', lang('there_in_no_value'));
        }
        if (empty($_SERVER['HTTP_REFERER'])) {
            redirect('admin/leads');
        } else {
            redirect($_SERVER['HTTP_REFERER']);
        }
    }

    public
    function saved_call($leads_id, $id = NULL)
    {
        $data = $this->items_model->array_from_post(array('date', 'call_summary', 'client_id', 'user_id'));
        $data['leads_id'] = $leads_id;
        $this->items_model->_table_name = 'tbl_calls';
        $this->items_model->_primary_key = 'calls_id';
        $return_id = $this->items_model->save($data, $id);
        if (!empty($id)) {
            $id = $id;
            $action = 'activity_update_leads_call';
            $msg = lang('update_leads_call');
        } else {
            $id = $return_id;
            $action = 'activity_save_leads_call';
            $msg = lang('save_leads_call');
        }
        $activity = array(
            'user' => $this->session->userdata('user_id'),
            'module' => 'leads',
            'module_field_id' => $leads_id,
            'activity' => $action,
            'icon' => 'fa-rocket',
            'link' => 'admin/leads/leads_details/' . $leads_id . '/call',
