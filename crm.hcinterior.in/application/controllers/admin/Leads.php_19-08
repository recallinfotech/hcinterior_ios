    public function reminder_list()
{
    $data['title'] = lang('Reminder List');
    $data['active'] = 2;

    // Get current user details
    $user_id = $this->session->userdata('user_id');
    $this->db->where('user_id', $user_id);
    $current_user = $this->db->get('tbl_account_details')->row();

    $is_team_leader = !empty($current_user) && $current_user->team_leader == 1;
    $is_regional_manager = !empty($current_user) && $current_user->regional_manager == 1;
    $is_admin = $this->session->userdata('user_type') == 1;
 
    // Start building query
    if (!empty($_GET['filter_date'])) {
        $filter_date = $_GET['filter_date'];
        $this->db->where('DATE(tbl_reminders.date)', $filter_date);
    }

    $this->db->select('tbl_reminders.*, tbl_leads.leads_id, tbl_leads.contact_name, tbl_leads.phone, tbl_account_details.fullname');
    $this->db->from('tbl_reminders');
    $this->db->join('tbl_leads', 'tbl_leads.leads_id = tbl_reminders.module_id', 'left');
    $this->db->join('tbl_account_details', 'tbl_account_details.user_id = tbl_reminders.created_by', 'left');
    $this->db->where('tbl_reminders.module', 'leads');
if ($is_admin || $is_regional_manager) {
    // Admins & Regional Managers → see all
} elseif ($is_team_leader) {
    // Team Leaders → only where they are in permission JSON
    $this->db->where("JSON_CONTAINS_PATH(tbl_leads.permission, 'one', '$.\"$user_id\"')", NULL, FALSE);

} else {
    // Normal users → only their own reminders
    $this->db->where('tbl_reminders.created_by', $user_id);
}
  

    $this->db->order_by('tbl_reminders.reminder_id', 'DESC');
    $data['reminders'] = $this->db->get()->result();

    $data['subview'] = $this->load->view('admin/leads/reminder_list', $data, TRUE);
    $this->load->view('admin/_layout_main', $data); // page load
}


public function reminder_today()
{
    $data['title'] = lang('Reminder List');
    $data['active'] = 1;

    $user_id = $this->session->userdata('user_id');
    $user_type = $this->session->userdata('user_type');

    // Get current user details
    $this->db->where('user_id', $user_id);
    $current_user = $this->db->get('tbl_account_details')->row();

    $is_team_leader = !empty($current_user) && $current_user->team_leader == 1;
    $is_regional_manager = !empty($current_user) && $current_user->regional_manager == 1;
    $is_admin = $user_type == 1;

    // Filter by today's date
    $today = date('Y-m-d');
    $this->db->where('DATE(tbl_reminders.date)', $today);

  if ($is_admin || $is_regional_manager) {
    // Admins & Regional Managers → see all
} elseif ($is_team_leader) {
    // Team Leaders → only where they are in permission JSON
    $this->db->where("JSON_CONTAINS_PATH(tbl_leads.permission, 'one', '$.\"$user_id\"')", NULL, FALSE);

} else {
    // Normal users → only their own reminders
    $this->db->where('tbl_reminders.created_by', $user_id);
}
    // Join and fetch
    $this->db->select('tbl_reminders.*, tbl_leads.leads_id, tbl_leads.contact_name, tbl_leads.phone, tbl_account_details.fullname');
    $this->db->from('tbl_reminders');
    $this->db->join('tbl_leads', 'tbl_leads.leads_id = tbl_reminders.module_id', 'left');
    $this->db->join('tbl_account_details', 'tbl_account_details.user_id = tbl_reminders.created_by', 'left');
    $this->db->where('tbl_reminders.module', 'leads');
    $this->db->order_by('tbl_reminders.reminder_id', 'DESC');
    $data['reminders'] = $this->db->get()->result();

    $data['subview'] = $this->load->view('admin/leads/reminder_today', $data, TRUE);
    $this->load->view('admin/_layout_main', $data);
}
public function get_status_logs_by_lead($lead_id)
{

    
    $user_id = $this->session->userdata('user_id');
    $user_type = $this->session->userdata('user_type');

    $this->db->where('user_id', $user_id);
    $current_user = $this->db->get('tbl_account_details')->row();

    $is_team_leader = !empty($current_user) && $current_user->team_leader == 1;
    $is_regional_manager = !empty($current_user) && $current_user->regional_manager == 1;
    $is_admin = $user_type == 1;


    $this->db->select('
        sl.*, 
        l.leads_id, 
        l.phone, 
        l.contact_name, 
        u.fullname as updated_by_name, 
        ls.lead_status as status_name
    ');
    $this->db->from('tbl_status_log sl');
    $this->db->join('tbl_leads l', 'l.leads_id = sl.lead_id', 'left');
    $this->db->join('tbl_account_details u', 'u.user_id = sl.update_by', 'left');
    $this->db->join('tbl_lead_status ls', 'ls.lead_status_id = sl.status', 'left');
    $this->db->where('sl.lead_id', $lead_id);
    $this->db->order_by('sl.createdate', 'DESC');
    
    if (!$is_team_leader && !$is_regional_manager && !$is_admin) {
        $this->db->where('sl.update_by', $user_id);
    }
    $logs = $this->db->get()->result();

    $html = '<table class="table table-bordered table-striped">';
    $html .= '<thead><tr>
                <th>#</th>
                <th>Status</th>
                <th>Updated By</th>
                <th>Date</th>
            </tr></thead><tbody>';

    if (!empty($logs)) {
        $i = 1;
        foreach ($logs as $log) {
            $html .= '<tr>
                        <td>' . $i++ . '</td>
                        <td>' . ($log->status_name ?? 'N/A') . '</td>
                        <td>' . ($log->updated_by_name ?? 'N/A') . '</td>
                        <td>' . (!empty($log->createdate) ? date('d M Y H:i A', strtotime($log->createdate)) : 'N/A') . '</td>
                    </tr>';
        }
    } else {
        $html .= '<tr><td colspan="4" class="text-center">No logs found.</td></tr>';
    }

    $html .= '</tbody></table>';

    echo $html;
}

 public function lead_status_log()
{
    $data['title'] = lang('Status Logs');
    $data['active'] = 1;

    $user_id = $this->session->userdata('user_id');
    $user_type = $this->session->userdata('user_type');

    $this->db->where('user_id', $user_id);
    $current_user = $this->db->get('tbl_account_details')->row();

    $is_team_leader = !empty($current_user) && $current_user->team_leader == 1;
    $is_regional_manager = !empty($current_user) && $current_user->regional_manager == 1;
    $is_admin = $user_type == 1;

    // Get filters from GET
    $sub_status = $this->input->get('sub_status');
    $status_date = $this->input->get('status_date');
    $user_id_filter = $this->input->get('user_id'); // ✅ new

    $this->db->select('
        sl.*, 
        l.leads_id, 
        l.phone, 
        l.contact_name, 
        l.created_time, 
        u.fullname as updated_by_name, 
        ls.lead_status as status_name
    ');
    $this->db->from('tbl_status_log sl');
    $this->db->join('tbl_leads l', 'l.leads_id = sl.lead_id', 'left');
    $this->db->join('tbl_account_details u', 'u.user_id = sl.update_by', 'left');
    $this->db->join('tbl_lead_status ls', 'ls.lead_status_id = sl.status', 'left');

    if (!$is_team_leader && !$is_regional_manager && !$is_admin) {
        $this->db->where('sl.update_by', $user_id); // normal user
    } elseif (!empty($user_id_filter)) {
        $this->db->where('sl.update_by', $user_id_filter); // ✅ user filter
    }

    if (!empty($sub_status)) {
        $this->db->where('sl.status', $sub_status);
    }
    if (!empty($status_date)) {
        $this->db->where('DATE(sl.createdate)', $status_date);
    }

    $this->db->order_by('sl.createdate', 'DESC');
    $data['tbl_status_log'] = $this->db->get()->result();

    // ✅ Get only users who are involved in status log
    $this->db->select('DISTINCT(sl.update_by), u.fullname');
    $this->db->from('tbl_status_log sl');
    $this->db->join('tbl_account_details u', 'u.user_id = sl.update_by', 'left');
    $data['associated_users'] = $this->db->get()->result();

    $data['all_statuses'] = $this->db->get('tbl_lead_status')->result();

    // ✅ Pass to view
    $data['sub_status'] = $sub_status;
    $data['user_id_filter'] = $user_id_filter;

    $this->db->select('ls.lead_status, COUNT(*) as total');
$this->db->from('tbl_status_log sl');
$this->db->join('tbl_lead_status ls', 'ls.lead_status_id = sl.status', 'left');

if (!$is_team_leader && !$is_regional_manager && !$is_admin) {
    $this->db->where('sl.update_by', $user_id);
} elseif (!empty($user_id_filter)) {
    $this->db->where('sl.update_by', $user_id_filter);
}
if (!empty($status_date)) {
    $this->db->where('DATE(sl.createdate)', $status_date);
}

$this->db->group_by('sl.status');
$status_counts_raw = $this->db->get()->result();

// Format result into array for easy access in view
$status_counts = [];
foreach ($status_counts_raw as $row) {
    $status_counts[$row->lead_status] = $row->total;
}
$data['status_counts'] = $status_counts;
//print_r($status_counts);



    $data['subview'] = $this->load->view('admin/leads/lead_status_log', $data, TRUE);
    $this->load->view('admin/_layout_main', $data);
}




public function statusLogList()
{
    $limit  = $_POST['length'];
    $start  = $_POST['start'];

    $sub_status = $_POST['sub_status'];
    $status_date = $_POST['status_date'];
    $user_id_filter = $_POST['user_id'];

    $user_id = $this->session->userdata('user_id');
    $user_type = $this->session->userdata('user_type');

    $this->db->where('user_id', $user_id);
    $current_user = $this->db->get('tbl_account_details')->row();

    $is_team_leader = !empty($current_user) && $current_user->team_leader == 1;
    $is_regional_manager = !empty($current_user) && $current_user->regional_manager == 1;
    $is_admin = $user_type == 1;

    // MAIN QUERY
    $this->db->select('
        sl.*, 
        l.leads_id, 
        l.phone, 
        l.contact_name, 
        l.created_time, 
        u.fullname as updated_by_name, 
        ls.lead_status as status_name
    ');
    $this->db->from('tbl_status_log sl');
    $this->db->join('tbl_leads l', 'l.leads_id = sl.lead_id', 'left');
    $this->db->join('tbl_account_details u', 'u.user_id = sl.update_by', 'left');
    $this->db->join('tbl_lead_status ls', 'ls.lead_status_id = sl.status', 'left');

    // permissions
    if (!$is_team_leader && !$is_regional_manager && !$is_admin) {
        $this->db->where('sl.update_by', $user_id);
    } elseif (!empty($user_id_filter)) {
        $this->db->where('sl.update_by', $user_id_filter);
    }

    if (!empty($sub_status)) {
        $this->db->where('sl.status', $sub_status);
    }

    if (!empty($status_date)) {
        $this->db->where('DATE(sl.createdate)', $status_date);
    }

    // count before limit
    $total = $this->db->count_all_results('', false);

    // pagination
    $this->db->limit($limit, $start);
    $this->db->order_by('sl.createdate', 'DESC');

    $query = $this->db->get()->result();

    $data = [];
    $i = $start + 1;

    foreach ($query as $log) {

        $row = [];

        $row[] = $i++;
        $row[] = '<a href="'.base_url('admin/leads/leads_details/'.$log->leads_id).'">'
                    .($log->contact_name ?? 'N/A').' ('.($log->phone ?? 'N/A').')
                 </a>';

        $row[] = !empty($log->created_time) ? date('d M Y H:i A', strtotime($log->created_time)) : 'N/A';

        $row[] = $log->status_name ?? 'N/A';
        $row[] = $log->updated_by_name ?? 'N/A';

        $row[] = !empty($log->createdate) ? date('d M Y H:i A', strtotime($log->createdate)) : 'N/A';

        $row[] = '<a href="'.base_url('admin/leads/leads_details/'.$log->leads_id).'" 
                    class="btn btn-primary btn-xs">
                    <i class="fa fa-pencil-square-o"></i>
                  </a>';

        $data[] = $row;
    }

    echo json_encode([
        "draw" => $_POST['draw'],
        "recordsTotal" => $total,
        "recordsFiltered" => $total,
        "data" => $data
    ]);
}




public function reminder_delete($id = null)
{
    if (!empty($id)) {
        $this->db->where('reminder_id', $id);
        $this->db->delete('tbl_reminders');

        $type = "success";
        $message = "Reminder deleted successfully!";
    } else {
        $type = "error";
        $message = "Invalid Reminder ID.";
    }

    set_message($type, $message);
    redirect('admin/leads/reminder_list');
}
    

    public function create($id = NULL)
    {
        $data['title'] = lang('all_leads');
        if (!empty($id)) {
            if ($id == 'kanban') {
                $data['active'] = 1;
                $k_session['leads_kanban'] = $id;
                $this->session->set_userdata($k_session);
            } elseif ($id == 'list') {
                $data['active'] = 1;
                $this->session->unset_userdata('leads_kanban');
                redirect('admin/leads');
            } elseif ($id == 'by_status') {
                $data['active'] = 1;
                $lead_status_id = $this->uri->segment(5);
                if ($lead_status_id == 'all') {
                    redirect('admin/leads');
                } else {
                    $search = true;
                    $by_status = $this->items_model->get_leads('by_status', $lead_status_id);
                }
                $this->session->unset_userdata('leads_kanban');
            } elseif ($id == 'by_source') {
                $data['active'] = 1;
                $lead_source_id = $this->uri->segment(5);
                if ($lead_source_id == 'all') {
                    redirect('admin/leads');
                } else {
                    $search = true;
                    $by_status = $this->items_model->get_leads('by_source', $lead_source_id);
                }
                $this->session->unset_userdata('leads_kanban');
            } else {

                $can_edit = $this->items_model->can_action('tbl_leads', 'edit', array('leads_id' => $id));
                if (!empty($can_edit)) {
                    $data['leads_info'] = $this->items_model->check_by(array('leads_id' => $id), 'tbl_leads');
                }
                $this->session->unset_userdata('leads_kanban');
            }
        }
        $data['active'] = 2;
        // get all leads status
        $status_info = $this->db->order_by('order_no', 'ASC')->get('tbl_lead_status')->result();
        if (!empty($status_info)) {
            foreach ($status_info as $v_status) {
                $data['status_info'][$v_status->lead_type][] = $v_status;
            }
        }
        $data['languages'] = $this->db->where('active', 1)->order_by('name', 'ASC')->get('tbl_languages')->result();

        $data['assign_user'] = $this->items_model->allowed_user('55');

        if (!empty(staff())) {
            $data['showing_created'] = true;
        }


        $data['subview'] = $this->load->view('admin/leads/create_leads', $data, TRUE);
        $this->load->view('admin/_layout_main', $data); //page load
    }

    
   public function leadList($filterBy = null, $search_by = null)
{
    if ($this->input->is_ajax_request()) {
        $this->load->model('datatablesnew');

        // Define the base table and joins
        $this->datatablesnew->table = 'tbl_leads';
        $this->datatablesnew->join_table = ['tbl_lead_status', 'tbl_lead_source'];
        $this->datatablesnew->join_where = [
            'tbl_lead_status.lead_status_id=tbl_leads.lead_status_id',
            'tbl_lead_source.lead_source_id=tbl_leads.lead_source_id'
        ];

        // Setup column order/search
        $custom_field = custom_form_table_search(5);
        $main_column = [
            'lead_name', 'contact_name', 'email', 'phone', 'lead_source', 'tags',
            'lead_status', 'permission', 'budget_from', 'budget_to',
            'lead_followup_date', 'city', 'is_duplicate', 'sub_status', 'created_time'
        ];
        $action_array = ['leads_id'];
        $result = array_merge($main_column, $custom_field, $action_array);
        $this->datatablesnew->column_order = $result;
        $this->datatablesnew->column_search = $result;

        // Default filter
        $where = ['converted_client_id' => 0];

              $lead_status_new = $this->input->post('lead_status_new');
               if (!empty($lead_status_new)) {
                $this->db->where('tbl_leads.lead_status_id', $lead_status_new);
                 
            }

        // Budget filters
        $budget_from = $this->input->post('budget_from');
        $budget_to = $this->input->post('budget_to');
  
		
		     
            if (!empty($budget_from)) {
                $this->db->where('tbl_leads.budget_from >=', $budget_from);
            }
            if (!empty($budget_to)) {
                $this->db->where('tbl_leads.budget_to <=', $budget_to);
            }
			
			
        $from_date = $this->input->post('from_date');
        $to_date = $this->input->post('to_date');

		if (!empty($from_date)) {
			$this->db->where('DATE(tbl_leads.created_time) >=', date('Y-m-d', strtotime($from_date)));
		}

		if (!empty($to_date)) {
			$this->db->where('DATE(tbl_leads.created_time) <=', date('Y-m-d', strtotime($to_date)));
		}


        $forward_from = $this->input->post('forward_from_date');
        $forward_to   = $this->input->post('forward_to_date');
      

            if (!empty($forward_from) && !empty($forward_to)) {
                // पहले subquery से हर lead की latest forwarded log निकालो
                $this->db->join("(SELECT lead_id, MAX(createdate) as latest_date 
                                FROM tbl_status_log 
                                WHERE status = 4 
                                GROUP BY lead_id) as latest_log", 
                                "latest_log.lead_id = tbl_leads.leads_id", 
                                "inner");
                
                $this->db->where('DATE(latest_log.latest_date) >=', date('Y-m-d', strtotime($forward_from)));
                $this->db->where('DATE(latest_log.latest_date) <=', date('Y-m-d', strtotime($forward_to)));
            }


        // User filter
        $selected_user = $this->input->post('user_id');
        if (!empty($selected_user)) {
            $this->db->like('permission', '"' . $selected_user . '"');
        }

        $sub_status = $this->input->post('sub_status');
            if (!empty($sub_status)) {
                $this->db->where('sub_status', $sub_status);
            }

        // Department filter
        $department_id = $this->input->post('department_id');
        if (!empty($department_id)) {
            $this->db->select('user_id');
            $this->db->from('tbl_account_details');
            $this->db->join('tbl_designations', 'tbl_designations.designations_id = tbl_account_details.designations_id');
            $this->db->where('tbl_designations.departments_id', $department_id);
            $user_result = $this->db->get()->result();

            if (!empty($user_result)) {
                $user_ids = array_column($user_result, 'user_id');
                $this->db->group_start();
                foreach ($user_ids as $user_id) {
                    $this->db->or_like('permission', '"' . $user_id . '"');
                }
                $this->db->group_end();
            } else {
                $this->db->where('1', 0); // No rows
            }
        }

        // Additional filters
        if (!empty($search_by)) {
            if ($search_by == 'by_status') {
                $where = ['tbl_leads.lead_status_id' => $filterBy];
            } elseif ($search_by == 'by_source') {
                $where = ['tbl_leads.lead_source_id' => $filterBy];
            } elseif ($search_by == 'by_assigned') {
                $this->db->like('permission', '"' . $filterBy . '"');
            }
        }
        
        else {
            if ($filterBy == 'assigned_to_me') {
                $where = $this->session->userdata('user_id');
            } elseif ($filterBy == 'everyone') {
                $where = ['permission' => 'all'];
            } elseif ($filterBy == 'converted') {
                $where = ['converted_client_id !=' => 0];
            } elseif ($filterBy == 'all') {
                $where = [];
            }
        }

       $logged_user_id = $this->session->userdata('user_id');
$is_admin = $this->session->userdata('user_type') == 1;
$designation_id     = $this->session->userdata('designations_id');
if ($is_admin || $designation_id == 3) {
  $this->db->order_by("tbl_leads.created_time", "DESC");
    
  

} else {
// join latest forward log
  $this->db->join(
        "(SELECT lead_id, MAX(createdate) as latest_forward_date 
          FROM tbl_status_log 
          WHERE status = 4 
          GROUP BY lead_id) as forward_log",
        "forward_log.lead_id = tbl_leads.leads_id",
        "left"
    );

    // today forwarded first
    $this->db->order_by("DATE(forward_log.latest_forward_date) = CURDATE()", "DESC");

    // then latest forwarded
    $this->db->order_by("forward_log.latest_forward_date", "DESC");

    // then latest leads
    $this->db->order_by("tbl_leads.created_time", "DESC");

}
        
        // Get data using model
        $response = $this->datatablesnew->get_datatable_permission($where);
        $fetch_data = $response['data'];
        $recordsTotal = $response['recordsTotal'];
        $recordsFiltered = $response['recordsFiltered'];

        // Build output data
        $data = [];
        $edited = can_action('55', 'edited');
        $deleted = can_action('55', 'deleted');
        $is_admin = $this->session->userdata('user_type') == 1; 
			
			$check_user_id = $this->session->userdata('user_id');
        $this->db->where('user_id', $check_user_id);
        $current_user = $this->db->get('tbl_account_details')->row();
        $is_regional_manager = !empty($current_user) && $current_user->regional_manager == 1;
        foreach ($fetch_data as $_key => $v_leads) {

                


            $sub_array = [];
            $can_edit = $this->items_model->can_action('tbl_leads', 'edit', ['leads_id' => $v_leads->leads_id]);
            $can_delete = $this->items_model->can_action('tbl_leads', 'delete', ['leads_id' => $v_leads->leads_id]);

