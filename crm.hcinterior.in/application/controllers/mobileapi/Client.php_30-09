<?php
error_reporting(E_ALL);
 ini_set('display_errors', 0);
 use Dompdf\Dompdf;
use Dompdf\Options;
/**
 * Description of client
 *
 * @author NaYeM
 */
require_once(APPPATH . 'third_party/elfinder/autoload.php');

class Client extends CI_Controller
{
    
    public function __construct()
    {
        parent::__construct();
		
		   header('Access-Control-Allow-Origin: *');
    header('Access-Control-Allow-Headers: Content-Type, Authorization, X-Requested-With');
    header('Access-Control-Allow-Methods: GET, POST, OPTIONS, PUT, DELETE');

    // Browser ke OPTIONS (Preflight) Request ko handle karne ke liye
    if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
        header('HTTP/1.1 200 OK');
        exit();
    }
	
	
        $this->load->model('client_model');
        $this->load->model('invoice_model');
        $this->load->model('estimates_model');
		 $this->load->model('proposal_model');
        $this->load->library('gst');
		

    }
    
	
	 
    public function clientList()
{
    header('Content-Type: application/json');
    $this->load->helper('api_helper');

    /*
    |--------------------------------------------------------------------------
    | VALIDATE TOKEN
    |--------------------------------------------------------------------------
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {
        echo json_encode([
            'status'  => false,
            'message' => 'Invalid API token'
        ]);
        return;
    }

    $user_id = (int)$user->user_id;


    /*
    |--------------------------------------------------------------------------
    | GET USER ROLE + DESIGNATION
    |--------------------------------------------------------------------------
    */

    $user_info = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_users')
        ->row();

    $account_details = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_account_details')
        ->row();


    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;

    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    |--------------------------------------------------------------------------
    | READ JSON / GET / POST
    |--------------------------------------------------------------------------
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }


    /*
    |--------------------------------------------------------------------------
    | FILTERS
    |--------------------------------------------------------------------------
    */

    $client_id = $json['client_id']
        ?? $this->input->get_post('client_id', true);

    $search = $json['search']
        ?? $this->input->get_post('search', true);

    $payment_filter = $json['payment_filter']
        ?? $this->input->get_post('payment_filter', true);

    $customer_group = $json['customer_group']
        ?? $this->input->get_post('customer_group', true);

    $page = $json['page']
        ?? $this->input->get_post('page', true)
        ?? 1;

    $limit = $json['limit']
        ?? $this->input->get_post('limit', true)
        ?? 20;


    /*
    |--------------------------------------------------------------------------
    | PAGINATION
    |--------------------------------------------------------------------------
    */

    $page = (
        is_numeric($page) &&
        (int)$page > 0
    ) ? (int)$page : 1;


    $limit = (
        is_numeric($limit) &&
        (int)$limit > 0
    ) ? (int)$limit : 20;


    if ($limit > 100) {
        $limit = 100;
    }


    $offset = ($page - 1) * $limit;


    /*
    |--------------------------------------------------------------------------
    | CLIENT VISIBILITY PERMISSION
    |--------------------------------------------------------------------------
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];


    $can_view_all_clients = (
        $user_type === 1 ||
        in_array(
            $designation_id,
            $all_client_designations,
            true
        )
    );


    /*
    |--------------------------------------------------------------------------
    | GET ASSIGNED CLIENT IDS FOR NORMAL USER
    |--------------------------------------------------------------------------
    */

    $assigned_client_ids = [];


    if (!$can_view_all_clients) {

        $assign_query = $this->db
            ->select('client_id')
            ->from('tbl_client_assign_team')
            ->where('user_id', $user_id)
            ->get();


        if (!$assign_query) {

            echo json_encode([
                'status'  => false,
                'message' => 'Assigned client query failed',
                'error'   => $this->db->error()
            ]);

            return;
        }


        foreach ($assign_query->result() as $row) {

            if (!empty($row->client_id)) {

                $assigned_client_ids[] =
                    (int)$row->client_id;
            }
        }


        $assigned_client_ids = array_values(
            array_unique(
                $assigned_client_ids
            )
        );
    }


    /*
    |--------------------------------------------------------------------------
    | COMMON CLIENT FILTER
    |--------------------------------------------------------------------------
    */

    $apply_client_filters = function () use (
        $can_view_all_clients,
        $assigned_client_ids,
        $client_id,
        $search,
        $customer_group
    ) {

        /*
        |--------------------------------------------------------------------------
        | NORMAL USER => ASSIGNED CLIENTS ONLY
        |--------------------------------------------------------------------------
        */

        if (!$can_view_all_clients) {

            if (!empty($assigned_client_ids)) {

                $this->db->where_in(
                    'c.client_id',
                    $assigned_client_ids
                );

            } else {

                /*
                | User has no assigned clients
                | => return nothing
                */

                $this->db->where(
                    'c.client_id',
                    0
                );
            }
        }


        /*
        |--------------------------------------------------------------------------
        | SPECIFIC CLIENT
        |--------------------------------------------------------------------------
        */

        if (
            $client_id !== '' &&
            $client_id !== null &&
            is_numeric($client_id) &&
            (int)$client_id > 0
        ) {

            $this->db->where(
                'c.client_id',
                (int)$client_id
            );
        }


        /*
        |--------------------------------------------------------------------------
        | SEARCH
        |--------------------------------------------------------------------------
        */

        if (!empty($search)) {

            $this->db->group_start();

            $this->db->like(
                'c.name',
                $search
            );

            $this->db->or_like(
                'c.client_sr_id',
                $search
            );

            $this->db->or_like(
                'c.mobile',
                $search
            );

            $this->db->or_like(
                'c.email',
                $search
            );

            $this->db->group_end();
        }


        /*
        |--------------------------------------------------------------------------
        | CUSTOMER GROUP
        |--------------------------------------------------------------------------
        */

        if (!empty($customer_group)) {

            $this->db->where(
                'c.customer_group',
                $customer_group
            );
        }
    };


    /*
    |--------------------------------------------------------------------------
    | TOTAL RECORDS
    |--------------------------------------------------------------------------
    |
    | NOTE:
    | Payment filter RED/GREEN is calculated later because payment percentage
    | depends on multiple tables.
    |--------------------------------------------------------------------------
    */

    $this->db
        ->from('tbl_client c');

    $apply_client_filters();


    $totalRecords =
        $this->db->count_all_results();


    /*
    |--------------------------------------------------------------------------
    | MAIN CLIENT QUERY
    |--------------------------------------------------------------------------
    */

    $this->db->select('
        c.*
    ');

    $this->db->from(
        'tbl_client c'
    );


    $apply_client_filters();


    /*
    |--------------------------------------------------------------------------
    | ORDER
    |--------------------------------------------------------------------------
    */

    $this->db->order_by(
        'c.client_id',
        'DESC'
    );


    /*
    |--------------------------------------------------------------------------
    | IMPORTANT
    |--------------------------------------------------------------------------
    |
    | If payment_filter is used, pagination is applied after calculating
    | RED/GREEN so matching clients are not skipped.
    |
    */

    if (empty($payment_filter)) {

        $this->db->limit(
            $limit,
            $offset
        );
    }


    $client_query =
        $this->db->get();


    if (!$client_query) {

        echo json_encode([
            'status'  => false,
            'message' => 'Client query failed',
            'error'   => $this->db->error()
        ]);

        return;
    }


    $clients =
        $client_query->result();


    /*
    |--------------------------------------------------------------------------
    | FINAL DATA
    |--------------------------------------------------------------------------
    */

    $data_output = [];


    foreach ($clients as $client) {

        /*
        |--------------------------------------------------------------------------
        | GET FREEZE BOQ / LATEST PROPOSAL
        |--------------------------------------------------------------------------
        |
        | IMPORTANT:
        | Apne proposal table ka actual naam yahan use karein.
        |
        | Agar aapke existing code me $latest_proposal pehle se kisi helper
        | ya dusri table se aa raha hai, to wahi existing query yahan rakhein.
        |--------------------------------------------------------------------------
        */

        $latest_proposal = null;

        /*
        | Example:
        |
        | $latest_proposal = $this->db
        |     ->where('client_id', $client->client_id)
        |     ->order_by('id', 'DESC')
        |     ->limit(1)
        |     ->get('YOUR_PROPOSAL_TABLE')
        |     ->row();
        |
        */


        /*
        |--------------------------------------------------------------------------
        | FREEZE BOQ AMOUNT
        |--------------------------------------------------------------------------
        |
        | Aapke existing variable ke according.
        |--------------------------------------------------------------------------
        */

        $freeze_boq_amount = 0;


        if (!empty($latest_proposal)) {

            $freeze_boq_amount =
                (float)$latest_proposal->totalToBePaid;
        }


        /*
        |--------------------------------------------------------------------------
        | PAYMENTS CALCULATION
        |--------------------------------------------------------------------------
        */

        $paidData = $this->db
            ->select_sum('paid_amount')
            ->where(
                'client_id',
                $client->client_id
            )
            ->get(
                'tbl_client_payment_record'
            )
            ->row();


        $total_paid = (
            !empty($paidData) &&
            $paidData->paid_amount > 0
        )
            ? $paidData->paid_amount
            : $client->amount_received;


        $total_paid = (float)(
            !empty($total_paid)
                ? $total_paid
                : 0
        );


        /*
        |--------------------------------------------------------------------------
        | PAYMENT PERCENTAGE
        |--------------------------------------------------------------------------
        */

        $payment_percentage =
            ($freeze_boq_amount > 0)
                ? min(
                    100,
                    round(
                        (
                            $total_paid /
                            $freeze_boq_amount
                        ) * 100,
                        2
                    )
                )
                : 0;


        /*
        |--------------------------------------------------------------------------
        | REQUIRED PAYMENT PERCENTAGE
        |--------------------------------------------------------------------------
        */

        $advanceStatus = (
            !empty($client->amount_received) &&
            $client->amount_received > 0
        )
            ? 'Done'
            : 'Pending';


        $designerStatus =
            $this->getTaskStatus_list(
                $client->client_id,
                'designer_site_visit_date'
            );


        $siteStartStatus =
            $this->getTaskStatus_list(
                $client->client_id,
                'site_start_date'
            );


        $validationStatus =
            $this->getTaskStatus_list(
                $client->client_id,
                'site_validation'
            );


        $dispatchStatus =
            $this->getTaskStatus_list(
                $client->client_id,
                'dispatch_date'
            );


        $plan = trim(
            $client->payment_plan ?? ''
        );


        $requiredPercent = 0;


        /*
        |--------------------------------------------------------------------------
        | PLAN 1 / PLAN 3
        |--------------------------------------------------------------------------
        */

        if (
            in_array(
                $plan,
                ['Plan 1', 'Plan 3']
            )
        ) {

            if ($advanceStatus == 'Done') {
                $requiredPercent = 10;
            }

            if ($designerStatus == 'Done') {
                $requiredPercent = 20;
            }

            if ($siteStartStatus == 'Done') {
                $requiredPercent = 40;
            }

            if ($validationStatus == 'Done') {
                $requiredPercent = 80;
            }

            if ($dispatchStatus == 'Done') {
                $requiredPercent = 100;
            }

        }

        /*
        |--------------------------------------------------------------------------
        | PLAN 2
        |--------------------------------------------------------------------------
        */

        elseif ($plan == 'Plan 2') {

            if ($advanceStatus == 'Done') {
                $requiredPercent = 10;
            }

            if ($designerStatus == 'Done') {
                $requiredPercent = 20;
            }

            if ($validationStatus == 'Done') {
                $requiredPercent = 60;
            }

            if ($dispatchStatus == 'Done') {
                $requiredPercent = 100;
            }
        }


        /*
        |--------------------------------------------------------------------------
        | PAYMENT ALERT
        |--------------------------------------------------------------------------
        */

        $payment_alert =
            ($payment_percentage > $requiredPercent)
                ? 'RED'
                : 'GREEN';


        /*
        |--------------------------------------------------------------------------
        | PAYMENT FILTER
        |--------------------------------------------------------------------------
        */

        if (!empty($payment_filter)) {

            if (
                strtolower($payment_filter) === 'red' &&
                $payment_alert !== 'RED'
            ) {
                continue;
            }


            if (
                strtolower($payment_filter) === 'green' &&
                $payment_alert !== 'GREEN'
            ) {
                continue;
            }
        }


        /*
        |--------------------------------------------------------------------------
        | ASSIGNED TEAM
        |--------------------------------------------------------------------------
        */

        $allowed_team_roles = [
            'Designer',
            'Project Manager',
            'Supervisor'
        ];


        $team_members = $this->db
            ->select(
                'member_profile, user_id'
            )
            ->where(
                'client_id',
                $client->client_id
            )
            ->where_in(
                'member_profile',
                $allowed_team_roles
            )
            ->get(
                'tbl_client_assign_team'
            )
            ->result();


        $assigned_team = [];


        foreach ($team_members as $member) {

            $u_info = $this->db
                ->select('fullname')
                ->where(
                    'user_id',
                    $member->user_id
                )
                ->get(
                    'tbl_account_details'
                )
                ->row();


            if ($u_info) {

                $assigned_team[] = [

                    'user_id' =>
                        (int)$member->user_id,

                    'role' =>
                        $member->member_profile,

                    'name' =>
                        $u_info->fullname
                ];
            }
        }


        /*
        |--------------------------------------------------------------------------
        | LATEST ESCALATION
        |--------------------------------------------------------------------------
        */

        $latest_escalation = $this->db
            ->where(
                'client_id',
                $client->client_id
            )
            ->order_by(
                'id',
                'DESC'
            )
            ->limit(1)
            ->get(
                'tbl_client_escalation'
            )
            ->row();


        $escalation_status =
            !empty($latest_escalation)
                ? $latest_escalation->status
                : 'None';


        /*
        |--------------------------------------------------------------------------
        | CURRENT PHASE
        |--------------------------------------------------------------------------
        */

        $design_finalization =
            $this->getTaskStatus_list(
                $client->client_id,
                'design_finalization'
            );


        $material_selection =
            $this->getTaskStatus_list(
                $client->client_id,
                'material_selection'
            );


        $wall_electrical =
            $this->getTaskStatus_list(
                $client->client_id,
                'wall_electrical_drawing'
            );


        $site_start =
            $this->getTaskStatus_list(
                $client->client_id,
                'site_start_date'
            );


        $dispatch =
            $this->getTaskStatus_list(
                $client->client_id,
                'dispatch_date'
            );


        /*
        |--------------------------------------------------------------------------
        | FINAL MODULAR DRAWING
        |--------------------------------------------------------------------------
        */

        $modularDrawing = $this->db
            ->where(
                'client_id',
                $client->client_id
            )
            ->where(
                'design_type',
                'Modular Design'
            )
            ->where(
                'is_final',
                1
            )
            ->where(
                'status',
                'Approved'
            )
            ->get(
                'tbl_client_two_d_design'
            )
            ->row();


        /*
        |--------------------------------------------------------------------------
        | VALIDATION
        |--------------------------------------------------------------------------
        */

        $validation = $this->db
            ->where(
                'client_id',
                $client->client_id
            )
            ->order_by(
                'id',
                'DESC'
            )
            ->limit(1)
            ->get(
                'tbl_client_validation_files'
            )
            ->row();


        $validation_status = (
            !empty($validation) &&
            !empty($validation->validation_checklist) &&
            !empty($validation->manual_correction_file)
        )
            ? 1
            : 0;


        /*
        |--------------------------------------------------------------------------
        | HANDOVER
        |--------------------------------------------------------------------------
        */

        $handover_status = (
            $this->db
                ->where(
                    'client_id',
                    $client->client_id
                )
                ->where(
                    'go_ahead',
                    'Done'
                )
                ->count_all_results(
                    'tbl_client'
                ) > 0
        )
            ? 1
            : 0;


        /*
        |--------------------------------------------------------------------------
        | TRACKER
        |--------------------------------------------------------------------------
        */

        $tracker = [

            'Civil Drawing' => (
                $this->db
                    ->where(
                        'client_id',
                        $client->client_id
                    )
                    ->count_all_results(
                        'tbl_client_two_d_design'
                    ) > 0
            ) ? 1 : 0,


            'Design Finalization' =>
                $design_finalization,


            'Material Selection' =>
                $material_selection,


            '3D' => (
                $this->db
                    ->where(
                        'client_id',
                        $client->client_id
                    )
                    ->where(
                        'request_type',
                        '3d Design'
                    )
                    ->count_all_results(
                        'tbl_client_service_request'
                    ) > 0
            ) ? 1 : 0,


            'Validation' =>
                $validation_status,


            'Wall Electrical' =>
                $wall_electrical,


            'Production File' =>
                !empty($modularDrawing)
                    ? 1
                    : 0,


            'Site Start' =>
                $site_start,


            'BOM' => (
                $this->db
                    ->where(
                        'client_id',
                        $client->client_id
                    )
                    ->where(
                        'request_type',
                        'bom'
                    )
                    ->count_all_results(
                        'tbl_client_service_request'
                    ) > 0
            ) ? 1 : 0,


            'Dispatch' =>
                $dispatch,


            'Handover' =>
                $handover_status
        ];


        /*
        |--------------------------------------------------------------------------
        | PHASE STRUCTURE
        |--------------------------------------------------------------------------
        */

        $phases = [

            1 => [
                'Civil Drawing',
                'Design Finalization',
                'Material Selection',
                '3D',
                'Validation',
                'Wall Electrical',
                'Production File'
            ],

            2 => [
                'Site Start'
            ],

            3 => [
                'BOM',
                'Dispatch'
            ],

            4 => [
                'Handover'
            ]
        ];


        /*
        |--------------------------------------------------------------------------
        | CALCULATE CURRENT PHASE
        |--------------------------------------------------------------------------
        */

        $currentPhase = 1;


        foreach ($phases as $phaseNo => $items) {

            $complete = true;


            foreach ($items as $item) {

                /*
                | getTaskStatus_list() returns Done/Pending
                | Other tracker fields return 1/0
                */

                $value = $tracker[$item];


                $itemComplete = (
                    $value === 1 ||
                    $value === '1' ||
                    $value === 'Done'
                );


                if (!$itemComplete) {

                    $complete = false;

                    $currentPhase =
                        $phaseNo;

                    break;
                }
            }


            if (!$complete) {
                break;
            }


            /*
            | All phases completed
            */

            $currentPhase = 4;
        }


        /*
        |--------------------------------------------------------------------------
        | OUTPUT
        |--------------------------------------------------------------------------
        */

        $data_output[] = [

            'client_id' =>
                (int)$client->client_id,

            'client_sr_id' =>
                $client->client_sr_id ?? '-',

            'name' =>
                !empty($client->name)
                    ? $client->name
                    : '-',

            'email' =>
                $client->email ?? '',

            'mobile' =>
                $client->mobile ?? '',

            'sales_person_name' =>
                $client->sales_person_name ?? '',

            'customer_group' =>
                $client->customer_group ?? '',

            'date_added' =>
                $client->date_added ?? null,

            'freeze_boq_amount' =>
                $freeze_boq_amount,

            'total_paid' =>
                $total_paid,

            'payment_percentage' =>
                $payment_percentage,

            'required_percentage' =>
                $requiredPercent,

            'payment_alert' =>
                $payment_alert,

            'handover_status' =>
                $client->hand_over_request_status ?? null,

            'handover_remark' =>
                $client->hand_over_remark ?? null,

            'handover_request_date' =>
                (
                    !empty(
                        $client->hand_over_request_date
                    ) &&
                    $client->hand_over_request_date !=
                    '0000-00-00'
                )
                    ? date(
                        'Y-m-d',
                        strtotime(
                            $client->hand_over_request_date
                        )
                    )
                    : null,

            'current_phase' =>
                $currentPhase,

            'escalation_status' =>
                $escalation_status,

            'assigned_team' =>
                $assigned_team
        ];
    }


    /*
    |--------------------------------------------------------------------------
    | PAYMENT FILTER PAGINATION
    |--------------------------------------------------------------------------
    */

    if (!empty($payment_filter)) {

        /*
        | Since payment filter happens after calculations,
        | paginate filtered result here.
        */

        $totalRecords =
            count($data_output);


        $data_output =
            array_slice(
                $data_output,
                $offset,
                $limit
            );
    }


    /*
    |--------------------------------------------------------------------------
    | TOTAL PAGES
    |--------------------------------------------------------------------------
    */

    $total_pages =
        $limit > 0
            ? (int)ceil(
                $totalRecords / $limit
            )
            : 0;


    /*
    |--------------------------------------------------------------------------
    | RESPONSE
    |--------------------------------------------------------------------------
    */

    echo json_encode([

        'status' =>
            true,

        'message' =>
            'Client list fetched successfully',

        'page' =>
            $page,

        'limit' =>
            $limit,

        'total' =>
            (int)$totalRecords,

        'total_pages' =>
            $total_pages,

        'has_next_page' =>
            $page < $total_pages,

        'has_previous_page' =>
            $page > 1,

        'data' =>
            $data_output
    ]);
}


/*
|--------------------------------------------------------------------------
| HELPER: TIMELINE STATUS
|--------------------------------------------------------------------------
*/

 
    /**
     * Helper for timeline status
     */
    private function getTaskStatus_list($client_id, $task_field)
    {
        $timeline = $this->db
            ->select($task_field)
            ->where('client_id', $client_id)
            ->order_by('id', 'DESC')
            ->limit(1)
            ->get('timeline_manual_dates')
            ->row();

        return (!empty($timeline) && !empty($timeline->$task_field)) ? 'Done' : 'Pending';
    }
    
    
    /**
     * API: Get Single Client Details with Phases & Workflow Tracker
     * Endpoint: POST client/clientDetail
     */
    public function clientDetail($client_id = null)
    {
        header('Content-Type: application/json');
        $this->load->helper('api_helper');

        // ✅ Validate Token
        $user = validate_api_token();

        // ✅ Get client_id from URL or JSON payload body
        if (empty($client_id)) {
            $json = file_get_contents('php://input');
            $data = json_decode($json, true);
            $client_id = $data['client_id'] ?? null;
        }

        if (empty($client_id) || !is_numeric($client_id)) {
            echo json_encode([
                'status'  => false,
                'message' => 'Client ID is required'
            ]);
            return;
        }

        // ✅ Fetch Client Details
        $client_details = $this->db->where('client_id', $client_id)->get('tbl_client')->row();
        if (!$client_details) {
            echo json_encode([
                'status'  => false,
                'message' => 'Client not found'
            ]);
            return;
        }

        // ✅ Get Latest Proposal Amount (Freeze BOQ)
        $latest_proposal = $this->db
            ->where('lead_id', $client_details->leads_id)
            ->order_by('id', 'DESC')
            ->limit(1)
            ->get('proposals')
            ->row();

        $total_amount = !empty($latest_proposal) ? (float)$latest_proposal->totalToBePaid : 0;

        // ✅ Get Paid Amount
        $paidData = $this->db
            ->select_sum('paid_amount')
            ->where('client_id', $client_details->client_id)
            ->get('tbl_client_payment_record')
            ->row();

        $total_paid = (!empty($paidData) && $paidData->paid_amount > 0) ? $paidData->paid_amount : $client_details->amount_received;
        $total_paid = (float)(!empty($total_paid) ? $total_paid : 0);

        // ✅ Task Status Helpers (Mirroring View Logic)
        $getTaskStatus = function($client_id, $task_name) {
            $row = $this->db
                ->select('status')
                ->where('client_id', $client_id)
                ->where('task_name', $task_name)
                ->get('timeline_task_status')
                ->row();
            return (!empty($row) && $row->status == 'Done') ? 1 : 0;
        };

        $getTaskStatusStr = function($client_id, $task_name) {
            $row = $this->db
                ->select('status')
                ->where('client_id', $client_id)
                ->where('task_name', $task_name)
                ->get('timeline_task_status')
                ->row();
            return $row->status ?? 'Pending';
        };

        // Task Checks
        $design_finalization     = $getTaskStatus($client_id, 'design_finalization');
        $material_selection      = $getTaskStatus($client_id, 'material_selection');
        $wall_electrical_drawing = $getTaskStatus($client_id, 'wall_electrical_drawing');
        $site_start_date         = $getTaskStatus($client_id, 'site_start_date');
        $dispatch_date           = $getTaskStatus($client_id, 'dispatch_date');

        $advanceStatus   = (!empty($client_details->amount_received) && $client_details->amount_received > 0) ? 'Done' : 'Pending';
        $designerStatus  = $getTaskStatusStr($client_id, 'designer_site_visit_date');
        $siteStartStatus = $getTaskStatusStr($client_id, 'site_start_date');
        $validationStatus= $getTaskStatusStr($client_id, 'site_validation');
        $dispatchStatus  = $getTaskStatusStr($client_id, 'dispatch_date');

        // Modular Drawing Check
        $modularDrawing = $this->db
            ->select('id')
            ->where('client_id', $client_id)
            ->where('design_type', 'Modular Design')
            ->where('is_final', 1)
            ->where('status', 'Approved')
            ->order_by('id', 'DESC')
            ->limit(1)
            ->get('tbl_client_two_d_design')
            ->row();

        // Validation Checklist Check
        $validation_checklist = $this->db
            ->where('client_id', $client_id)
            ->order_by('id', 'DESC')
            ->limit(1)
            ->get('tbl_client_validation_files')
            ->row();

        $validation_status = (!empty($validation_checklist) && !empty($validation_checklist->validation_checklist) && !empty($validation_checklist->manual_correction_file)) ? 1 : 0;

        // Handover Check
        $handover = $this->db
            ->where('client_id', $client_id)
            ->order_by('client_id', 'DESC')
            ->where('go_ahead', 'Done')
            ->limit(1)
            ->get('tbl_client')
            ->row();
        $handover_status = (!empty($handover)) ? 1 : 0;

        // ✅ Workflow Tracker Array
        $tracker = [
            'Design Finalization' => $design_finalization,
            'Material Selection'  => $material_selection,
            'Wall Electrical'     => $wall_electrical_drawing,
            'Site Start'          => $site_start_date,
            'Production File'     => !empty($modularDrawing) ? 1 : 0,
            'Civil Drawing'       => $this->db->where('client_id', $client_id)->count_all_results('tbl_client_two_d_design') > 0 ? 1 : 0,
            '3D'                  => $this->db->where('client_id', $client_id)->where('request_type', '3d Design')->count_all_results('tbl_client_service_request') > 0 ? 1 : 0,
            'Validation'          => $validation_status,
            'BOM'                 => $this->db->where('client_id', $client_id)->where('request_type', 'bom')->count_all_results('tbl_client_service_request') > 0 ? 1 : 0,
            'Ready for Dispatch'  => $this->db->where('client_id', $client_id)->where('request_type', 'dispatch')->count_all_results('tbl_client_service_request') > 0 ? 1 : 0,
            'KT Request'          => $this->db->where('client_id', $client_id)->where('request_type', 'KT1')->where('request_done', 'Done')->count_all_results('tbl_client_service_request') > 0 ? 1 : 0,
            'Dispatch'            => $dispatch_date,
            'Handover'            => $handover_status,
        ];

        // ✅ Phases Setup (Matching View Logic)
        $phasesDef = [
            1 => [
                'subtitle' => 'Phase 1',
                'items' => ['Civil Drawing', 'Design Finalization', 'Material Selection', '3D', 'Validation', 'Wall Electrical', 'Production File']
            ],
            2 => [
                'subtitle' => 'Phase 2',
                'items' => ['Site Start', 'Validation', 'Ready for Dispatch', 'KT Request']
            ],
            3 => [
                'subtitle' => 'Phase 3',
                'items' => ['BOM', 'Dispatch']
            ],
            4 => [
                'subtitle' => 'Phase 4',
                'items' => ['Dispatch', 'Handover']
            ]
        ];

        // Calculate Current Active Phase
        $currentPhaseCalc = 1;
        foreach ($phasesDef as $phaseNo => $phaseInfo) {
            $complete = true;
            foreach ($phaseInfo['items'] as $item) {
                if (empty($tracker[$item])) {
                    $complete = false;
                    $currentPhaseCalc = $phaseNo;
                    break;
                }
            }
            if (!$complete) {
                break;
            }
            $currentPhaseCalc = 4;
        }

        // Build Phases Structured Output for App
        $phases_output = [];
        foreach ($phasesDef as $phaseNo => $phaseInfo) {
            $phaseComplete = true;
            $items_status = [];

            foreach ($phaseInfo['items'] as $item) {
                $isDone = !empty($tracker[$item]) ? true : false;
                if (!$isDone) $phaseComplete = false;
                
                $items_status[] = [
                    'name'   => $item,
                    'status' => $isDone ? 'Done' : 'Pending'
                ];
            }

            $phaseStatusStr = 'Pending';
            if ($phaseComplete) {
                $phaseStatusStr = 'Completed';
            } elseif ($currentPhaseCalc == $phaseNo) {
                $phaseStatusStr = 'In Progress';
            }

            $phases_output[] = [
                'phase_number' => $phaseNo,
                'title'        => $phaseInfo['subtitle'],
                'status'       => $phaseStatusStr,
                'items'        => $items_status
            ];
        }

        // Progress Percentage Calculation
        $total_tracker_items = count($tracker);
        $done_tracker_items = count(array_filter($tracker));
        $progress_percentage = $total_tracker_items > 0 ? round(($done_tracker_items / $total_tracker_items) * 100) : 0;

        // ✅ Payment Plan Milestones Setup
        $plan = trim($client_details->payment_plan);
        $milestones = [];
        if (in_array($plan, ['Plan 1', 'Plan 3'])) {
            $milestones = [
                ['title' => 'Advance', 'percent' => 10, 'status' => $advanceStatus],
                ['title' => 'Designer Site Visit', 'percent' => 10, 'status' => $designerStatus],
                ['title' => 'Before Site Start', 'percent' => 40, 'status' => $siteStartStatus],
                ['title' => 'Before Site Validation', 'percent' => 40, 'status' => $validationStatus],
                ['title' => 'Before Dispatch', 'percent' => 20, 'status' => $dispatchStatus],
            ];
        } elseif ($plan == 'Plan 2') {
            $milestones = [
                ['title' => 'Advance', 'percent' => 10, 'status' => $advanceStatus],
                ['title' => 'Designer Site Visit', 'percent' => 10, 'status' => $designerStatus],
                ['title' => 'Before Site Validation', 'percent' => 40, 'status' => $validationStatus],
                ['title' => 'Before Dispatch', 'percent' => 40, 'status' => $dispatchStatus],
            ];
        }

        $milestones_output = [];
        $boqAmount = (float)$total_amount;
        foreach ($milestones as $m) {
            $amt = ($boqAmount * $m['percent']) / 100;
            $milestones_output[] = [
                'stage'      => $m['title'],
                'percentage' => $m['percent'],
                'amount'     => $amt,
                'status'     => $m['status']
            ];
        }

        // ✅ Documents Parsing (Aadhaar, PAN, Payment Screenshot)
        $aadhaar_front_url = null;
        if (!empty($client_details->aadhaar_card_front)) {
            $af = json_decode($client_details->aadhaar_card_front);
            if (!empty($af->path)) $aadhaar_front_url = base_url($af->path);
        }

        $aadhaar_back_url = null;
        if (!empty($client_details->aadhaar_card_back)) {
            $ab = json_decode($client_details->aadhaar_card_back);
            if (!empty($ab->path)) $aadhaar_back_url = base_url($ab->path);
        }

        $pan_card_data = null;
        if (!empty($client_details->pan_card_file)) {
            $pan = json_decode($client_details->pan_card_file);
            $pan_card_data = [
                'is_image' => isset($pan->is_image) ? (int)$pan->is_image : 0,
                'url'      => !empty($pan->path) ? base_url($pan->path) : null
            ];
        }

        $payment_screenshot_url = null;
        if (!empty($client_details->payment_screenshot)) {
            $ps = json_decode($client_details->payment_screenshot);
            if (!empty($ps->path)) $payment_screenshot_url = base_url($ps->path);
        }

        // ✅ Final Response Payload Structure
        $data_output = [
            'client_id'             => (int)$client_details->client_id,
            'client_sr_id'          => $client_details->client_sr_id,
            'name'                  => !empty($client_details->name) ? $client_details->name : '-',
            'email'                 => $client_details->email,
            'mobile'                => $client_details->mobile,
            'address'               => $client_details->address,
            'city'                  => $client_details->city,
            'site_address'          => $client_details->site_address,
            'site_city'             => $client_details->site_city,
            'site_zipcode'          => $client_details->site_zipcode,
            'client_hold'           => (int)$client_details->client_hold,
            'freeze_boq_amount'     => $total_amount,
            'wd_boq_amount'         => (float)$client_details->wd_boq_amount,
            'discount_modular'      => (float)$client_details->discount_modular,
            'discount_civil'        => (float)$client_details->discount_civil,
            'amount_received'       => $total_paid,
            'payment_mode'          => $client_details->payment_mode,
            'payment_plan'          => !empty($client_details->payment_plan) ? $client_details->payment_plan : 'Not Selected',
            'payment_screenshot'    => $payment_screenshot_url,
            'documents'             => [
                'aadhaar_front' => $aadhaar_front_url,
                'aadhaar_back'  => $aadhaar_back_url,
                'pan_card'      => $pan_card_data
            ],
            'sales_person'          => [
                'name'         => $client_details->sales_person_name,
                'phone'        => $client_details->sales_person_phone,
                'email'        => $client_details->sales_person_email,
                'manager_name' => $client_details->sales_manage_name
            ],
            'workflow'              => [
                'current_active_phase' => $currentPhaseCalc,
                'progress_percentage'  => $progress_percentage,
                'phases'               => $phases_output,
                'milestones'           => $milestones_output
            ]
        ];

        echo json_encode([
            'status'  => true,
            'message' => 'Client details fetched successfully',
            'data'    => $data_output
        ]);
    }
    
    
	
	 /**
 * API: Get QC Design List
 * Endpoint: POST client/qc_design
 *
 * Optional Payload:
 * {
 *     "client_id": 123,
 *     "design_style": "Pre Validation Design",
 *     "is_final": 1,
 *     "status": "Approved",
 *     "page": 1,
 *     "limit": 20
 * }
 */
	/**
 * API: Get QC Design List
 * Endpoint: POST client/qc_design
 *
 * Optional Payload:
 * {
 *     "client_id": 123,
 *     "design_style": "Pre Validation Design",
 *     "is_final": 1,
 *     "status": "Approved",
 *     "page": 1,
 *     "limit": 20
 * }
 */
public function qc_design()
{
    header('Content-Type: application/json');

    $this->load->helper('api_helper');


    /*
    |--------------------------------------------------------------------------
    | 1. VALIDATE API TOKEN
    |--------------------------------------------------------------------------
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Invalid API token'
        ]);

        return;
    }

    $user_id = (int)$user->user_id;


    /*
    |--------------------------------------------------------------------------
    | 2. GET USER ROLE & DESIGNATION
    |--------------------------------------------------------------------------
    */

    $user_info = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_users')
        ->row();


    $account_details = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_account_details')
        ->row();


    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;


    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 3. READ INPUT
    |--------------------------------------------------------------------------
    | Supports JSON / GET / POST
    |--------------------------------------------------------------------------
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }


    /*
    | Client ID
    */

    $client_id = $json['client_id']
        ?? $this->input->get_post('client_id', true);


    /*
    | Design Style
    */

    $design_style = $json['design_style']
        ?? $this->input->get_post('design_style', true);


    /*
    | Is Final
    */

    $is_final = $json['is_final']
        ?? $this->input->get_post('is_final', true);


    /*
    | Status
    */

    $status = $json['status']
        ?? $this->input->get_post('status', true);


    /*
    | Pagination
    */

    $page = $json['page']
        ?? $this->input->get_post('page', true)
        ?? 1;


    $limit = $json['limit']
        ?? $this->input->get_post('limit', true)
        ?? 20;


    /*
    |--------------------------------------------------------------------------
    | 4. PAGINATION SETUP
    |--------------------------------------------------------------------------
    */

    $page = (
        is_numeric($page) &&
        $page > 0
    )
        ? (int)$page
        : 1;


    $limit = (
        is_numeric($limit) &&
        $limit > 0
    )
        ? (int)$limit
        : 20;


    /*
    | Maximum 100 records
    */

    if ($limit > 100) {
        $limit = 100;
    }


    $offset = ($page - 1) * $limit;


    /*
    |--------------------------------------------------------------------------
    | 5. USER VISIBILITY
    |--------------------------------------------------------------------------
    |
    | Admin:
    | role_id = 1
    |
    | OR Special Designations:
    | 45, 39, 76, 71, 72, 77, 128
    |
    | => ALL CLIENTS
    |
    | Other Users:
    | => Assigned Clients Only
    |
    |--------------------------------------------------------------------------
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];


    $can_view_all_clients = (
        $user_type === 1 ||
        in_array(
            $designation_id,
            $all_client_designations,
            true
        )
    );


    /*
    |--------------------------------------------------------------------------
    | 6. GET ASSIGNED CLIENTS
    |--------------------------------------------------------------------------
    */

    $assigned_client_ids = [];


    if (!$can_view_all_clients) {

        $assign_query = $this->db
            ->select('client_id')
            ->from('tbl_client_assign_team')
            ->where('user_id', $user_id)
            ->get();


        /*
        | Query Error
        */

        if (!$assign_query) {

            echo json_encode([
                'status'  => false,
                'message' => 'Assigned client query failed',
                'error'   => $this->db->error()
            ]);

            return;
        }


        $assign_team = $assign_query->result();


        if (!empty($assign_team)) {

            foreach ($assign_team as $row) {

                if (!empty($row->client_id)) {

                    $assigned_client_ids[] =
                        (int)$row->client_id;
                }
            }
        }


        /*
        | Remove Duplicate IDs
        */

        $assigned_client_ids = array_values(
            array_unique($assigned_client_ids)
        );
    }


    /*
    |--------------------------------------------------------------------------
    | 7. COMMON FILTER FUNCTION
    |--------------------------------------------------------------------------
    */

    $apply_filters = function () use (
        $can_view_all_clients,
        $assigned_client_ids,
        $client_id,
        $design_style,
        $is_final,
        $status
    ) {


        /*
        |--------------------------------------------------------------------------
        | MODULAR DESIGN ONLY
        |--------------------------------------------------------------------------
        */

        $this->db->where(
            'd.design_type',
            'Modular Design'
        );


        /*
        |--------------------------------------------------------------------------
        | CLIENT VISIBILITY
        |--------------------------------------------------------------------------
        */

        if (!$can_view_all_clients) {

            /*
            | Normal User
            | Assigned Clients Only
            */

            if (!empty($assigned_client_ids)) {

                $this->db->where_in(
                    'd.client_id',
                    $assigned_client_ids
                );

            } else {

                /*
                | No Assigned Clients
                | Force Empty Result
                */

                $this->db->where(
                    'd.client_id',
                    0
                );
            }
        }


        /*
        |--------------------------------------------------------------------------
        | SPECIFIC CLIENT FILTER
        |--------------------------------------------------------------------------
        |
        | client_id diya hai:
        | Sirf us client ka data
        |
        */

        if (
            $client_id !== '' &&
            $client_id !== null &&
            is_numeric($client_id) &&
            (int)$client_id > 0
        ) {

            $this->db->where(
                'd.client_id',
                (int)$client_id
            );
        }


        /*
        |--------------------------------------------------------------------------
        | DESIGN STYLE FILTER
        |--------------------------------------------------------------------------
        */

        if (!empty($design_style)) {

            $this->db->where(
                'd.design_style',
                $design_style
            );

        } else {

            /*
            | Default Design Styles
            */

            $this->db->where_in(
                'd.design_style',
                [
                    'Pre Validation Design',
                    'Post Validation Design'
                ]
            );
        }


        /*
        |--------------------------------------------------------------------------
        | IS FINAL FILTER
        |--------------------------------------------------------------------------
        */

        if (
            $is_final !== '' &&
            $is_final !== null &&
            $is_final !== 'All'
        ) {

            $this->db->where(
                'd.is_final',
                $is_final
            );
        }


        /*
        |--------------------------------------------------------------------------
        | STATUS FILTER
        |--------------------------------------------------------------------------
        */

        if (!empty($status)) {

            $this->db->where(
                'd.status',
                $status
            );
        }
    };


    /*
    |--------------------------------------------------------------------------
    | 8. TOTAL RECORD COUNT
    |--------------------------------------------------------------------------
    */

    $this->db
        ->from('tbl_client_two_d_design d');


    $apply_filters();


    $totalRecords = $this->db
        ->count_all_results();


    /*
    |--------------------------------------------------------------------------
    | 9. MAIN QC DESIGN QUERY
    |--------------------------------------------------------------------------
    */

    $this->db->select('
        d.id as design_id,
        d.client_id,
        d.design_type,
        d.design_style,
        d.is_final,
        d.status,
        d.remark,
        d.created_date,
        d.uploaded_by,
        d.upload_file,
        d.upload_url,
        a.fullname as uploaded_by_name,
        c.name as client_name,
        c.client_sr_id
    ');


    $this->db
        ->from('tbl_client_two_d_design d')
        ->join(
            'tbl_account_details a',
            'a.user_id = d.uploaded_by',
            'left'
        )
        ->join(
            'tbl_client c',
            'c.client_id = d.client_id',
            'left'
        );


    /*
    |--------------------------------------------------------------------------
    | 10. APPLY FILTERS
    |--------------------------------------------------------------------------
    */

    $apply_filters();


    /*
    |--------------------------------------------------------------------------
    | 11. ORDER & PAGINATION
    |--------------------------------------------------------------------------
    */

    $this->db->order_by(
        'd.id',
        'DESC'
    );


    $this->db->limit(
        $limit,
        $offset
    );


    /*
    |--------------------------------------------------------------------------
    | 12. EXECUTE QUERY
    |--------------------------------------------------------------------------
    */

    $query = $this->db->get();


    /*
    | SQL Error Handling
    */

    if (!$query) {

        echo json_encode([
            'status'  => false,
            'message' => 'QC Design query failed',
            'error'   => $this->db->error()
        ]);

        return;
    }


    $results = $query->result();


    /*
    |--------------------------------------------------------------------------
    | 13. FORMAT RESPONSE DATA
    |--------------------------------------------------------------------------
    */

    $data_output = [];


    /*
    |--------------------------------------------------------------------------
    | PUBLIC UPLOAD BASE URL
    |--------------------------------------------------------------------------
    |
    | fileName is appended to this URL.
    |
    | Example:
    |
    | fileName:
    | 1783409478_6a4cab464cf9e.pdf
    |
    | Result:
    | https://crm.hcinterior.in/uploads/1783409478_6a4cab464cf9e.pdf
    |
    |--------------------------------------------------------------------------
    */

    $upload_base_url = 'https://crm.hcinterior.in/uploads/';


    if (!empty($results)) {

        foreach ($results as $row) {


            /*
            |--------------------------------------------------------------------------
            | PROCESS UPLOAD FILE
            |--------------------------------------------------------------------------
            |
            | DB Example:
            |
            | [
            |   {
            |     "fileName": "1783409478_6a4cab464cf9e.pdf",
            |     "path": "uploads/1783409478_6a4cab464cf9e.pdf",
            |     "fullPath": "/home/crm.hcinterior.in/public_html/uploads/...",
            |     "size": 897.39,
            |     "is_image": 0
            |   }
            | ]
            |
            | IMPORTANT:
            | fullPath aur path ko ignore kar rahe hain.
            |
            | ONLY fileName use hoga.
            |
            |--------------------------------------------------------------------------
            */

            $upload_files = [];


            if (!empty($row->upload_file)) {

                $decoded_files = json_decode(
                    $row->upload_file,
                    true
                );


                if (is_array($decoded_files)) {

                    foreach ($decoded_files as $file) {


                        /*
                        | Check fileName
                        */

                        if (
                            is_array($file) &&
                            !empty($file['fileName'])
                        ) {


                            /*
                            | Get Safe File Name
                            */

                            $file_name = basename(
                                $file['fileName']
                            );


                            /*
                            | Generate Public URL
                            */

                            $upload_files[] =
                                $upload_base_url .
                                rawurlencode($file_name);
                        }
                    }
                }
            }


            /*
            |--------------------------------------------------------------------------
            | BUILD RESPONSE RECORD
            |--------------------------------------------------------------------------
            */

            $data_output[] = [


                /*
                | Design ID
                */

                'design_id' =>
                    (int)$row->design_id,


                /*
                | Client
                */

                'client_id' =>
                    (int)$row->client_id,


                'client_sr_id' =>
                    !empty($row->client_sr_id)
                        ? $row->client_sr_id
                        : '-',


                'client_name' =>
                    !empty($row->client_name)
                        ? $row->client_name
                        : '-',


                /*
                | Design
                */

                'design_type' =>
                    $row->design_type,


                'design_style' =>
                    $row->design_style,


                'is_final' =>
                    (int)$row->is_final,


                /*
                | Status
                */

                'status' =>
                    $row->status,


                /*
                | Remark
                */

                'remark' =>
                    !empty($row->remark)
                        ? $row->remark
                        : '',


                /*
                | Uploaded By
                */

                'uploaded_by' =>
                    (int)$row->uploaded_by,


                'uploaded_by_name' =>
                    !empty($row->uploaded_by_name)
                        ? $row->uploaded_by_name
                        : '-',


                /*
                | Created Date
                */

                'created_at' =>
                    $row->created_date,


                /*
                |--------------------------------------------------------------------------
                | UPLOAD FILE
                |--------------------------------------------------------------------------
                |
                | Public URLs generated from fileName
                |
                */

                'upload_file' =>
                    $upload_files,


                /*
                |--------------------------------------------------------------------------
                | UPLOAD URL
                |--------------------------------------------------------------------------
                |
                | Google Drive / External URL
                | Same as stored in DB
                |
                */

                'upload_url' =>
                    !empty($row->upload_url)
                        ? $row->upload_url
                        : ''
            ];
        }
    }


    /*
    |--------------------------------------------------------------------------
    | 14. PAGINATION
    |--------------------------------------------------------------------------
    */

    $total_pages = (
        $limit > 0
    )
        ? ceil($totalRecords / $limit)
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 15. FINAL RESPONSE
    |--------------------------------------------------------------------------
    */

    echo json_encode([

        /*
        | API Status
        */

        'status' =>
            true,


        'message' =>
            'QC Design list fetched successfully',


        /*
        |--------------------------------------------------------------------------
        | CURRENT FILTERS
        |--------------------------------------------------------------------------
        */

        'filters' => [

            'client_id' =>
                !empty($client_id)
                    ? (int)$client_id
                    : null,


            'design_style' =>
                !empty($design_style)
                    ? $design_style
                    : null,


            'is_final' =>
                ($is_final !== '' && $is_final !== null)
                    ? $is_final
                    : null,


            'status' =>
                !empty($status)
                    ? $status
                    : null
        ],


        /*
        |--------------------------------------------------------------------------
        | USER DEBUG
        |--------------------------------------------------------------------------
        | Production me baad me remove kar sakte ho.
        */

        'user_debug' => [

            'user_id' =>
                $user_id,


            'role_id' =>
                $user_type,


            'designation_id' =>
                $designation_id,


            'can_view_all_clients' =>
                $can_view_all_clients,


            'assigned_client_ids' =>
                $can_view_all_clients
                    ? []
                    : $assigned_client_ids
        ],


        /*
        |--------------------------------------------------------------------------
        | PAGINATION
        |--------------------------------------------------------------------------
        */

        'page' =>
            $page,


        'limit' =>
            $limit,


        'total' =>
            (int)$totalRecords,


        'total_pages' =>
            (int)$total_pages,


        'has_next_page' =>
            $page < $total_pages,


        'has_previous_page' =>
            $page > 1,


        /*
        |--------------------------------------------------------------------------
        | DATA
        |--------------------------------------------------------------------------
        */

        'data' =>
            $data_output
    ]);
}



/**
 * API: Get Loose Furniture Purchase List
 * Endpoint: POST client/loose_furniture_list
 *
 * Optional Payload:
 * {
 *     "client_id": 125,
 *     "status": "Approved",
 *     "start_date": "2026-08-01",
 *     "end_date": "2026-08-31",
 *     "page": 1,
 *     "limit": 20
 * }
 */
public function loose_furniture_list()
{
    header('Content-Type: application/json');

    $this->load->helper('api_helper');


    /*
    |--------------------------------------------------------------------------
    | 1. VALIDATE API TOKEN
    |--------------------------------------------------------------------------
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Invalid API token'
        ]);

        return;
    }

    $user_id = (int)$user->user_id;


    /*
    |--------------------------------------------------------------------------
    | 2. GET USER ROLE & DESIGNATION
    |--------------------------------------------------------------------------
    */

    $user_info = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_users')
        ->row();

    $account_details = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_account_details')
        ->row();


    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;

    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 3. READ INPUT
    |--------------------------------------------------------------------------
    | Supports JSON / GET / POST
    |--------------------------------------------------------------------------
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }


    $client_id = $json['client_id']
        ?? $this->input->get_post('client_id', true);

    $status = $json['status']
        ?? $this->input->get_post('status', true);

    $start_date = $json['start_date']
        ?? $this->input->get_post('start_date', true);

    $end_date = $json['end_date']
        ?? $this->input->get_post('end_date', true);

    $page = $json['page']
        ?? $this->input->get_post('page', true)
        ?? 1;

    $limit = $json['limit']
        ?? $this->input->get_post('limit', true)
        ?? 20;


    /*
    |--------------------------------------------------------------------------
    | 4. PAGINATION
    |--------------------------------------------------------------------------
    */

    $page = (
        is_numeric($page) &&
        (int)$page > 0
    )
        ? (int)$page
        : 1;


    $limit = (
        is_numeric($limit) &&
        (int)$limit > 0
    )
        ? (int)$limit
        : 20;


    /*
    | Maximum records per request
    */

    if ($limit > 100) {
        $limit = 100;
    }


    $offset = ($page - 1) * $limit;


    /*
    |--------------------------------------------------------------------------
    | 5. USER VISIBILITY
    |--------------------------------------------------------------------------
    |
    | Admin:
    | role_id = 1
    |
    | Special Designations:
    | 45, 39, 76, 71, 72, 77, 128
    |
    | Admin / Special Designations:
    | => ALL CLIENTS
    |
    | Normal User:
    | => ASSIGNED CLIENTS ONLY
    |
    |--------------------------------------------------------------------------
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];


    $can_view_all_clients = (
        $user_type === 1 ||
        in_array(
            $designation_id,
            $all_client_designations,
            true
        )
    );


    /*
    |--------------------------------------------------------------------------
    | 6. GET ASSIGNED CLIENTS
    |--------------------------------------------------------------------------
    */

    $assigned_client_ids = [];


    if (!$can_view_all_clients) {

        $assign_query = $this->db
            ->select('client_id')
            ->from('tbl_client_assign_team')
            ->where('user_id', $user_id)
            ->get();


        if (!$assign_query) {

            echo json_encode([
                'status'  => false,
                'message' => 'Assigned client query failed',
                'error'   => $this->db->error()
            ]);

            return;
        }


        $assign_team = $assign_query->result();


        if (!empty($assign_team)) {

            foreach ($assign_team as $row) {

                if (!empty($row->client_id)) {

                    $assigned_client_ids[] =
                        (int)$row->client_id;
                }
            }
        }


        /*
        | Remove duplicates
        */

        $assigned_client_ids = array_values(
            array_unique($assigned_client_ids)
        );
    }


    /*
    |--------------------------------------------------------------------------
    | 7. COMMON FILTER FUNCTION
    |--------------------------------------------------------------------------
    */

    $apply_filters = function () use (
        $can_view_all_clients,
        $assigned_client_ids,
        $client_id,
        $status,
        $start_date,
        $end_date
    ) {


        /*
        |--------------------------------------------------------------------------
        | CLIENT PERMISSION
        |--------------------------------------------------------------------------
        */

        if (!$can_view_all_clients) {

            if (!empty($assigned_client_ids)) {

                /*
                | Normal User:
                | Only Assigned Clients
                */

                $this->db->where_in(
                    'f.client_id',
                    $assigned_client_ids
                );

            } else {

                /*
                | No Client Assigned
                | Show Nothing
                */

                $this->db->where(
                    'f.client_id',
                    0
                );
            }
        }


        /*
        |--------------------------------------------------------------------------
        | SPECIFIC CLIENT FILTER
        |--------------------------------------------------------------------------
        */

        if (
            $client_id !== '' &&
            $client_id !== null &&
            is_numeric($client_id) &&
            (int)$client_id > 0
        ) {

            $this->db->where(
                'f.client_id',
                (int)$client_id
            );
        }


        /*
        |--------------------------------------------------------------------------
        | STATUS FILTER
        |--------------------------------------------------------------------------
        */

        if (!empty($status)) {

            $this->db->where(
                'f.status',
                $status
            );
        }


        /*
        |--------------------------------------------------------------------------
        | DATE RANGE FILTER
        |--------------------------------------------------------------------------
        */

        if (
            !empty($start_date) &&
            !empty($end_date)
        ) {

            $this->db->where(
                'DATE(f.created_date) >=',
                $start_date
            );

            $this->db->where(
                'DATE(f.created_date) <=',
                $end_date
            );

        } elseif (!empty($start_date)) {

            $this->db->where(
                'DATE(f.created_date) >=',
                $start_date
            );

        } elseif (!empty($end_date)) {

            $this->db->where(
                'DATE(f.created_date) <=',
                $end_date
            );
        }
    };


    /*
    |--------------------------------------------------------------------------
    | 8. TOTAL RECORD COUNT
    |--------------------------------------------------------------------------
    */

    $this->db->from(
        'tbl_client_loose_furniture f'
    );


    $apply_filters();


    $totalRecords = $this->db
        ->count_all_results();


    /*
    |--------------------------------------------------------------------------
    | 9. MAIN QUERY
    |--------------------------------------------------------------------------
    */

    $this->db
        ->select('
            f.*,
            c.name as client_name,
            c.client_sr_id as client_sr_id
        ')
        ->from(
            'tbl_client_loose_furniture f'
        )
        ->join(
            'tbl_client c',
            'c.client_id = f.client_id',
            'left'
        );


    /*
    |--------------------------------------------------------------------------
    | 10. APPLY FILTERS
    |--------------------------------------------------------------------------
    */

    $apply_filters();


    /*
    |--------------------------------------------------------------------------
    | 11. ORDER + PAGINATION
    |--------------------------------------------------------------------------
    */

    $this->db->order_by(
        'f.id',
        'DESC'
    );


    $this->db->limit(
        $limit,
        $offset
    );


    /*
    |--------------------------------------------------------------------------
    | 12. EXECUTE QUERY
    |--------------------------------------------------------------------------
    */

    $query = $this->db->get();


    if (!$query) {

        echo json_encode([
            'status'  => false,
            'message' => 'Loose Furniture query failed',
            'error'   => $this->db->error()
        ]);

        return;
    }


    $results = $query->result();


    /*
    |--------------------------------------------------------------------------
    | 13. FORMAT RESPONSE
    |--------------------------------------------------------------------------
    */

    $data_output = [];


    /*
    |--------------------------------------------------------------------------
    | UPLOAD BASE URL
    |--------------------------------------------------------------------------
    */

    $upload_base_url =
        'https://crm.hcinterior.in/uploads/';


    if (!empty($results)) {

        foreach ($results as $row) {


            /*
            |--------------------------------------------------------------------------
            | CONVERT OBJECT TO ARRAY
            |--------------------------------------------------------------------------
            */

            $record = (array)$row;


            /*
            |--------------------------------------------------------------------------
            | FORMAT ID
            |--------------------------------------------------------------------------
            */

            if (isset($record['id'])) {

                $record['id'] =
                    (int)$record['id'];
            }


            /*
            |--------------------------------------------------------------------------
            | FORMAT CLIENT ID
            |--------------------------------------------------------------------------
            */

            if (isset($record['client_id'])) {

                $record['client_id'] =
                    (int)$record['client_id'];
            }


            /*
            |--------------------------------------------------------------------------
            | CLIENT DETAILS
            |--------------------------------------------------------------------------
            */

            $record['client_name'] =
                !empty($row->client_name)
                    ? $row->client_name
                    : '-';


            $record['client_sr_id'] =
                !empty($row->client_sr_id)
                    ? $row->client_sr_id
                    : '-';


            /*
            |--------------------------------------------------------------------------
            | PROCESS upload_file
            |--------------------------------------------------------------------------
            |
            | DB Value Example:
            |
            | [
            |   {
            |       "fileName": "chair.jpg",
            |       "path": "uploads/chair.jpg",
            |       "fullPath": "/home/crm.../uploads/chair.jpg",
            |       "ext": ".jpg",
            |       "size": 5.74,
            |       "is_image": 1
            |   }
            | ]
            |
            | API Output:
            |
            | "upload_file": [
            |    "https://crm.hcinterior.in/uploads/chair.jpg"
            | ]
            |
            | ONLY fileName use hoga.
            |
            |--------------------------------------------------------------------------
            */

            $upload_files = [];


            if (
                isset($row->upload_file) &&
                !empty($row->upload_file)
            ) {

                /*
                | Decode stored JSON
                */

                $decoded_files = json_decode(
                    $row->upload_file,
                    true
                );


                /*
                |--------------------------------------------------------------------------
                | JSON ARRAY FORMAT
                |--------------------------------------------------------------------------
                */

                if (is_array($decoded_files)) {

                    foreach ($decoded_files as $file) {


                        /*
                        | Standard uploaded file format
                        */

                        if (
                            is_array($file) &&
                            !empty($file['fileName'])
                        ) {

                            /*
                            | ONLY fileName
                            */

                            $file_name = basename(
                                $file['fileName']
                            );


                            /*
                            | Generate Full Public URL
                            */

                            $upload_files[] =
                                $upload_base_url .
                                rawurlencode($file_name);
                        }


                        /*
                        | Fallback:
                        | Simple string array
                        */

                        elseif (
                            is_string($file) &&
                            trim($file) !== ''
                        ) {

                            $file_name = basename(
                                trim($file)
                            );


                            $upload_files[] =
                                $upload_base_url .
                                rawurlencode($file_name);
                        }
                    }
                }


                /*
                |--------------------------------------------------------------------------
                | FALLBACK: DIRECT FILE NAME
                |--------------------------------------------------------------------------
                |
                | If database contains:
                |
                | chair.jpg
                |
                |--------------------------------------------------------------------------
                */

                elseif (
                    is_string($row->upload_file) &&
                    trim($row->upload_file) !== ''
                ) {

                    $file_name = basename(
                        trim($row->upload_file)
                    );


                    $upload_files[] =
                        $upload_base_url .
                        rawurlencode($file_name);
                }
            }


            /*
            |--------------------------------------------------------------------------
            | REPLACE RAW upload_file
            |--------------------------------------------------------------------------
            */

            $record['upload_file'] =
                $upload_files;


            /*
            |--------------------------------------------------------------------------
            | ADD RECORD
            |--------------------------------------------------------------------------
            */

            $data_output[] =
                $record;
        }
    }


    /*
    |--------------------------------------------------------------------------
    | 14. PAGINATION INFO
    |--------------------------------------------------------------------------
    */

    $total_pages = (
        $limit > 0
    )
        ? (int)ceil(
            $totalRecords / $limit
        )
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 15. FINAL RESPONSE
    |--------------------------------------------------------------------------
    */

    echo json_encode([

        'status' =>
            true,


        'message' =>
            'Loose Furniture list fetched successfully',


        /*
        |--------------------------------------------------------------------------
        | FILTERS
        |--------------------------------------------------------------------------
        */

        'filters' => [

            'client_id' =>
                (
                    $client_id !== '' &&
                    $client_id !== null &&
                    is_numeric($client_id)
                )
                    ? (int)$client_id
                    : null,


            'status' =>
                !empty($status)
                    ? $status
                    : null,


            'start_date' =>
                !empty($start_date)
                    ? $start_date
                    : null,


            'end_date' =>
                !empty($end_date)
                    ? $end_date
                    : null
        ],


        /*
        |--------------------------------------------------------------------------
        | USER DEBUG
        |--------------------------------------------------------------------------
        | Production me remove kar sakte ho.
        |--------------------------------------------------------------------------
        */

        'user_debug' => [

            'user_id' =>
                $user_id,


            'role_id' =>
                $user_type,


            'designation_id' =>
                $designation_id,


            'can_view_all_clients' =>
                $can_view_all_clients,


            'assigned_client_ids' =>
                $can_view_all_clients
                    ? []
                    : $assigned_client_ids
        ],


        /*
        |--------------------------------------------------------------------------
        | PAGINATION
        |--------------------------------------------------------------------------
        */

        'page' =>
            $page,


        'limit' =>
            $limit,


        'total' =>
            (int)$totalRecords,


        'total_pages' =>
            $total_pages,


        'has_next_page' =>
            $page < $total_pages,


        'has_previous_page' =>
            $page > 1,


        /*
        |--------------------------------------------------------------------------
        | DATA
        |--------------------------------------------------------------------------
        */

        'data' =>
            $data_output
    ]);
}

/**
 * API: Get Escalation List
 * Endpoint: POST client/esclation
 *
 * Optional Payload:
 * {
 *     "client_id": 123,
 *     "status": "Open",
 *     "page": 1,
 *     "limit": 20
 * }
 */
 
 
 
//  * Optional Payload:
//  * {
//  *     "client_id": 123,
//  *     "status": "Open",
//  *     "page": 1,
//  *     "limit": 20
//  * }
 
	public function esclation()
	{
    header('Content-Type: application/json');

    $this->load->helper('api_helper');


    /*
    |--------------------------------------------------------------------------
    | 1. VALIDATE API TOKEN
    |--------------------------------------------------------------------------
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Invalid API token'
        ]);

        return;
    }

    $user_id = (int)$user->user_id;


    /*
    |--------------------------------------------------------------------------
    | 2. GET USER ROLE & DESIGNATION
    |--------------------------------------------------------------------------
    */

    $user_info = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_users')
        ->row();


    $account_details = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_account_details')
        ->row();


    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;


    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 3. READ INPUT
    |--------------------------------------------------------------------------
    | Supports JSON / GET / POST
    |--------------------------------------------------------------------------
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }


    /*
    | Specific Client
    */

    $client_id = $json['client_id']
        ?? $this->input->get_post('client_id', true);


    /*
    | Escalation Status
    */

    $status = $json['status']
        ?? $this->input->get_post('status', true);


    /*
    | Pagination
    */

    $page = $json['page']
        ?? $this->input->get_post('page', true)
        ?? 1;


    $limit = $json['limit']
        ?? $this->input->get_post('limit', true)
        ?? 20;


    /*
    |--------------------------------------------------------------------------
    | 4. PAGINATION SETUP
    |--------------------------------------------------------------------------
    */

    $page = (
        is_numeric($page) &&
        $page > 0
    )
        ? (int)$page
        : 1;


    $limit = (
        is_numeric($limit) &&
        $limit > 0
    )
        ? (int)$limit
        : 20;


    /*
    | Maximum 100 records per page
    */

    if ($limit > 100) {
        $limit = 100;
    }


    $offset = ($page - 1) * $limit;


    /*
    |--------------------------------------------------------------------------
    | 5. USER VISIBILITY
    |--------------------------------------------------------------------------
    |
    | Admin:
    | role_id = 1
    |
    | Special Designations:
    | 45, 39, 76, 71, 72, 77, 128
    |
    | => ALL CLIENTS
    |
    | Other Users:
    | => Assigned Clients Only
    |
    |--------------------------------------------------------------------------
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];


    $can_view_all_clients = (
        $user_type === 1 ||
        in_array(
            $designation_id,
            $all_client_designations,
            true
        )
    );


    /*
    |--------------------------------------------------------------------------
    | 6. GET ASSIGNED CLIENTS FOR NORMAL USER
    |--------------------------------------------------------------------------
    */

    $assigned_client_ids = [];


    if (!$can_view_all_clients) {

        $assign_query = $this->db
            ->select('client_id')
            ->from('tbl_client_assign_team')
            ->where('user_id', $user_id)
            ->get();


        if (!$assign_query) {

            echo json_encode([
                'status'  => false,
                'message' => 'Assigned client query failed',
                'error'   => $this->db->error()
            ]);

            return;
        }


        $assign_team = $assign_query->result();


        if (!empty($assign_team)) {

            foreach ($assign_team as $row) {

                if (!empty($row->client_id)) {

                    $assigned_client_ids[] =
                        (int)$row->client_id;
                }
            }
        }


        /*
        | Remove duplicate client IDs
        */

        $assigned_client_ids = array_values(
            array_unique($assigned_client_ids)
        );
    }


    /*
    |--------------------------------------------------------------------------
    | 7. COMMON FILTER FUNCTION
    |--------------------------------------------------------------------------
    */

    $apply_filters = function () use (
        $can_view_all_clients,
        $assigned_client_ids,
        $client_id,
        $status
    ) {


        /*
        |--------------------------------------------------------------------------
        | CLIENT VISIBILITY
        |--------------------------------------------------------------------------
        */

        if (!$can_view_all_clients) {

            if (!empty($assigned_client_ids)) {

                $this->db->where_in(
                    'e.client_id',
                    $assigned_client_ids
                );

            } else {

                /*
                | No assigned client
                | Force empty result
                */

                $this->db->where(
                    'e.client_id',
                    0
                );
            }
        }


        /*
        |--------------------------------------------------------------------------
        | SPECIFIC CLIENT FILTER
        |--------------------------------------------------------------------------
        */

        if (
            $client_id !== '' &&
            $client_id !== null &&
            is_numeric($client_id) &&
            (int)$client_id > 0
        ) {

            $this->db->where(
                'e.client_id',
                (int)$client_id
            );
        }


        /*
        |--------------------------------------------------------------------------
        | STATUS FILTER
        |--------------------------------------------------------------------------
        */

        if (!empty($status)) {

            $this->db->where(
                'e.status',
                $status
            );
        }
    };


    /*
    |--------------------------------------------------------------------------
    | 8. GET TOTAL RECORD COUNT
    |--------------------------------------------------------------------------
    */

    $this->db
        ->from('tbl_client_escalation e');


    $apply_filters();


    $totalRecords = $this->db
        ->count_all_results();


    /*
    |--------------------------------------------------------------------------
    | 9. MAIN ESCALATION QUERY
    |--------------------------------------------------------------------------
    */

    $this->db->select('
        e.*,
        c.name as client_name,
        c.client_sr_id as client_sr_id,
        c.mobile as client_phone,
        r.fullname as raised_by_name,
        a.fullname as assigned_to_name
    ');


    $this->db
        ->from('tbl_client_escalation e')
        ->join(
            'tbl_client c',
            'c.client_id = e.client_id',
            'left'
        )
        ->join(
            'tbl_account_details r',
            'r.user_id = e.raised_by',
            'left'
        )
        ->join(
            'tbl_account_details a',
            'a.user_id = e.assigned_to',
            'left'
        );


    /*
    |--------------------------------------------------------------------------
    | 10. APPLY FILTERS
    |--------------------------------------------------------------------------
    */

    $apply_filters();


    /*
    |--------------------------------------------------------------------------
    | 11. ORDER & PAGINATION
    |--------------------------------------------------------------------------
    */

    $this->db->order_by(
        'e.id',
        'DESC'
    );


    $this->db->limit(
        $limit,
        $offset
    );


    /*
    |--------------------------------------------------------------------------
    | 12. EXECUTE ESCALATION QUERY
    |--------------------------------------------------------------------------
    */

    $query = $this->db->get();


    if (!$query) {

        echo json_encode([
            'status'  => false,
            'message' => 'Escalation query failed',
            'error'   => $this->db->error()
        ]);

        return;
    }


    $results = $query->result();


    /*
    |--------------------------------------------------------------------------
    | 13. FETCH COMMENTS FOR ALL ESCALATIONS
    |--------------------------------------------------------------------------
    |
    | Ek-ek escalation par separate query nahi chalayenge.
    |
    | Current page ke saare escalation IDs collect karke
    | comments ek hi query me fetch honge.
    |
    |--------------------------------------------------------------------------
    */

    $comments_by_escalation = [];


    if (!empty($results)) {

        $escalation_ids = [];


        foreach ($results as $row) {

            if (!empty($row->id)) {

                $escalation_ids[] =
                    (int)$row->id;
            }
        }


        /*
        | Remove duplicate IDs
        */

        $escalation_ids = array_values(
            array_unique($escalation_ids)
        );


        /*
        |--------------------------------------------------------------------------
        | COMMENTS QUERY
        |--------------------------------------------------------------------------
        */

        if (!empty($escalation_ids)) {

            $comments_query = $this->db
                ->select('
                    ec.id,
                    ec.escalation_id,
                    ec.user_id,
                    ec.comment,
                    ec.created_at,
                    ad.fullname as user_name
                ')
                ->from('tbl_client_escalation_comments ec')
                ->join(
                    'tbl_account_details ad',
                    'ad.user_id = ec.user_id',
                    'left'
                )
                ->where_in(
                    'ec.escalation_id',
                    $escalation_ids
                )
                ->order_by(
                    'ec.id',
                    'ASC'
                )
                ->get();


            /*
            | Comments Query Error
            */

            if (!$comments_query) {

                echo json_encode([
                    'status'  => false,
                    'message' => 'Escalation comments query failed',
                    'error'   => $this->db->error()
                ]);

                return;
            }


            $comment_results =
                $comments_query->result();


            /*
            |--------------------------------------------------------------------------
            | GROUP COMMENTS BY ESCALATION ID
            |--------------------------------------------------------------------------
            */

            if (!empty($comment_results)) {

                foreach ($comment_results as $comment) {

                    $escalation_id =
                        (int)$comment->escalation_id;


                    /*
                    | Create array if not exists
                    */

                    if (
                        !isset(
                            $comments_by_escalation[
                                $escalation_id
                            ]
                        )
                    ) {

                        $comments_by_escalation[
                            $escalation_id
                        ] = [];
                    }


                    /*
                    | Add Comment
                    */

                    $comments_by_escalation[
                        $escalation_id
                    ][] = [

                        'id' =>
                            (int)$comment->id,


                        'escalation_id' =>
                            $escalation_id,


                        'user_id' =>
                            (int)$comment->user_id,


                        'user_name' =>
                            !empty($comment->user_name)
                                ? $comment->user_name
                                : '-',


                        'comment' =>
                            $comment->comment,


                        'created_at' =>
                            $comment->created_at
                    ];
                }
            }
        }
    }


    /*
    |--------------------------------------------------------------------------
    | 14. FORMAT ESCALATION DATA
    |--------------------------------------------------------------------------
    */

    $data_output = [];


    if (!empty($results)) {

        foreach ($results as $row) {

            /*
            |--------------------------------------------------------------------------
            | CONVERT ESCALATION OBJECT TO ARRAY
            |--------------------------------------------------------------------------
            */

            $record = (array)$row;


            /*
            |--------------------------------------------------------------------------
            | FORMAT IDS
            |--------------------------------------------------------------------------
            */

            if (isset($record['id'])) {

                $record['id'] =
                    (int)$record['id'];
            }


            if (isset($record['client_id'])) {

                $record['client_id'] =
                    (int)$record['client_id'];
            }


            if (isset($record['raised_by'])) {

                $record['raised_by'] =
                    (int)$record['raised_by'];
            }


            if (isset($record['assigned_to'])) {

                $record['assigned_to'] =
                    (int)$record['assigned_to'];
            }


            /*
            |--------------------------------------------------------------------------
            | CLIENT DETAILS
            |--------------------------------------------------------------------------
            */

            $record['client_name'] =
                !empty($row->client_name)
                    ? $row->client_name
                    : '-';


            $record['client_sr_id'] =
                !empty($row->client_sr_id)
                    ? $row->client_sr_id
                    : '-';


            $record['client_phone'] =
                !empty($row->client_phone)
                    ? $row->client_phone
                    : '';


            /*
            |--------------------------------------------------------------------------
            | RAISED BY USER
            |--------------------------------------------------------------------------
            */

            $record['raised_by_name'] =
                !empty($row->raised_by_name)
                    ? $row->raised_by_name
                    : '-';


            /*
            |--------------------------------------------------------------------------
            | ASSIGNED TO USER
            |--------------------------------------------------------------------------
            */

            $record['assigned_to_name'] =
                !empty($row->assigned_to_name)
                    ? $row->assigned_to_name
                    : '-';


            /*
            |--------------------------------------------------------------------------
            | GET COMMENTS FOR THIS ESCALATION
            |--------------------------------------------------------------------------
            */

            $current_escalation_id =
                (int)$row->id;


            $comments = isset(
                $comments_by_escalation[
                    $current_escalation_id
                ]
            )
                ? $comments_by_escalation[
                    $current_escalation_id
                ]
                : [];


            /*
            |--------------------------------------------------------------------------
            | ADD COMMENTS
            |--------------------------------------------------------------------------
            */

            $record['comments'] =
                $comments;


            /*
            |--------------------------------------------------------------------------
            | TOTAL COMMENTS
            |--------------------------------------------------------------------------
            */

            $record['total_comments'] =
                count($comments);


            /*
            |--------------------------------------------------------------------------
            | ADD RECORD
            |--------------------------------------------------------------------------
            */

            $data_output[] =
                $record;
        }
    }


    /*
    |--------------------------------------------------------------------------
    | 15. PAGINATION
    |--------------------------------------------------------------------------
    */

    $total_pages = (
        $limit > 0
    )
        ? (int)ceil(
            $totalRecords / $limit
        )
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 16. FINAL RESPONSE
    |--------------------------------------------------------------------------
    */

    echo json_encode([

        /*
        | Status
        */

        'status' =>
            true,


        'message' =>
            'Escalation list fetched successfully',


        /*
        |--------------------------------------------------------------------------
        | FILTERS
        |--------------------------------------------------------------------------
        */

        'filters' => [

            'client_id' =>
                (
                    $client_id !== '' &&
                    $client_id !== null &&
                    is_numeric($client_id)
                )
                    ? (int)$client_id
                    : null,


            'status' =>
                !empty($status)
                    ? $status
                    : null
        ],


        /*
        |--------------------------------------------------------------------------
        | USER DEBUG
        |--------------------------------------------------------------------------
        | Production me remove kar sakte ho.
        */

        'user_debug' => [

            'user_id' =>
                $user_id,


            'role_id' =>
                $user_type,


            'designation_id' =>
                $designation_id,


            'can_view_all_clients' =>
                $can_view_all_clients,


            'assigned_client_ids' =>
                $can_view_all_clients
                    ? []
                    : $assigned_client_ids
        ],


        /*
        |--------------------------------------------------------------------------
        | PAGINATION
        |--------------------------------------------------------------------------
        */

        'page' =>
            $page,


        'limit' =>
            $limit,


        'total' =>
            (int)$totalRecords,


        'total_pages' =>
            $total_pages,


        'has_next_page' =>
            $page < $total_pages,


        'has_previous_page' =>
            $page > 1,


        /*
        |--------------------------------------------------------------------------
        | DATA
        |--------------------------------------------------------------------------
        */

        'data' =>
            $data_output
    ]);
	}
	
	
	/**
 * API: Save Escalation Reply
 * Endpoint: POST client/save_escalation_reply
 *
 * Payload:
 * {
 *     "escalation_id": 13,
 *     "comment": "Test Reply"
 * }
 */
public function save_escalation_reply()
{
    header('Content-Type: application/json');

    $this->load->helper('api_helper');


    /*
    |--------------------------------------------------------------------------
    | 1. VALIDATE API TOKEN
    |--------------------------------------------------------------------------
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Invalid API token'
        ]);

        return;
    }

    $user_id = (int)$user->user_id;


    /*
    |--------------------------------------------------------------------------
    | 2. READ INPUT
    |--------------------------------------------------------------------------
    | Supports JSON + normal POST
    |--------------------------------------------------------------------------
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }


    $escalation_id = $json['escalation_id']
        ?? $this->input->post('escalation_id', true);


    $comment = $json['comment']
        ?? $this->input->post('comment', true);


    /*
    |--------------------------------------------------------------------------
    | 3. VALIDATE ESCALATION ID
    |--------------------------------------------------------------------------
    */

    if (
        empty($escalation_id) ||
        !is_numeric($escalation_id) ||
        (int)$escalation_id <= 0
    ) {

        echo json_encode([
            'status'  => false,
            'message' => 'Valid escalation_id is required'
        ]);

        return;
    }

    $escalation_id = (int)$escalation_id;


    /*
    |--------------------------------------------------------------------------
    | 4. VALIDATE COMMENT
    |--------------------------------------------------------------------------
    */

    $comment = trim((string)$comment);

    if ($comment === '') {

        echo json_encode([
            'status'  => false,
            'message' => 'Comment is required'
        ]);

        return;
    }


    /*
    |--------------------------------------------------------------------------
    | 5. GET USER ROLE & DESIGNATION
    |--------------------------------------------------------------------------
    */

    $user_info = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_users')
        ->row();


    $account_details = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_account_details')
        ->row();


    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;


    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 6. CHECK ESCALATION EXISTS
    |--------------------------------------------------------------------------
    */

    $escalation = $this->db
        ->where('id', $escalation_id)
        ->get('tbl_client_escalation')
        ->row();


    if (empty($escalation)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Escalation not found'
        ]);

        return;
    }


    /*
    |--------------------------------------------------------------------------
    | 7. USER PERMISSION
    |--------------------------------------------------------------------------
    |
    | Admin / Special Designations:
    | Can access all clients
    |
    | Normal User:
    | Can reply only if escalation belongs to an assigned client
    |
    |--------------------------------------------------------------------------
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];


    $can_view_all_clients = (
        $user_type === 1 ||
        in_array(
            $designation_id,
            $all_client_designations,
            true
        )
    );


    /*
    |--------------------------------------------------------------------------
    | 8. CHECK CLIENT ASSIGNMENT FOR NORMAL USER
    |--------------------------------------------------------------------------
    */

    if (!$can_view_all_clients) {

        $client_assigned = $this->db
            ->where(
                'client_id',
                $escalation->client_id
            )
            ->where(
                'user_id',
                $user_id
            )
            ->get(
                'tbl_client_assign_team'
            )
            ->row();


        if (empty($client_assigned)) {

            echo json_encode([
                'status'  => false,
                'message' => 'You do not have permission to reply to this escalation'
            ]);

            return;
        }
    }


    /*
    |--------------------------------------------------------------------------
    | 9. START TRANSACTION
    |--------------------------------------------------------------------------
    */

    $this->db->trans_begin();


    /*
    |--------------------------------------------------------------------------
    | 10. INSERT COMMENT / REPLY
    |--------------------------------------------------------------------------
    */

    $comment_data = [

        'escalation_id' =>
            $escalation_id,

        'user_id' =>
            $user_id,

        'comment' =>
            $comment,

        'created_at' =>
            date('Y-m-d H:i:s')
    ];


    $insert = $this->db->insert(
        'tbl_client_escalation_comments',
        $comment_data
    );


    if (!$insert) {

        $error = $this->db->error();

        $this->db->trans_rollback();

        echo json_encode([
            'status'  => false,
            'message' => 'Failed to save escalation reply',
            'error'   => $error
        ]);

        return;
    }


    /*
    |--------------------------------------------------------------------------
    | GET COMMENT ID
    |--------------------------------------------------------------------------
    */

    $comment_id =
        (int)$this->db->insert_id();


    /*
    |--------------------------------------------------------------------------
    | 11. UPDATE ESCALATION STATUS
    |--------------------------------------------------------------------------
    */

    $update = $this->db
        ->where(
            'id',
            $escalation_id
        )
        ->update(
            'tbl_client_escalation',
            [
                'status' => 'Replied'
            ]
        );


    if (!$update) {

        $error = $this->db->error();

        $this->db->trans_rollback();

        echo json_encode([
            'status'  => false,
            'message' => 'Reply saved but escalation status update failed',
            'error'   => $error
        ]);

        return;
    }


    /*
    |--------------------------------------------------------------------------
    | 12. CHECK TRANSACTION
    |--------------------------------------------------------------------------
    */

    if ($this->db->trans_status() === false) {

        $this->db->trans_rollback();

        echo json_encode([
            'status'  => false,
            'message' => 'Failed to save escalation reply'
        ]);

        return;
    }


    $this->db->trans_commit();


    /*
    |--------------------------------------------------------------------------
    | 13. GET USER NAME
    |--------------------------------------------------------------------------
    */

    $reply_user = $this->db
        ->select('fullname')
        ->where(
            'user_id',
            $user_id
        )
        ->get(
            'tbl_account_details'
        )
        ->row();


    $user_name = !empty($reply_user->fullname)
        ? $reply_user->fullname
        : '-';


    /*
    |--------------------------------------------------------------------------
    | 14. SUCCESS RESPONSE
    |--------------------------------------------------------------------------
    */

    echo json_encode([

        'status' =>
            true,

        'message' =>
            'Escalation reply saved successfully',

        'data' => [

            'id' =>
                $comment_id,

            'escalation_id' =>
                $escalation_id,

            'user_id' =>
                $user_id,

            'user_name' =>
                $user_name,

            'comment' =>
                $comment,

            'escalation_status' =>
                'Replied',

            'created_at' =>
                $comment_data['created_at']
        ]
    ]);
}



/**
 * API: Get Final Validation Design List
 * Endpoint: POST client/final_validation_design
 *
 * Optional Payload:
 * {
 *     "client_id": 123,
 *     "design_style": "Post Validation Design",
 *     "status": "Approved",
 *     "page": 1,
 *     "limit": 20
 * }
 */
public function final_validation_design()
{
    header('Content-Type: application/json');

    $this->load->helper('api_helper');


    /*
    |--------------------------------------------------------------------------
    | 1. VALIDATE API TOKEN
    |--------------------------------------------------------------------------
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Invalid API token'
        ]);

        return;
    }

    $user_id = (int)$user->user_id;


    /*
    |--------------------------------------------------------------------------
    | 2. GET USER ROLE & DESIGNATION
    |--------------------------------------------------------------------------
    */

    $user_info = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_users')
        ->row();


    $account_details = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_account_details')
        ->row();


    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;


    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 3. READ INPUT
    |--------------------------------------------------------------------------
    | Supports JSON / GET / POST
    |--------------------------------------------------------------------------
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }


    /*
    | Client Filter
    */

    $client_id = $json['client_id']
        ?? $this->input->get_post('client_id', true);


    /*
    | Design Style Filter
    */

    $design_style = $json['design_style']
        ?? $this->input->get_post('design_style', true);


    /*
    | Status Filter
    */

    $status = $json['status']
        ?? $this->input->get_post('status', true);


    /*
    | Pagination
    */

    $page = $json['page']
        ?? $this->input->get_post('page', true)
        ?? 1;


    $limit = $json['limit']
        ?? $this->input->get_post('limit', true)
        ?? 20;


    /*
    |--------------------------------------------------------------------------
    | 4. PAGINATION SETUP
    |--------------------------------------------------------------------------
    */

    $page = (
        is_numeric($page) &&
        $page > 0
    )
        ? (int)$page
        : 1;


    $limit = (
        is_numeric($limit) &&
        $limit > 0
    )
        ? (int)$limit
        : 20;


    /*
    | Maximum 100 records per request
    */

    if ($limit > 100) {
        $limit = 100;
    }


    $offset = ($page - 1) * $limit;


    /*
    |--------------------------------------------------------------------------
    | 5. USER VISIBILITY
    |--------------------------------------------------------------------------
    |
    | Admin:
    | role_id = 1
    |
    | Special Designations:
    | 45, 39, 76, 71, 72, 77, 128
    |
    | => ALL CLIENTS
    |
    | Normal Users:
    | => Assigned Clients Only
    |--------------------------------------------------------------------------
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];


    $can_view_all_clients = (
        $user_type === 1 ||
        in_array(
            $designation_id,
            $all_client_designations,
            true
        )
    );


    /*
    |--------------------------------------------------------------------------
    | 6. GET ASSIGNED CLIENTS FOR NORMAL USER
    |--------------------------------------------------------------------------
    */

    $assigned_client_ids = [];


    if (!$can_view_all_clients) {

        $assign_query = $this->db
            ->select('client_id')
            ->from('tbl_client_assign_team')
            ->where('user_id', $user_id)
            ->get();


        if (!$assign_query) {

            echo json_encode([
                'status'  => false,
                'message' => 'Assigned client query failed',
                'error'   => $this->db->error()
            ]);

            return;
        }


        $assign_team = $assign_query->result();


        if (!empty($assign_team)) {

            foreach ($assign_team as $row) {

                if (!empty($row->client_id)) {

                    $assigned_client_ids[] =
                        (int)$row->client_id;
                }
            }
        }


        $assigned_client_ids = array_values(
            array_unique($assigned_client_ids)
        );
    }


    /*
    |--------------------------------------------------------------------------
    | 7. COMMON FILTER FUNCTION
    |--------------------------------------------------------------------------
    */

    $apply_filters = function () use (
        $can_view_all_clients,
        $assigned_client_ids,
        $client_id,
        $design_style,
        $status
    ) {


        /*
        |--------------------------------------------------------------------------
        | FINAL DESIGN ONLY
        |--------------------------------------------------------------------------
        */

        $this->db->where(
            'd.is_final',
            1
        );


        /*
        |--------------------------------------------------------------------------
        | MODULAR DESIGN ONLY
        |--------------------------------------------------------------------------
        */

        $this->db->where(
            'd.design_type',
            'Modular Design'
        );


        /*
        |--------------------------------------------------------------------------
        | CLIENT VISIBILITY
        |--------------------------------------------------------------------------
        */

        if (!$can_view_all_clients) {

            /*
            | Normal user:
            | Assigned clients only
            */

            if (!empty($assigned_client_ids)) {

                $this->db->where_in(
                    'd.client_id',
                    $assigned_client_ids
                );

            } else {

                /*
                | No assigned client
                | Force empty result
                */

                $this->db->where(
                    'd.client_id',
                    0
                );
            }
        }


        /*
        |--------------------------------------------------------------------------
        | SPECIFIC CLIENT FILTER
        |--------------------------------------------------------------------------
        |
        | client_id diya hai:
        | Sirf us client ka Final Validation Design
        |
        */

        if (
            $client_id !== '' &&
            $client_id !== null &&
            is_numeric($client_id) &&
            (int)$client_id > 0
        ) {

            $this->db->where(
                'd.client_id',
                (int)$client_id
            );
        }


        /*
        |--------------------------------------------------------------------------
        | DESIGN STYLE FILTER
        |--------------------------------------------------------------------------
        */

        if (!empty($design_style)) {

            $this->db->where(
                'd.design_style',
                $design_style
            );

        } else {

            /*
            | Same as existing function
            */

            $this->db->where_in(
                'd.design_style',
                [
                    'Pre Validation Design',
                    'Post Validation Design'
                ]
            );
        }


        /*
        |--------------------------------------------------------------------------
        | STATUS FILTER
        |--------------------------------------------------------------------------
        */

        if (!empty($status)) {

            $this->db->where(
                'd.status',
                $status
            );
        }
    };


    /*
    |--------------------------------------------------------------------------
    | 8. TOTAL RECORD COUNT
    |--------------------------------------------------------------------------
    */

    $this->db
        ->from('tbl_client_two_d_design d');


    $apply_filters();


    $totalRecords = $this->db
        ->count_all_results();


    /*
    |--------------------------------------------------------------------------
    | 9. MAIN FINAL VALIDATION DESIGN QUERY
    |--------------------------------------------------------------------------
    */

    $this->db->select('
        d.id as design_id,
        d.client_id,
        d.design_type,
        d.design_style,
        d.is_final,
        d.status,
        d.remark,
        d.created_date,
        d.uploaded_by,
        d.upload_file,
        d.upload_url,
        a.fullname as uploaded_by_name,
        c.name as client_name,
        c.client_sr_id
    ');


    $this->db
        ->from('tbl_client_two_d_design d')
        ->join(
            'tbl_account_details a',
            'a.user_id = d.uploaded_by',
            'left'
        )
        ->join(
            'tbl_client c',
            'c.client_id = d.client_id',
            'left'
        );


    /*
    |--------------------------------------------------------------------------
    | 10. APPLY FILTERS
    |--------------------------------------------------------------------------
    */

    $apply_filters();


    /*
    |--------------------------------------------------------------------------
    | 11. ORDER & PAGINATION
    |--------------------------------------------------------------------------
    */

    $this->db->order_by(
        'd.id',
        'DESC'
    );


    $this->db->limit(
        $limit,
        $offset
    );


    /*
    |--------------------------------------------------------------------------
    | 12. EXECUTE QUERY
    |--------------------------------------------------------------------------
    */

    $query = $this->db->get();


    if (!$query) {

        echo json_encode([
            'status'  => false,
            'message' => 'Final Validation Design query failed',
            'error'   => $this->db->error()
        ]);

        return;
    }


    $results = $query->result();


    /*
    |--------------------------------------------------------------------------
    | 13. FORMAT RESPONSE DATA
    |--------------------------------------------------------------------------
    */

    $data_output = [];


    /*
    |--------------------------------------------------------------------------
    | PUBLIC UPLOAD URL
    |--------------------------------------------------------------------------
    |
    | DB upload_file:
    |
    | [
    |   {
    |      "fileName": "1783409478_6a4cab464cf9e.pdf",
    |      ...
    |   }
    | ]
    |
    | API:
    |
    | https://crm.hcinterior.in/uploads/1783409478_6a4cab464cf9e.pdf
    |--------------------------------------------------------------------------
    */

    $upload_base_url =
        'https://crm.hcinterior.in/uploads/';


    if (!empty($results)) {

        foreach ($results as $row) {


            /*
            |--------------------------------------------------------------------------
            | PROCESS UPLOAD FILE
            |--------------------------------------------------------------------------
            |
            | IMPORTANT:
            | path / fullPath use nahi hoga.
            | ONLY fileName use hoga.
            |
            |--------------------------------------------------------------------------
            */

            $upload_files = [];


            if (!empty($row->upload_file)) {

                $decoded_files = json_decode(
                    $row->upload_file,
                    true
                );


                if (is_array($decoded_files)) {

                    foreach ($decoded_files as $file) {

                        if (
                            is_array($file) &&
                            !empty($file['fileName'])
                        ) {

                            $file_name = basename(
                                $file['fileName']
                            );


                            $upload_files[] =
                                $upload_base_url .
                                rawurlencode($file_name);
                        }
                    }
                }
            }


            /*
            |--------------------------------------------------------------------------
            | BUILD RESPONSE
            |--------------------------------------------------------------------------
            */

            $data_output[] = [

                'design_id' =>
                    (int)$row->design_id,


                'client_id' =>
                    (int)$row->client_id,


                'client_sr_id' =>
                    !empty($row->client_sr_id)
                        ? $row->client_sr_id
                        : '-',


                'client_name' =>
                    !empty($row->client_name)
                        ? $row->client_name
                        : '-',


                'design_type' =>
                    $row->design_type,


                'design_style' =>
                    $row->design_style,


                /*
                | Always 1 for this API
                */

                'is_final' =>
                    (int)$row->is_final,


                'status' =>
                    $row->status,


                'remark' =>
                    !empty($row->remark)
                        ? $row->remark
                        : '',


                'uploaded_by' =>
                    (int)$row->uploaded_by,


                'uploaded_by_name' =>
                    !empty($row->uploaded_by_name)
                        ? $row->uploaded_by_name
                        : '-',


                'created_at' =>
                    $row->created_date,


                /*
                |--------------------------------------------------------------------------
                | UPLOADED FILES
                |--------------------------------------------------------------------------
                */

                'upload_file' =>
                    $upload_files,


                /*
                |--------------------------------------------------------------------------
                | GOOGLE DRIVE / EXTERNAL URL
                |--------------------------------------------------------------------------
                */

                'upload_url' =>
                    !empty($row->upload_url)
                        ? $row->upload_url
                        : ''
            ];
        }
    }


    /*
    |--------------------------------------------------------------------------
    | 14. PAGINATION
    |--------------------------------------------------------------------------
    */

    $total_pages = (
        $limit > 0
    )
        ? (int)ceil(
            $totalRecords / $limit
        )
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 15. FINAL RESPONSE
    |--------------------------------------------------------------------------
    */

    echo json_encode([

        'status' =>
            true,


        'message' =>
            'Final Validation Design list fetched successfully',


        /*
        |--------------------------------------------------------------------------
        | FILTERS
        |--------------------------------------------------------------------------
        */

        'filters' => [

            'client_id' =>
                (
                    $client_id !== '' &&
                    $client_id !== null &&
                    is_numeric($client_id)
                )
                    ? (int)$client_id
                    : null,


            'design_style' =>
                !empty($design_style)
                    ? $design_style
                    : null,


            /*
            | This API always returns final designs
            */

            'is_final' =>
                1,


            'status' =>
                !empty($status)
                    ? $status
                    : null
        ],


        /*
        |--------------------------------------------------------------------------
        | USER DEBUG
        |--------------------------------------------------------------------------
        | Production me remove kar sakte ho.
        */

        'user_debug' => [

            'user_id' =>
                $user_id,


            'role_id' =>
                $user_type,


            'designation_id' =>
                $designation_id,


            'can_view_all_clients' =>
                $can_view_all_clients,


            'assigned_client_ids' =>
                $can_view_all_clients
                    ? []
                    : $assigned_client_ids
        ],


        /*
        |--------------------------------------------------------------------------
        | PAGINATION
        |--------------------------------------------------------------------------
        */

        'page' =>
            $page,


        'limit' =>
            $limit,


        'total' =>
            (int)$totalRecords,


        'total_pages' =>
            $total_pages,


        'has_next_page' =>
            $page < $total_pages,


        'has_previous_page' =>
            $page > 1,


        /*
        |--------------------------------------------------------------------------
        | DATA
        |--------------------------------------------------------------------------
        */

        'data' =>
            $data_output
    ]);
}


/**
 * API: Get MOM / Checklist List
 * Endpoint: POST client/mom_checklist
 *
 * Optional Payload:
 * {
 *     "client_id": 123,
 *     "status": "Approved",
 *     "start_date": "2026-08-01",
 *     "end_date": "2026-08-31",
 *     "page": 1,
 *     "limit": 20
 * }
 */
public function mom_checklist()
{
    header('Content-Type: application/json');

    $this->load->helper('api_helper');


    /*
    |--------------------------------------------------------------------------
    | 1. VALIDATE API TOKEN
    |--------------------------------------------------------------------------
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Invalid API token'
        ]);

        return;
    }

    $user_id = (int)$user->user_id;


    /*
    |--------------------------------------------------------------------------
    | 2. GET USER ROLE & DESIGNATION
    |--------------------------------------------------------------------------
    */

    $user_info = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_users')
        ->row();


    $account_details = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_account_details')
        ->row();


    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;


    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 3. READ INPUT
    |--------------------------------------------------------------------------
    | Supports:
    | JSON
    | POST
    | GET
    |--------------------------------------------------------------------------
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }


    /*
    | Client Filter
    */

    $client_id = $json['client_id']
        ?? $this->input->get_post('client_id', true);


    /*
    | Status Filter
    */

    $status = $json['status']
        ?? $this->input->get_post('status', true);


    /*
    | Start Date
    */

    $start_date = $json['start_date']
        ?? $this->input->get_post('start_date', true);


    /*
    | End Date
    */

    $end_date = $json['end_date']
        ?? $this->input->get_post('end_date', true);


    /*
    | Pagination
    */

    $page = $json['page']
        ?? $this->input->get_post('page', true)
        ?? 1;


    $limit = $json['limit']
        ?? $this->input->get_post('limit', true)
        ?? 20;


    /*
    |--------------------------------------------------------------------------
    | 4. PAGINATION SETUP
    |--------------------------------------------------------------------------
    */

    $page = (
        is_numeric($page) &&
        $page > 0
    )
        ? (int)$page
        : 1;


    $limit = (
        is_numeric($limit) &&
        $limit > 0
    )
        ? (int)$limit
        : 20;


    /*
    | Maximum 100 records per request
    */

    if ($limit > 100) {
        $limit = 100;
    }


    $offset = ($page - 1) * $limit;


    /*
    |--------------------------------------------------------------------------
    | 5. USER VISIBILITY
    |--------------------------------------------------------------------------
    |
    | Admin:
    | role_id = 1
    |
    | Special Designations:
    | 45, 39, 76, 71, 72, 77, 128
    |
    | => ALL CLIENTS
    |
    | Normal User:
    | => Assigned Clients Only
    |
    |--------------------------------------------------------------------------
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];


    $can_view_all_clients = (
        $user_type === 1 ||
        in_array(
            $designation_id,
            $all_client_designations,
            true
        )
    );


    /*
    |--------------------------------------------------------------------------
    | 6. GET ASSIGNED CLIENTS FOR NORMAL USER
    |--------------------------------------------------------------------------
    */

    $assigned_client_ids = [];


    if (!$can_view_all_clients) {

        $assign_query = $this->db
            ->select('client_id')
            ->from('tbl_client_assign_team')
            ->where('user_id', $user_id)
            ->get();


        /*
        | Assignment Query Error
        */

        if (!$assign_query) {

            echo json_encode([
                'status'  => false,
                'message' => 'Assigned client query failed',
                'error'   => $this->db->error()
            ]);

            return;
        }


        $assign_team = $assign_query->result();


        if (!empty($assign_team)) {

            foreach ($assign_team as $row) {

                if (!empty($row->client_id)) {

                    $assigned_client_ids[] =
                        (int)$row->client_id;
                }
            }
        }


        /*
        | Remove duplicate client IDs
        */

        $assigned_client_ids = array_values(
            array_unique($assigned_client_ids)
        );
    }


    /*
    |--------------------------------------------------------------------------
    | 7. COMMON FILTER FUNCTION
    |--------------------------------------------------------------------------
    */

    $apply_filters = function () use (
        $can_view_all_clients,
        $assigned_client_ids,
        $client_id,
        $status,
        $start_date,
        $end_date
    ) {


        /*
        |--------------------------------------------------------------------------
        | CLIENT VISIBILITY
        |--------------------------------------------------------------------------
        */

        if (!$can_view_all_clients) {

            /*
            | Normal user
            | Assigned clients only
            */

            if (!empty($assigned_client_ids)) {

                $this->db->where_in(
                    'm.client_id',
                    $assigned_client_ids
                );

            } else {

                /*
                | User has no assigned client
                | Force empty result
                */

                $this->db->where(
                    'm.client_id',
                    0
                );
            }
        }


        /*
        |--------------------------------------------------------------------------
        | SPECIFIC CLIENT FILTER
        |--------------------------------------------------------------------------
        |
        | client_id diya hai:
        | Sirf us client ka MOM data
        |
        | Normal user ke case me assignment restriction
        | bhi automatically apply rahegi.
        |
        */

        if (
            $client_id !== '' &&
            $client_id !== null &&
            is_numeric($client_id) &&
            (int)$client_id > 0
        ) {

            $this->db->where(
                'm.client_id',
                (int)$client_id
            );
        }


        /*
        |--------------------------------------------------------------------------
        | STATUS FILTER
        |--------------------------------------------------------------------------
        */

        if (!empty($status)) {

            $this->db->where(
                'm.status',
                $status
            );
        }


        /*
        |--------------------------------------------------------------------------
        | DATE RANGE FILTER
        |--------------------------------------------------------------------------
        */

        if (
            !empty($start_date) &&
            !empty($end_date)
        ) {

            $this->db->where(
                'DATE(m.created_date) >=',
                $start_date
            );

            $this->db->where(
                'DATE(m.created_date) <=',
                $end_date
            );

        } elseif (!empty($start_date)) {

            /*
            | Start Date Only
            */

            $this->db->where(
                'DATE(m.created_date) >=',
                $start_date
            );

        } elseif (!empty($end_date)) {

            /*
            | End Date Only
            */

            $this->db->where(
                'DATE(m.created_date) <=',
                $end_date
            );
        }
    };


    /*
    |--------------------------------------------------------------------------
    | 8. GET TOTAL RECORD COUNT
    |--------------------------------------------------------------------------
    */

    $this->db
        ->from('tbl_client_mom m');


    $apply_filters();


    $totalRecords = $this->db
        ->count_all_results();


    /*
    |--------------------------------------------------------------------------
    | 9. MAIN MOM / CHECKLIST QUERY
    |--------------------------------------------------------------------------
    */

    $this->db->select('
        m.*,
        c.name as client_name,
        c.client_sr_id as client_sr_id
    ');


    $this->db
        ->from('tbl_client_mom m')
        ->join(
            'tbl_client c',
            'c.client_id = m.client_id',
            'left'
        );


    /*
    |--------------------------------------------------------------------------
    | 10. APPLY FILTERS
    |--------------------------------------------------------------------------
    */

    $apply_filters();


    /*
    |--------------------------------------------------------------------------
    | 11. ORDER & PAGINATION
    |--------------------------------------------------------------------------
    */

    $this->db->order_by(
        'm.id',
        'DESC'
    );


    $this->db->limit(
        $limit,
        $offset
    );


    /*
    |--------------------------------------------------------------------------
    | 12. EXECUTE QUERY
    |--------------------------------------------------------------------------
    */

    $query = $this->db->get();


    if (!$query) {

        echo json_encode([
            'status'  => false,
            'message' => 'MOM / Checklist query failed',
            'error'   => $this->db->error()
        ]);

        return;
    }


    $results = $query->result();


    /*
    |--------------------------------------------------------------------------
    | 13. FORMAT RESPONSE DATA
    |--------------------------------------------------------------------------
    |
    | m.* return kar rahe hain because MOM table ke saare
    | existing columns API me available rahenge.
    |
    |--------------------------------------------------------------------------
    */

    $data_output = [];


    if (!empty($results)) {

        foreach ($results as $row) {

            /*
            | Convert object into array
            */

            $record = (array)$row;


            /*
            |--------------------------------------------------------------------------
            | FORMAT IDS
            |--------------------------------------------------------------------------
            */

            if (isset($record['id'])) {

                $record['id'] =
                    (int)$record['id'];
            }


            if (isset($record['client_id'])) {

                $record['client_id'] =
                    (int)$record['client_id'];
            }


            /*
            |--------------------------------------------------------------------------
            | CLIENT DETAILS
            |--------------------------------------------------------------------------
            */

            $record['client_name'] =
                !empty($row->client_name)
                    ? $row->client_name
                    : '-';


            $record['client_sr_id'] =
                !empty($row->client_sr_id)
                    ? $row->client_sr_id
                    : '-';


            /*
            |--------------------------------------------------------------------------
            | ADD RECORD
            |--------------------------------------------------------------------------
            */

            $data_output[] =
                $record;
        }
    }


    /*
    |--------------------------------------------------------------------------
    | 14. PAGINATION
    |--------------------------------------------------------------------------
    */

    $total_pages = (
        $limit > 0
    )
        ? (int)ceil(
            $totalRecords / $limit
        )
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 15. FINAL RESPONSE
    |--------------------------------------------------------------------------
    */

    echo json_encode([

        /*
        | API Status
        */

        'status' =>
            true,


        'message' =>
            'MOM / Checklist list fetched successfully',


        /*
        |--------------------------------------------------------------------------
        | APPLIED FILTERS
        |--------------------------------------------------------------------------
        */

        'filters' => [

            'client_id' =>
                (
                    $client_id !== '' &&
                    $client_id !== null &&
                    is_numeric($client_id)
                )
                    ? (int)$client_id
                    : null,


            'status' =>
                !empty($status)
                    ? $status
                    : null,


            'start_date' =>
                !empty($start_date)
                    ? $start_date
                    : null,


            'end_date' =>
                !empty($end_date)
                    ? $end_date
                    : null
        ],


        /*
        |--------------------------------------------------------------------------
        | USER DEBUG
        |--------------------------------------------------------------------------
        | Production me remove kar sakte ho.
        */

        'user_debug' => [

            'user_id' =>
                $user_id,


            'role_id' =>
                $user_type,


            'designation_id' =>
                $designation_id,


            'can_view_all_clients' =>
                $can_view_all_clients,


            'assigned_client_ids' =>
                $can_view_all_clients
                    ? []
                    : $assigned_client_ids
        ],


        /*
        |--------------------------------------------------------------------------
        | PAGINATION
        |--------------------------------------------------------------------------
        */

        'page' =>
            $page,


        'limit' =>
            $limit,


        'total' =>
            (int)$totalRecords,


        'total_pages' =>
            $total_pages,


        'has_next_page' =>
            $page < $total_pages,


        'has_previous_page' =>
            $page > 1,


        /*
        |--------------------------------------------------------------------------
        | MOM DATA
        |--------------------------------------------------------------------------
        */

        'data' =>
            $data_output
    ]);
}


/**
 * API: Get On Site Purchase Request List
