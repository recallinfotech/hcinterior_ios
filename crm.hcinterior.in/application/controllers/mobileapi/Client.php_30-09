    |--------------------------------------------------------------------------
    | 2. GET USER ROLE & DESIGNATION
    |--------------------------------------------------------------------------
    */

    $user_info = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_users')
        ->row();

    $account_details = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_account_details')
        ->row();


    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;

    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 3. READ INPUT
    |--------------------------------------------------------------------------
    | Supports JSON / GET / POST
    |--------------------------------------------------------------------------
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }


    $client_id = $json['client_id']
        ?? $this->input->get_post('client_id', true);

    $status = $json['status']
        ?? $this->input->get_post('status', true);

    $start_date = $json['start_date']
        ?? $this->input->get_post('start_date', true);

    $end_date = $json['end_date']
        ?? $this->input->get_post('end_date', true);

    $page = $json['page']
        ?? $this->input->get_post('page', true)
        ?? 1;

    $limit = $json['limit']
        ?? $this->input->get_post('limit', true)
        ?? 20;


    /*
    |--------------------------------------------------------------------------
    | 4. PAGINATION SETUP
    |--------------------------------------------------------------------------
    */

    $page = (
        is_numeric($page) &&
        (int)$page > 0
    )
        ? (int)$page
        : 1;


    $limit = (
        is_numeric($limit) &&
        (int)$limit > 0
    )
        ? (int)$limit
        : 20;


    /*
    | Maximum 100 records per request
    */

    if ($limit > 100) {
        $limit = 100;
    }


    $offset = ($page - 1) * $limit;


    /*
    |--------------------------------------------------------------------------
    | 5. USER VISIBILITY
    |--------------------------------------------------------------------------
    |
    | Admin:
    | role_id = 1
    |
    | Special Designations:
    | 45, 39, 76, 71, 72, 77, 128
    |
    | Admin / Special Designations:
    | => ALL CLIENTS
    |
    | Normal User:
    | => Assigned Clients Only
    |--------------------------------------------------------------------------
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];


    $can_view_all_clients = (
        $user_type === 1 ||
        in_array(
            $designation_id,
            $all_client_designations,
            true
        )
    );


    /*
    |--------------------------------------------------------------------------
    | 6. GET ASSIGNED CLIENTS FOR NORMAL USER
    |--------------------------------------------------------------------------
    */

    $assigned_client_ids = [];


    if (!$can_view_all_clients) {

        $assign_query = $this->db
            ->select('client_id')
            ->from('tbl_client_assign_team')
            ->where('user_id', $user_id)
            ->get();


        if (!$assign_query) {

            echo json_encode([
                'status'  => false,
                'message' => 'Assigned client query failed',
                'error'   => $this->db->error()
            ]);

            return;
        }


        $assign_team = $assign_query->result();


        if (!empty($assign_team)) {

            foreach ($assign_team as $row) {

                if (!empty($row->client_id)) {

                    $assigned_client_ids[] =
                        (int)$row->client_id;
                }
            }
        }


        /*
        | Remove duplicate client IDs
        */

        $assigned_client_ids = array_values(
            array_unique($assigned_client_ids)
        );
    }


    /*
    |--------------------------------------------------------------------------
    | 7. COMMON FILTER FUNCTION
    |--------------------------------------------------------------------------
    */

    $apply_filters = function () use (
        $can_view_all_clients,
        $assigned_client_ids,
        $client_id,
        $status,
        $start_date,
        $end_date
    ) {

        /*
        |--------------------------------------------------------------------------
        | CLIENT PERMISSION FILTER
        |--------------------------------------------------------------------------
        */

        if (!$can_view_all_clients) {

            /*
            | Normal user:
            | Assigned clients only
            */

            if (!empty($assigned_client_ids)) {

                $this->db->where_in(
                    'p.client_id',
                    $assigned_client_ids
                );

            } else {

                /*
                | No assigned clients
                | Force empty result
                */

                $this->db->where(
                    'p.client_id',
                    0
                );
            }
        }


        /*
        |--------------------------------------------------------------------------
        | SPECIFIC CLIENT FILTER
        |--------------------------------------------------------------------------
        */

        if (
            $client_id !== '' &&
            $client_id !== null &&
            is_numeric($client_id) &&
            (int)$client_id > 0
        ) {

            $this->db->where(
                'p.client_id',
                (int)$client_id
            );
        }


        /*
        |--------------------------------------------------------------------------
        | STATUS FILTER
        |--------------------------------------------------------------------------
        */

        if (!empty($status)) {

            $this->db->where(
                'p.status',
                $status
            );
        }


        /*
        |--------------------------------------------------------------------------
        | DATE RANGE FILTER
        |--------------------------------------------------------------------------
        */

        if (
            !empty($start_date) &&
            !empty($end_date)
        ) {

            $this->db->where(
                'DATE(p.created_date) >=',
                $start_date
            );

            $this->db->where(
                'DATE(p.created_date) <=',
                $end_date
            );

        } elseif (!empty($start_date)) {

            $this->db->where(
                'DATE(p.created_date) >=',
                $start_date
            );

        } elseif (!empty($end_date)) {

            $this->db->where(
                'DATE(p.created_date) <=',
                $end_date
            );
        }
    };


    /*
    |--------------------------------------------------------------------------
    | 8. GET TOTAL RECORD COUNT
    |--------------------------------------------------------------------------
    */

    $this->db->from(
        'tbl_client_on_site_purchase p'
    );


    $apply_filters();


    $totalRecords = $this->db
        ->count_all_results();


    /*
    |--------------------------------------------------------------------------
    | 9. MAIN QUERY
    |--------------------------------------------------------------------------
    */

    $this->db
        ->select('
            p.*,
            c.name as client_name,
            c.client_sr_id as client_sr_id
        ')
        ->from(
            'tbl_client_on_site_purchase p'
        )
        ->join(
            'tbl_client c',
            'c.client_id = p.client_id',
            'left'
        );


    /*
    |--------------------------------------------------------------------------
    | 10. APPLY FILTERS
    |--------------------------------------------------------------------------
    */

    $apply_filters();


    /*
    |--------------------------------------------------------------------------
    | 11. ORDER & PAGINATION
    |--------------------------------------------------------------------------
    */

    $this->db->order_by(
        'p.id',
        'DESC'
    );


    $this->db->limit(
        $limit,
        $offset
    );


    /*
    |--------------------------------------------------------------------------
    | 12. EXECUTE QUERY
    |--------------------------------------------------------------------------
    */

    $query = $this->db->get();


    if (!$query) {

        echo json_encode([
            'status'  => false,
            'message' => 'On Site Purchase query failed',
            'error'   => $this->db->error()
        ]);

        return;
    }


    $results = $query->result();


    /*
    |--------------------------------------------------------------------------
    | 13. FORMAT RESPONSE
    |--------------------------------------------------------------------------
    */

    $data_output = [];


    /*
    |--------------------------------------------------------------------------
    | UPLOAD BASE URL
    |--------------------------------------------------------------------------
    |
    | Example:
    |
    | fileName:
    | PV5K-307.pdf
    |
    | Output:
    | https://crm.hcinterior.in/uploads/PV5K-307.pdf
    |
    |--------------------------------------------------------------------------
    */

    $upload_base_url =
        'https://crm.hcinterior.in/uploads/';


    if (!empty($results)) {

        foreach ($results as $row) {


            /*
            |--------------------------------------------------------------------------
            | CONVERT OBJECT TO ARRAY
            |--------------------------------------------------------------------------
            */

            $record = (array)$row;


            /*
            |--------------------------------------------------------------------------
            | FORMAT IDS
            |--------------------------------------------------------------------------
            */

            if (isset($record['id'])) {

                $record['id'] =
                    (int)$record['id'];
            }


            if (isset($record['client_id'])) {

                $record['client_id'] =
                    (int)$record['client_id'];
            }


            /*
            |--------------------------------------------------------------------------
            | CLIENT DETAILS
            |--------------------------------------------------------------------------
            */

            $record['client_name'] =
                !empty($row->client_name)
                    ? $row->client_name
                    : '-';


            $record['client_sr_id'] =
                !empty($row->client_sr_id)
                    ? $row->client_sr_id
                    : '-';


            /*
            |--------------------------------------------------------------------------
            | PROCESS UPLOAD FILE
            |--------------------------------------------------------------------------
            |
            | Database Value:
            |
            | [
            |   {
            |       "fileName": "PV5K-307.pdf",
            |       "path": "uploads/PV5K-307.pdf",
            |       "fullPath": "/home/crm.../uploads/PV5K-307.pdf",
            |       "ext": ".pdf",
            |       "size": 51.5,
            |       "is_image": 0
            |   }
            | ]
            |
            | IMPORTANT:
            |
            | path     => IGNORE
            | fullPath => IGNORE
            |
            | ONLY fileName use hoga.
            |
            |--------------------------------------------------------------------------
            */

            $upload_files = [];


            if (!empty($row->upload_file)) {

                $decoded_files = json_decode(
                    $row->upload_file,
                    true
                );


                /*
                |--------------------------------------------------------------------------
                | JSON ARRAY
                |--------------------------------------------------------------------------
                */

                if (is_array($decoded_files)) {

                    foreach ($decoded_files as $file) {


                        /*
                        | Normal format:
                        |
                        | [
                        |   {
                        |      "fileName": "abc.pdf"
                        |   }
                        | ]
                        */

                        if (
                            is_array($file) &&
                            !empty($file['fileName'])
                        ) {

                            /*
                            | basename security ke liye
                            */

                            $file_name = basename(
                                $file['fileName']
                            );


                            /*
                            | Create Public URL
                            */

                            $upload_files[] =
                                $upload_base_url .
                                rawurlencode($file_name);
                        }


                        /*
                        | Fallback:
                        | Agar simple filename array hua
                        */

                        elseif (
                            is_string($file) &&
                            !empty($file)
                        ) {

                            $file_name = basename(
                                $file
                            );


                            $upload_files[] =
                                $upload_base_url .
                                rawurlencode($file_name);
                        }
                    }
                }


                /*
                |--------------------------------------------------------------------------
                | FALLBACK FOR NON JSON VALUE
                |--------------------------------------------------------------------------
                |
                | Agar database me directly:
                |
                | PV5K-307.pdf
                |
                | save hua ho.
                |
                |--------------------------------------------------------------------------
                */

                elseif (
                    is_string($row->upload_file) &&
                    trim($row->upload_file) !== ''
                ) {

                    $file_name = basename(
                        trim($row->upload_file)
                    );


                    $upload_files[] =
                        $upload_base_url .
                        rawurlencode($file_name);
                }
            }


            /*
            |--------------------------------------------------------------------------
            | REPLACE ORIGINAL upload_file
            |--------------------------------------------------------------------------
            |
            | Old:
            |
            | "upload_file":
            | "[{\"fileName\":\"PV5K-307.pdf\", ...}]"
            |
            | New:
            |
            | "upload_file": [
            |   "https://crm.hcinterior.in/uploads/PV5K-307.pdf"
            | ]
            |
            |--------------------------------------------------------------------------
            */

            $record['upload_file'] =
                $upload_files;


            /*
            |--------------------------------------------------------------------------
            | ADD RECORD
            |--------------------------------------------------------------------------
            */

            $data_output[] =
                $record;
        }
    }


    /*
    |--------------------------------------------------------------------------
    | 14. PAGINATION
    |--------------------------------------------------------------------------
    */

    $total_pages = (
        $limit > 0
    )
        ? (int)ceil(
            $totalRecords / $limit
        )
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 15. FINAL RESPONSE
    |--------------------------------------------------------------------------
    */

    echo json_encode([

        'status' =>
            true,


        'message' =>
            'On Site Purchase list fetched successfully',


        /*
        |--------------------------------------------------------------------------
        | FILTERS
        |--------------------------------------------------------------------------
        */

        'filters' => [

            'client_id' =>
                (
                    $client_id !== '' &&
                    $client_id !== null &&
                    is_numeric($client_id)
                )
                    ? (int)$client_id
                    : null,


            'status' =>
                !empty($status)
                    ? $status
                    : null,


            'start_date' =>
                !empty($start_date)
                    ? $start_date
                    : null,


            'end_date' =>
                !empty($end_date)
                    ? $end_date
                    : null
        ],


        /*
        |--------------------------------------------------------------------------
        | USER DEBUG
        |--------------------------------------------------------------------------
        | Production me isko remove kar sakte ho.
        |--------------------------------------------------------------------------
        */

        'user_debug' => [

            'user_id' =>
                $user_id,


            'role_id' =>
                $user_type,


            'designation_id' =>
                $designation_id,


            'can_view_all_clients' =>
                $can_view_all_clients,


            'assigned_client_ids' =>
                $can_view_all_clients
                    ? []
                    : $assigned_client_ids
        ],


        /*
        |--------------------------------------------------------------------------
        | PAGINATION
        |--------------------------------------------------------------------------
        */

        'page' =>
            $page,


        'limit' =>
            $limit,


        'total' =>
            (int)$totalRecords,


        'total_pages' =>
            $total_pages,


        'has_next_page' =>
            $page < $total_pages,


        'has_previous_page' =>
            $page > 1,


        /*
        |--------------------------------------------------------------------------
        | DATA
        |--------------------------------------------------------------------------
        */

        'data' =>
            $data_output
    ]);
}



/**
 * API: Get Dispatch List
 * Endpoint: POST client/dispatch_list
 *
 * Optional Payload:
 * {
 *     "client_id": 125,
 *     "status": "Approved",
 *     "is_recived": 1,
 *     "start_date": "2026-08-01",
 *     "end_date": "2026-08-31",
 *     "page": 1,
 *     "limit": 20
 * }
 */
 
/**
 * API: Get Dispatch List
 * Endpoint: POST client/dispatch_list
 */
public function dispatch_list()
{
    header('Content-Type: application/json');

    $this->load->helper('api_helper');


    /*
    |--------------------------------------------------------------------------
    | 1. VALIDATE TOKEN
    |--------------------------------------------------------------------------
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Invalid API token'
        ]);

        return;
    }

    $user_id = (int)$user->user_id;


    /*
    |--------------------------------------------------------------------------
    | 2. GET ROLE & DESIGNATION
    |--------------------------------------------------------------------------
    */

    $user_info = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_users')
        ->row();


    $account_details = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_account_details')
        ->row();


    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;


    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 3. READ INPUT
    |--------------------------------------------------------------------------
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }


    $client_id = $json['client_id']
        ?? $this->input->get_post('client_id', true);


    $status = $json['status']
        ?? $this->input->get_post('status', true);


    $is_recived = array_key_exists('is_recived', $json)
        ? $json['is_recived']
        : $this->input->get_post('is_recived', true);


    $start_date = $json['start_date']
        ?? $this->input->get_post('start_date', true);


    $end_date = $json['end_date']
        ?? $this->input->get_post('end_date', true);


    $page = $json['page']
        ?? $this->input->get_post('page', true)
        ?? 1;


    $limit = $json['limit']
        ?? $this->input->get_post('limit', true)
        ?? 20;


    /*
    |--------------------------------------------------------------------------
    | 4. PAGINATION
    |--------------------------------------------------------------------------
    */

    $page = (
        is_numeric($page) &&
        (int)$page > 0
    )
        ? (int)$page
        : 1;


    $limit = (
        is_numeric($limit) &&
        (int)$limit > 0
    )
        ? (int)$limit
        : 20;


    if ($limit > 100) {
        $limit = 100;
    }


    $offset = ($page - 1) * $limit;


    /*
    |--------------------------------------------------------------------------
    | 5. USER VISIBILITY
    |--------------------------------------------------------------------------
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];


    $can_view_all_clients = (
        $user_type === 1 ||
        in_array(
            $designation_id,
            $all_client_designations,
            true
        )
    );


    /*
    |--------------------------------------------------------------------------
    | 6. GET ASSIGNED CLIENTS
    |--------------------------------------------------------------------------
    */

    $assigned_client_ids = [];


    if (!$can_view_all_clients) {

        $assign_query = $this->db
            ->select('client_id')
            ->from('tbl_client_assign_team')
            ->where('user_id', $user_id)
            ->get();


        if (!$assign_query) {

            echo json_encode([
                'status'  => false,
                'message' => 'Assigned client query failed',
                'error'   => $this->db->error()
            ]);

            return;
        }


        $assign_team = $assign_query->result();


        foreach ($assign_team as $row) {

            if (!empty($row->client_id)) {

                $assigned_client_ids[] =
                    (int)$row->client_id;
            }
        }


        $assigned_client_ids = array_values(
            array_unique($assigned_client_ids)
        );
    }


    /*
    |--------------------------------------------------------------------------
    | 7. COMMON FILTERS
    |--------------------------------------------------------------------------
    */

    $apply_filters = function () use (
        $can_view_all_clients,
        $assigned_client_ids,
        $client_id,
        $status,
        $is_recived,
        $start_date,
        $end_date
    ) {


        /*
        | CLIENT PERMISSION
        */

        if (!$can_view_all_clients) {

            if (!empty($assigned_client_ids)) {

                $this->db->where_in(
                    'd.client_id',
                    $assigned_client_ids
                );

            } else {

                $this->db->where(
                    'd.client_id',
                    0
                );
            }
        }


        /*
        | SPECIFIC CLIENT
        */

        if (
            $client_id !== '' &&
            $client_id !== null &&
            is_numeric($client_id) &&
            (int)$client_id > 0
        ) {

            $this->db->where(
                'd.client_id',
                (int)$client_id
            );
        }


        /*
        | STATUS
        */

        if (!empty($status)) {

            $this->db->where(
                'd.status',
                $status
            );
        }


        /*
        | RECEIVED STATUS
        */

        if (
            $is_recived !== '' &&
            $is_recived !== null
        ) {

            $this->db->where(
                'd.is_recived',
                $is_recived
            );
        }


        /*
        | DATE RANGE
        */

        if (
            !empty($start_date) &&
            !empty($end_date)
        ) {

            $this->db->where(
                'DATE(d.created_date) >=',
                $start_date
            );

            $this->db->where(
                'DATE(d.created_date) <=',
                $end_date
            );

        } elseif (!empty($start_date)) {

            $this->db->where(
                'DATE(d.created_date) >=',
                $start_date
            );

        } elseif (!empty($end_date)) {

            $this->db->where(
                'DATE(d.created_date) <=',
                $end_date
            );
        }
    };


    /*
    |--------------------------------------------------------------------------
    | 8. TOTAL COUNT
    |--------------------------------------------------------------------------
    */

    $this->db->from(
        'tbl_client_dispatch d'
    );


    $apply_filters();


    $totalRecords =
        $this->db->count_all_results();


    /*
    |--------------------------------------------------------------------------
    | 9. MAIN DISPATCH QUERY
    |--------------------------------------------------------------------------
    */

    $this->db
        ->select('
            d.*,
            c.name as client_name,
            c.client_sr_id as client_sr_id
        ')
        ->from(
            'tbl_client_dispatch d'
        )
        ->join(
            'tbl_client c',
            'c.client_id = d.client_id',
            'left'
        );


    $apply_filters();


    $this->db->order_by(
        'd.id',
        'DESC'
    );


    $this->db->limit(
        $limit,
        $offset
    );


    $query = $this->db->get();


    if (!$query) {

        echo json_encode([
            'status'  => false,
            'message' => 'Dispatch query failed',
            'error'   => $this->db->error()
        ]);

        return;
    }


    $dispatch_items =
        $query->result();


    /*
    |--------------------------------------------------------------------------
    | 10. GET DISPATCH ITEM QUERIES
    |--------------------------------------------------------------------------
    |
    | Table:
    | tbl_client_dispatch_item_query
    |
    | Relation:
    | q.dispatch_id = dispatch.id
    |
    |--------------------------------------------------------------------------
    */

    $queries_by_dispatch = [];


    if (!empty($dispatch_items)) {

        /*
        | Collect Dispatch IDs
        */

        $dispatch_ids = [];


        foreach ($dispatch_items as $item) {

            if (!empty($item->id)) {

                $dispatch_ids[] =
                    (int)$item->id;
            }
        }


        $dispatch_ids = array_values(
            array_unique($dispatch_ids)
        );


        /*
        |--------------------------------------------------------------------------
        | GET ALL QUERIES IN SINGLE QUERY
        |--------------------------------------------------------------------------
        */

        if (!empty($dispatch_ids)) {

            $dispatch_query_result = $this->db
                ->select('
                    q.id,
                    q.client_id,
                    q.dispatch_id,
                    q.remarks,
                    q.created_date,
                    q.updated_date,
                    q.uploaded_by,
                    q.file_name,
                    a.fullname as uploaded_by_name
                ')
                ->from(
                    'tbl_client_dispatch_item_query q'
                )
                ->join(
                    'tbl_account_details a',
                    'a.user_id = q.uploaded_by',
                    'left'
                )
                ->where_in(
                    'q.dispatch_id',
                    $dispatch_ids
                )
                ->order_by(
                    'q.id',
                    'DESC'
                )
                ->get();


            if (!$dispatch_query_result) {

                echo json_encode([
                    'status'  => false,
                    'message' => 'Dispatch item query fetch failed',
                    'error'   => $this->db->error()
                ]);

                return;
            }


            $dispatch_queries =
                $dispatch_query_result->result();


            /*
            |--------------------------------------------------------------------------
            | GROUP QUERIES BY DISPATCH ID
            |--------------------------------------------------------------------------
            */

            foreach ($dispatch_queries as $q) {

                $dispatch_id =
                    (int)$q->dispatch_id;


                if (
                    !isset(
                        $queries_by_dispatch[
                            $dispatch_id
                        ]
                    )
                ) {

                    $queries_by_dispatch[
                        $dispatch_id
                    ] = [];
                }


                /*
                |--------------------------------------------------------------------------
                | QUERY FILE URL
                |--------------------------------------------------------------------------
                */

                $query_file_url = null;


                if (!empty($q->file_name)) {

                    $query_file_url =
                        'https://crm.hcinterior.in/uploads/' .
                        rawurlencode(
                            basename($q->file_name)
                        );
                }


                /*
                |--------------------------------------------------------------------------
                | ADD QUERY
                |--------------------------------------------------------------------------
                */

                $queries_by_dispatch[
                    $dispatch_id
                ][] = [

                    'id' =>
                        (int)$q->id,

                    'client_id' =>
                        (int)$q->client_id,

                    'dispatch_id' =>
                        (int)$q->dispatch_id,

                    'remarks' =>
                        $q->remarks ?? '',

                    'uploaded_by' =>
                        (int)$q->uploaded_by,

                    'uploaded_by_name' =>
                        !empty($q->uploaded_by_name)
                            ? $q->uploaded_by_name
                            : '-',

                    /*
                    | Original File Name
                    */

                    'file_name' =>
                        $q->file_name,

                    /*
                    | Full File URL
                    */

                    'file_url' =>
                        $query_file_url,

                    'created_date' =>
                        $q->created_date,

                    'updated_date' =>
                        $q->updated_date
                ];
            }
        }
    }


    /*
    |--------------------------------------------------------------------------
    | 11. FORMAT MAIN DISPATCH DATA
    |--------------------------------------------------------------------------
    */

    $data_output = [];


    $upload_base_url =
        'https://crm.hcinterior.in/uploads/';


    foreach ($dispatch_items as $item) {


        $record =
            (array)$item;


        /*
        |--------------------------------------------------------------------------
        | FORMAT IDS
        |--------------------------------------------------------------------------
        */

        if (isset($record['id'])) {

            $record['id'] =
                (int)$record['id'];
        }


        if (isset($record['client_id'])) {

            $record['client_id'] =
                (int)$record['client_id'];
        }


        if (isset($record['is_recived'])) {

            $record['is_recived'] =
                (int)$record['is_recived'];
        }


        /*
        |--------------------------------------------------------------------------
        | CLIENT DETAILS
        |--------------------------------------------------------------------------
        */

        $record['client_name'] =
            !empty($item->client_name)
                ? $item->client_name
                : '-';


        $record['client_sr_id'] =
            !empty($item->client_sr_id)
                ? $item->client_sr_id
                : '-';


        /*
        |--------------------------------------------------------------------------
        | FIX MAIN DISPATCH upload_file
        |--------------------------------------------------------------------------
        */

        $upload_files = [];


        if (!empty($item->upload_file)) {

            $decoded_files = json_decode(
                $item->upload_file,
                true
            );


            if (is_array($decoded_files)) {

                foreach ($decoded_files as $file) {


                    /*
                    | Standard JSON File
                    */

                    if (
                        is_array($file) &&
                        !empty($file['fileName'])
                    ) {

                        $file_name =
                            basename(
                                $file['fileName']
                            );


                        $upload_files[] =
                            $upload_base_url .
                            rawurlencode(
                                $file_name
                            );
                    }


                    /*
                    | Simple File String
                    */

                    elseif (
                        is_string($file) &&
                        trim($file) !== ''
                    ) {

                        $file_name =
                            basename(
                                trim($file)
                            );


                        $upload_files[] =
                            $upload_base_url .
                            rawurlencode(
                                $file_name
                            );
                    }
                }

            } else {

                /*
                | Direct filename fallback
                */

                $file_name =
                    basename(
                        trim($item->upload_file)
                    );


                if (!empty($file_name)) {

                    $upload_files[] =
                        $upload_base_url .
                        rawurlencode(
                            $file_name
                        );
                }
            }
        }


        $record['upload_file'] =
            $upload_files;


        /*
        |--------------------------------------------------------------------------
        | ATTACH DISPATCH ITEM QUERIES
        |--------------------------------------------------------------------------
        */

        $dispatch_id =
            (int)$item->id;


        if (
            isset(
                $queries_by_dispatch[
                    $dispatch_id
                ]
            )
        ) {

            $record['queries'] =
                $queries_by_dispatch[
                    $dispatch_id
                ];

        } else {

            $record['queries'] = [];
        }


        /*
        |--------------------------------------------------------------------------
        | QUERY COUNT
        |--------------------------------------------------------------------------
        */

        $record['total_queries'] =
            count(
                $record['queries']
            );


        /*
        |--------------------------------------------------------------------------
        | ADD FINAL RECORD
        |--------------------------------------------------------------------------
        */

        $data_output[] =
            $record;
    }


    /*
    |--------------------------------------------------------------------------
    | 12. PAGINATION
    |--------------------------------------------------------------------------
    */

    $total_pages = (
        $limit > 0
    )
        ? (int)ceil(
            $totalRecords / $limit
        )
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 13. FINAL RESPONSE
    |--------------------------------------------------------------------------
    */

    echo json_encode([

        'status' =>
            true,

        'message' =>
            'Dispatch list fetched successfully',


        /*
        |--------------------------------------------------------------------------
        | FILTERS
        |--------------------------------------------------------------------------
        */

        'filters' => [

            'client_id' =>
                (
                    $client_id !== '' &&
                    $client_id !== null &&
                    is_numeric($client_id)
                )
                    ? (int)$client_id
                    : null,


            'status' =>
                !empty($status)
                    ? $status
                    : null,


            'is_recived' =>
                (
                    $is_recived !== '' &&
                    $is_recived !== null
                )
                    ? (int)$is_recived
                    : null,


            'start_date' =>
                !empty($start_date)
                    ? $start_date
                    : null,


            'end_date' =>
                !empty($end_date)
                    ? $end_date
                    : null
        ],


        /*
        |--------------------------------------------------------------------------
        | PAGINATION
        |--------------------------------------------------------------------------
        */

        'page' =>
            $page,

        'limit' =>
            $limit,

        'total' =>
            (int)$totalRecords,

        'total_pages' =>
            $total_pages,

        'has_next_page' =>
            $page < $total_pages,

        'has_previous_page' =>
            $page > 1,


        /*
        |--------------------------------------------------------------------------
        | DATA
        |--------------------------------------------------------------------------
        */

        'data' =>
            $data_output
    ]);
}


/**
 * API: Add Dispatch Query
 * Endpoint: POST client/add_dispatch_query
 *
 * Content-Type:
 * multipart/form-data
 *
 * Fields:
 * dispatch_id : required
 * client_id   : required
 * remarks     : required
 * file        : optional
 */
public function add_dispatch_query()
{
    header('Content-Type: application/json');

    $this->load->helper('api_helper');


    /*
    |--------------------------------------------------------------------------
    | 1. VALIDATE API TOKEN
    |--------------------------------------------------------------------------
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Invalid API token'
        ]);

        return;
    }

    $logged_user_id = (int)$user->user_id;


    /*
    |--------------------------------------------------------------------------
    | 2. GET USER ROLE & DESIGNATION
    |--------------------------------------------------------------------------
    */

    $user_info = $this->db
        ->where('user_id', $logged_user_id)
        ->get('tbl_users')
        ->row();


    $account_details = $this->db
        ->where('user_id', $logged_user_id)
        ->get('tbl_account_details')
        ->row();


    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;


    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    |--------------------------------------------------------------------------
    | 3. READ INPUT
    |--------------------------------------------------------------------------
    |
    | multipart/form-data supported
    | JSON also supported when file is not being uploaded
    |
    |--------------------------------------------------------------------------
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }


    $dispatch_id = $json['dispatch_id']
        ?? $this->input->post('dispatch_id', true);


    $client_id = $json['client_id']
        ?? $this->input->post('client_id', true);


    $remarks = $json['remarks']
        ?? $this->input->post('remarks', true);


    /*
    |--------------------------------------------------------------------------
    | 4. VALIDATION
    |--------------------------------------------------------------------------
    */

    if (
        empty($dispatch_id) ||
        !is_numeric($dispatch_id)
    ) {

        echo json_encode([
            'status'  => false,
            'message' => 'dispatch_id is required'
        ]);

        return;
    }


    if (
        empty($client_id) ||
        !is_numeric($client_id)
    ) {

        echo json_encode([
            'status'  => false,
            'message' => 'client_id is required'
        ]);

        return;
    }


    if (
        $remarks === null ||
        trim($remarks) === ''
    ) {

        echo json_encode([
            'status'  => false,
            'message' => 'remarks is required'
        ]);

        return;
    }


    $dispatch_id = (int)$dispatch_id;
    $client_id   = (int)$client_id;
    $remarks     = trim($remarks);


    /*
    |--------------------------------------------------------------------------
    | 5. USER PERMISSION
    |--------------------------------------------------------------------------
    |
    | Admin + Special Designations:
    | ALL CLIENTS
    |
    | Normal User:
    | Assigned Client Only
    |
    |--------------------------------------------------------------------------
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];


    $can_view_all_clients = (
        $user_type === 1 ||
        in_array(
            $designation_id,
            $all_client_designations,
            true
        )
    );


    /*
    |--------------------------------------------------------------------------
    | 6. CHECK CLIENT ASSIGNMENT
    |--------------------------------------------------------------------------
    */

    if (!$can_view_all_clients) {

        $assigned = $this->db
            ->where('user_id', $logged_user_id)
            ->where('client_id', $client_id)
            ->get('tbl_client_assign_team')
            ->row();


        if (empty($assigned)) {

            echo json_encode([
                'status'  => false,
                'message' => 'You are not assigned to this client'
            ]);

            return;
        }
    }


    /*
    |--------------------------------------------------------------------------
    | 7. CHECK CLIENT EXISTS
    |--------------------------------------------------------------------------
    */

    $client = $this->db
        ->where('client_id', $client_id)
        ->get('tbl_client')
        ->row();


    if (empty($client)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Client not found'
        ]);

        return;
    }


    /*
    |--------------------------------------------------------------------------
    | 8. CHECK DISPATCH EXISTS
    |--------------------------------------------------------------------------
    |
    | Important:
    | dispatch_id + client_id dono match hone chahiye.
    |
    |--------------------------------------------------------------------------
    */

    $dispatch = $this->db
        ->where('id', $dispatch_id)
        ->where('client_id', $client_id)
        ->get('tbl_client_dispatch')
        ->row();


    if (empty($dispatch)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Dispatch not found for this client'
        ]);

        return;
    }


    /*
    |--------------------------------------------------------------------------
    | 9. FILE UPLOAD
    |--------------------------------------------------------------------------
    */

    $file_name = null;
    $file_url  = null;


    /*
    | Ensure Upload Directory Exists
    */

    $upload_path = FCPATH . 'uploads/';


    if (!is_dir($upload_path)) {

        if (!mkdir($upload_path, 0777, true)) {

            echo json_encode([
                'status'  => false,
                'message' => 'Unable to create upload directory'
            ]);

            return;
        }
    }


    /*
    |--------------------------------------------------------------------------
    | FILE PROVIDED
    |--------------------------------------------------------------------------
    */

    if (
        isset($_FILES['file']) &&
        !empty($_FILES['file']['name'])
    ) {

        $config = [];

        $config['upload_path']   = $upload_path;
        $config['allowed_types'] = '*';
        $config['encrypt_name']  = true;


        /*
        | Optional max size
        | 10 MB
        */

        $config['max_size'] = 10240;


        /*
        |--------------------------------------------------------------------------
        | INITIALIZE UPLOAD LIBRARY
        |--------------------------------------------------------------------------
        */

        $this->load->library('upload');

        $this->upload->initialize(
            $config
        );


        /*
        |--------------------------------------------------------------------------
        | UPLOAD FILE
        |--------------------------------------------------------------------------
        */

        if (!$this->upload->do_upload('file')) {

            echo json_encode([
                'status'  => false,
                'message' => 'File upload failed',
                'error'   => strip_tags(
                    $this->upload->display_errors()
                )
            ]);

            return;
        }


        /*
        |--------------------------------------------------------------------------
        | GET UPLOADED FILE DATA
        |--------------------------------------------------------------------------
        */

        $upload_data =
            $this->upload->data();


        $file_name =
            $upload_data['file_name'];


        /*
        |--------------------------------------------------------------------------
        | CREATE PUBLIC FILE URL
        |--------------------------------------------------------------------------
        */

        $file_url =
            'https://crm.hcinterior.in/uploads/' .
            rawurlencode($file_name);
    }


    /*
    |--------------------------------------------------------------------------
    | 10. PREPARE INSERT DATA
    |--------------------------------------------------------------------------
    */

    $current_date =
        date('Y-m-d H:i:s');


    $insert_data = [

        'client_id' =>
            $client_id,

        'dispatch_id' =>
            $dispatch_id,

        'remarks' =>
            $remarks,

        'file_name' =>
            $file_name,

        'uploaded_by' =>
            $logged_user_id,

        'created_date' =>
            $current_date,

        'updated_date' =>
            $current_date
    ];


    /*
    |--------------------------------------------------------------------------
    | 11. INSERT DISPATCH QUERY
    |--------------------------------------------------------------------------
    */

    $save = $this->db->insert(
        'tbl_client_dispatch_item_query',
        $insert_data
    );


    if (!$save) {

        /*
        | Database insert failed.
        | Uploaded file ko remove kar do to avoid orphan file.
        */

        if (
            !empty($file_name) &&
            file_exists($upload_path . $file_name)
        ) {

            @unlink(
                $upload_path . $file_name
            );
        }


        echo json_encode([
            'status'  => false,
            'message' => 'Unable to save dispatch query',
            'error'   => $this->db->error()
        ]);

        return;
    }


    /*
    |--------------------------------------------------------------------------
    | 12. GET INSERTED ID
    |--------------------------------------------------------------------------
    */

    $query_id =
        (int)$this->db->insert_id();


    /*
    |--------------------------------------------------------------------------
    | 13. SEND NOTIFICATIONS
    |--------------------------------------------------------------------------
    */

    $notification_sent_to = [];


    /*
    | Get Client Team Members
    */

    $team_members =
        get_client_team_members(
            $client_id
        );


    /*
    | Only these profiles receive notification
    */

    $allowed_roles = [
        'Designer',
        'Project Coordinator',
        'Factory Production Team'
    ];


    if (!empty($team_members)) {

        foreach ($team_members as $member) {


            /*
            | Team Member Profile
            */

            $role =
                $member->member_profile ?? '';


            $notify_user_id =
                isset($member->user_id)
                    ? (int)$member->user_id
                    : 0;


            /*
            |--------------------------------------------------------------------------
            | CHECK ALLOWED ROLE
            |--------------------------------------------------------------------------
            */

            if (
                !in_array(
                    $role,
                    $allowed_roles,
                    true
                )
            ) {

                continue;
            }


            /*
            |--------------------------------------------------------------------------
            | INVALID USER
            |--------------------------------------------------------------------------
            */

            if ($notify_user_id <= 0) {

                continue;
            }


            /*
            |--------------------------------------------------------------------------
            | DON'T NOTIFY CURRENT USER
            |--------------------------------------------------------------------------
            */

            if (
                $notify_user_id ===
                $logged_user_id
            ) {

                continue;
            }


            /*
            |--------------------------------------------------------------------------
            | AVOID DUPLICATE NOTIFICATIONS
            |--------------------------------------------------------------------------
            */

            if (
                in_array(
                    $notify_user_id,
                    $notification_sent_to,
                    true
                )
            ) {

                continue;
            }


            /*
            |--------------------------------------------------------------------------
            | CLIENT NAME
            |--------------------------------------------------------------------------
            */

            $clientName =
                !empty($client->name)
                    ? $client->name
                    : 'N/A';


            /*
            |--------------------------------------------------------------------------
            | DISPATCH FILE NAME
            |--------------------------------------------------------------------------
            */

            $dispatchFileName =
                !empty($dispatch->file_name)
                    ? $dispatch->file_name
                    : 'Dispatch';


            /*
            |--------------------------------------------------------------------------
            | NOTIFICATION MESSAGE
            |--------------------------------------------------------------------------
            */

            $message =
                'Query for ' .
                $clientName .
                ' (' .
                $dispatchFileName .
                ') has been raised';


            /*
            |--------------------------------------------------------------------------
            | ADD NOTIFICATION
            |--------------------------------------------------------------------------
            */

            add_notification([

                'to_user_id' =>
                    $notify_user_id,

                'from_user_id' =>
                    $logged_user_id,

                'description' =>
                    $message,

                'link' =>
                    'admin/client/details/' .
                    $client_id .
                    '/purchase_request',

                'value' =>
                    $message
            ]);


            /*
            |--------------------------------------------------------------------------
            | SHOW / PUSH NOTIFICATION
            |--------------------------------------------------------------------------
            */

            show_notification([
                $notify_user_id
            ]);


            /*
            | Mark Notification Sent
            */

            $notification_sent_to[] =
                $notify_user_id;
        }
    }


    /*
    |--------------------------------------------------------------------------
    | 14. GET USER NAME
    |--------------------------------------------------------------------------
    */

    $uploaded_by_name =
        !empty($account_details->fullname)
            ? $account_details->fullname
            : '-';


    /*
    |--------------------------------------------------------------------------
    | 15. FINAL SUCCESS RESPONSE
    |--------------------------------------------------------------------------
    */

    echo json_encode([

        'status' =>
            true,

        'message' =>
            'Dispatch query added successfully',

        'data' => [

            'id' =>
                $query_id,

            'dispatch_id' =>
                $dispatch_id,

            'client_id' =>
                $client_id,

            'client_sr_id' =>
                $client->client_sr_id ?? '-',

            'client_name' =>
                $client->name ?? '-',

            'remarks' =>
                $remarks,

            /*
            | File name saved in DB
            */

            'file_name' =>
                $file_name,

            /*
            | Full URL for Mobile App
            */

            'file_url' =>
                $file_url,

            'uploaded_by' =>
                $logged_user_id,

            'uploaded_by_name' =>
                $uploaded_by_name,

            'created_date' =>
                $current_date,

            'notification_sent_to' =>
                $notification_sent_to
        ]
    ]);
}



/**
 * API: BOM / Checklist List
 * Endpoint: POST client/bom_list
 */
public function bom_list()
{
    header('Content-Type: application/json');
    $this->load->helper('api_helper');

    /*
    |--------------------------------------------------------------------------
    | VALIDATE TOKEN
    |--------------------------------------------------------------------------
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {
        echo json_encode([
            'status'  => false,
            'message' => 'Invalid API token'
        ]);
        return;
    }

    $user_id = (int)$user->user_id;


    /*
    |--------------------------------------------------------------------------
    | GET ROLE + DESIGNATION
    |--------------------------------------------------------------------------
    */

    $user_info = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_users')
        ->row();

    $account_details = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_account_details')
        ->row();

    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;

    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    |--------------------------------------------------------------------------
    | READ JSON / GET / POST INPUT
    |--------------------------------------------------------------------------
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }


    /*
    |--------------------------------------------------------------------------
    | FILTERS
    |--------------------------------------------------------------------------
    */

    $client_id = $json['client_id']
        ?? $this->input->get_post('client_id', true);

    $category = $json['category']
        ?? $this->input->get_post('category', true);

    $type = $json['type']
        ?? $this->input->get_post('type', true);

    $status = $json['status']
        ?? $this->input->get_post('status', true);

    $start_date = $json['start_date']
        ?? $this->input->get_post('start_date', true);

    $end_date = $json['end_date']
        ?? $this->input->get_post('end_date', true);

    $page = $json['page']
        ?? $this->input->get_post('page', true)
        ?? 1;

    $limit = $json['limit']
        ?? $this->input->get_post('limit', true)
        ?? 20;


    /*
    |--------------------------------------------------------------------------
    | PAGINATION
    |--------------------------------------------------------------------------
    */

    $page = (
        is_numeric($page) &&
        (int)$page > 0
    )
        ? (int)$page
        : 1;

    $limit = (
        is_numeric($limit) &&
        (int)$limit > 0
    )
        ? (int)$limit
        : 20;

    // Maximum 100 records
    if ($limit > 100) {
        $limit = 100;
    }

    $offset = ($page - 1) * $limit;


    /*
    |--------------------------------------------------------------------------
    | USER VISIBILITY
    |--------------------------------------------------------------------------
    |
    | Admin + Special Designations
    | => All clients
    |
    | Normal User
    | => Assigned clients only
    |
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];

    $can_view_all_clients = (
        $user_type === 1 ||
        in_array(
            $designation_id,
            $all_client_designations,
            true
        )
    );


    /*
    |--------------------------------------------------------------------------
    | GET ASSIGNED CLIENTS
    |--------------------------------------------------------------------------
    */

    $assigned_client_ids = [];

    if (!$can_view_all_clients) {

        $assign_query = $this->db
            ->select('client_id')
            ->from('tbl_client_assign_team')
            ->where('user_id', $user_id)
            ->get();

        if (!$assign_query) {

            echo json_encode([
                'status'  => false,
                'message' => 'Assigned client query failed',
                'error'   => $this->db->error()
            ]);

            return;
        }

        foreach ($assign_query->result() as $row) {

            if (!empty($row->client_id)) {
                $assigned_client_ids[] =
                    (int)$row->client_id;
            }
        }

        $assigned_client_ids = array_values(
            array_unique($assigned_client_ids)
        );
    }


    /*
    |--------------------------------------------------------------------------
    | COMMON FILTER FUNCTION
    |--------------------------------------------------------------------------
    */

    $apply_filters = function () use (
        $can_view_all_clients,
        $assigned_client_ids,
        $client_id,
        $category,
        $type,
        $status,
        $start_date,
        $end_date
    ) {

        /*
        |--------------------------------------------------------------------------
        | PARENT BOM ONLY
        |--------------------------------------------------------------------------
        */

        $this->db->where(
            'b.parent_bom_id IS NULL',
            null,
            false
        );


        /*
        |--------------------------------------------------------------------------
        | USER CLIENT PERMISSION
        |--------------------------------------------------------------------------
        */

        if (!$can_view_all_clients) {

            if (!empty($assigned_client_ids)) {

                $this->db->where_in(
                    'b.client_id',
                    $assigned_client_ids
                );

            } else {

                // No client assigned
                $this->db->where(
                    'b.client_id',
                    0
                );
            }
        }


        /*
        |--------------------------------------------------------------------------
        | CLIENT FILTER
        |--------------------------------------------------------------------------
        */

        if (
            $client_id !== '' &&
            $client_id !== null &&
            is_numeric($client_id) &&
            (int)$client_id > 0
        ) {

            $this->db->where(
                'b.client_id',
                (int)$client_id
            );
        }


        /*
        |--------------------------------------------------------------------------
        | CATEGORY FILTER
        |--------------------------------------------------------------------------
        */

        if (!empty($category)) {

            $this->db->where(
                'b.category',
                $category
            );
        }


        /*
        |--------------------------------------------------------------------------
        | TYPE FILTER
        |--------------------------------------------------------------------------
        */

        // if (!empty($type)) {

            // $this->db->where(
                // 'b.type',
                // $type
            // );
        // }

$allowed_bom_types = [
    'Cutting List Wordrobe',
    'Cutting List Kitchen',
    'BOM 3'
];

$this->db->where_in(
    'b.type',
    $allowed_bom_types
);

        /*
        |--------------------------------------------------------------------------
        | STATUS FILTER
        |--------------------------------------------------------------------------
        */

        if (!empty($status)) {

            $this->db->where(
                'b.status',
                $status
            );
        }


        /*
        |--------------------------------------------------------------------------
        | DATE RANGE FILTER
        |--------------------------------------------------------------------------
        */

        if (
            !empty($start_date) &&
            !empty($end_date)
        ) {

            $this->db->where(
                'DATE(b.created_date) >=',
                $start_date
            );

            $this->db->where(
                'DATE(b.created_date) <=',
                $end_date
            );

        } elseif (!empty($start_date)) {

            $this->db->where(
                'DATE(b.created_date) >=',
                $start_date
            );

        } elseif (!empty($end_date)) {

            $this->db->where(
                'DATE(b.created_date) <=',
                $end_date
            );
        }
    };


    /*
    |--------------------------------------------------------------------------
    | TOTAL RECORD COUNT
    |--------------------------------------------------------------------------
    */

    $this->db->from('tbl_client_bom b');

    $apply_filters();

    $totalRecords =
        $this->db->count_all_results();


    /*
    |--------------------------------------------------------------------------
    | MAIN BOM QUERY
    |--------------------------------------------------------------------------
    */

    $this->db
        ->select('
            b.*,
            c.name as client_name,
            c.client_sr_id as client_sr_id
        ')
        ->from('tbl_client_bom b')
        ->join(
            'tbl_client c',
            'c.client_id = b.client_id',
            'left'
        );


    /*
    | Apply same filters
    */

    $apply_filters();


    /*
    | Order + Pagination
    */

    $this->db->order_by(
        'b.id',
        'DESC'
    );

    $this->db->limit(
        $limit,
        $offset
    );


    /*
    | Execute
    */

    $query = $this->db->get();


    if (!$query) {

        echo json_encode([
            'status'  => false,
            'message' => 'BOM query failed',
            'error'   => $this->db->error()
        ]);

        return;
    }


    $parent_boms =
        $query->result();


    /*
    |--------------------------------------------------------------------------
    | GET CHILD BOMS
    |--------------------------------------------------------------------------
    */

    $children_by_parent = [];


    if (!empty($parent_boms)) {

        $parent_ids = [];


        foreach ($parent_boms as $parent) {

            $parent_ids[] =
                (int)$parent->id;
        }


        /*
        | Fetch all children in single query
        */

        $child_query = $this->db
            ->where_in(
                'parent_bom_id',
                $parent_ids
            )
            ->order_by(
                'id',
                'ASC'
            )
            ->get(
                'tbl_client_bom'
            );


        if ($child_query) {

            foreach (
                $child_query->result()
                as $child
            ) {

                $parent_id =
                    (int)$child->parent_bom_id;


                if (
                    !isset(
                        $children_by_parent[
                            $parent_id
                        ]
                    )
                ) {

                    $children_by_parent[
                        $parent_id
                    ] = [];
                }


                $children_by_parent[
                    $parent_id
                ][] = $child;
            }
        }
    }


    /*
    |--------------------------------------------------------------------------
    | UPLOAD FILE BASE URL
    |--------------------------------------------------------------------------
    */

    $upload_base_url =
        'https://crm.hcinterior.in/uploads/';


    /*
    |--------------------------------------------------------------------------
    | FORMAT UPLOAD FILE FUNCTION
    |--------------------------------------------------------------------------
    */

    $format_upload_file = function ($raw)
        use ($upload_base_url) {

        $files = [];


        if (empty($raw)) {
            return $files;
        }


        /*
        | Decode JSON
        */

        $decoded =
            json_decode(
                $raw,
                true
            );


        /*
        |--------------------------------------------------------------------------
        | JSON FILE FORMAT
        |--------------------------------------------------------------------------
        |
        | [
        |   {
        |      "fileName": "example.pdf",
        |      "path": "uploads/example.pdf",
        |      "fullPath": "/home/.../uploads/example.pdf"
        |   }
        | ]
        |
        */

        if (is_array($decoded)) {

            foreach ($decoded as $file) {

                /*
                | Object/Array format
                */

                if (
                    is_array($file) &&
                    !empty($file['fileName'])
                ) {

                    $file_name =
                        basename(
                            $file['fileName']
                        );


                    $files[] =
                        $upload_base_url .
                        rawurlencode(
                            $file_name
                        );
                }


                /*
                | Simple filename format
                */

                elseif (
                    is_string($file) &&
                    trim($file) !== ''
                ) {

                    $file_name =
                        basename(
                            trim($file)
                        );


                    $files[] =
                        $upload_base_url .
                        rawurlencode(
                            $file_name
                        );
                }
            }

        } else {

            /*
            |--------------------------------------------------------------------------
            | DIRECT FILE NAME FALLBACK
            |--------------------------------------------------------------------------
            */

            $file_name =
                basename(
                    trim($raw)
                );


            if (!empty($file_name)) {

                $files[] =
                    $upload_base_url .
                    rawurlencode(
                        $file_name
                    );
            }
        }


        return $files;
    };


    /*
    |--------------------------------------------------------------------------
    | FORMAT FINAL RESPONSE
    |--------------------------------------------------------------------------
    */

    $data_output = [];


    foreach ($parent_boms as $parent) {

        $record =
            (array)$parent;


        /*
        | Convert IDs to integer
        */

        $record['id'] =
            (int)$parent->id;

        $record['client_id'] =
            (int)$parent->client_id;


        /*
        |--------------------------------------------------------------------------
        | FIX PARENT upload_file
        |--------------------------------------------------------------------------
        */

        if (
            property_exists(
                $parent,
                'upload_file'
            )
        ) {

            $record['upload_file'] =
                $format_upload_file(
                    $parent->upload_file
                );
        }


        /*
        |--------------------------------------------------------------------------
        | CHILD BOMs
        |--------------------------------------------------------------------------
        */

        $children = [];


        if (
            isset(
                $children_by_parent[
                    (int)$parent->id
                ]
            )
        ) {

            foreach (
                $children_by_parent[
                    (int)$parent->id
                ]
                as $child
            ) {

                $child_record =
                    (array)$child;


                /*
                | Convert IDs
                */

                $child_record['id'] =
                    (int)$child->id;

                $child_record['client_id'] =
                    (int)$child->client_id;

                $child_record['parent_bom_id'] =
                    (int)$child->parent_bom_id;


                /*
                |--------------------------------------------------------------------------
                | FIX CHILD upload_file
                |--------------------------------------------------------------------------
                */

                if (
                    property_exists(
                        $child,
                        'upload_file'
                    )
                ) {

                    $child_record['upload_file'] =
                        $format_upload_file(
                            $child->upload_file
                        );
                }


                $children[] =
                    $child_record;
            }
        }


        /*
        | Attach Children
        */

        $record['children'] =
            $children;


        /*
        | Child Count
        */

        $record['total_children'] =
            count($children);


        /*
        | Add final record
        */

        $data_output[] =
            $record;
    }


    /*
    |--------------------------------------------------------------------------
    | PAGINATION INFO
    |--------------------------------------------------------------------------
    */

    $total_pages =
        $limit > 0
            ? (int)ceil(
                $totalRecords / $limit
            )
            : 0;


    /*
    |--------------------------------------------------------------------------
    | FINAL RESPONSE
    |--------------------------------------------------------------------------
    */

    echo json_encode([

        'status' =>
            true,

        'message' =>
            'BOM list fetched successfully',

        /*
        | Applied Filters
        */

        'filters' => [

            'client_id' =>
                $client_id,

            'category' =>
                $category,

            'type' =>
                $type,

            'status' =>
                $status,

            'start_date' =>
                $start_date,

            'end_date' =>
                $end_date
        ],

        /*
        | Pagination
        */

        'page' =>
            $page,

        'limit' =>
            $limit,

        'total' =>
            (int)$totalRecords,

        'total_pages' =>
            $total_pages,

        'has_next_page' =>
            $page < $total_pages,

        'has_previous_page' =>
            $page > 1,

        /*
        | BOM Data
        */

        'data' =>
            $data_output

    ]);
}


 
 /**
 * API: BOQ List
 *
 * Method: POST
 *
 * Payload:
 * {
 *     "client_id": 395,
 *     "page": 1,
 *     "limit": 20
 * }
 */
public function boq_list()
{
    header('Content-Type: application/json');

    $this->load->helper('api_helper');

    /*
    ============================================================
    VALIDATE TOKEN
    ============================================================
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {
        echo json_encode([
            'status'  => false,
            'message' => 'Invalid or expired token'
        ]);
        return;
    }

    $user_id = (int)$user->user_id;


    /*
    ============================================================
    GET USER ROLE / DESIGNATION
    ============================================================
    */

    $user_info = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_users')
        ->row();

    $account_details = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_account_details')
        ->row();

    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;

    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    ============================================================
    READ PAYLOAD
    ============================================================
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }

    $client_id = $json['client_id']
        ?? $this->input->get_post('client_id', true);

    $page = $json['page']
        ?? $this->input->get_post('page', true)
        ?? 1;

    $limit = $json['limit']
        ?? $this->input->get_post('limit', true)
        ?? 20;


    /*
    ============================================================
    VALIDATE CLIENT ID
    ============================================================
    */

    if (empty($client_id) || !is_numeric($client_id)) {
        echo json_encode([
            'status'  => false,
            'message' => 'client_id is required'
        ]);
        return;
    }

    $client_id = (int)$client_id;

    $page = (
        is_numeric($page) &&
        (int)$page > 0
    ) ? (int)$page : 1;

    $limit = (
        is_numeric($limit) &&
        (int)$limit > 0
    ) ? (int)$limit : 20;

    // Maximum limit
    if ($limit > 100) {
        $limit = 100;
    }

    $offset = ($page - 1) * $limit;


    /*
    ============================================================
    USER VISIBILITY
    ============================================================

    Admin + Special Designations
    => All clients

    Normal User
    => Assigned clients only
    ============================================================
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];

    $can_view_all_clients = (
        $user_type == 1 ||
        in_array(
            $designation_id,
            $all_client_designations
        )
    );


    /*
    ============================================================
    CHECK CLIENT ASSIGNMENT
    ============================================================
    */

    if (!$can_view_all_clients) {

        $assigned = $this->db
            ->where('client_id', $client_id)
            ->where('user_id', $user_id)
            ->get('tbl_client_assign_team')
            ->row();

        if (empty($assigned)) {
            echo json_encode([
                'status'  => false,
                'message' => 'You are not assigned to this client'
            ]);
            return;
        }
    }


    /*
    ============================================================
    GET CLIENT
    ============================================================
    */

    $client = $this->db
        ->select('
            client_id,
            client_sr_id,
            leads_id,
            name,
            email,
            mobile
        ')
        ->where('client_id', $client_id)
        ->get('tbl_client')
        ->row();

    if (empty($client)) {
        echo json_encode([
            'status'  => false,
            'message' => 'Client not found'
        ]);
        return;
    }


    /*
    ============================================================
    CHECK LEAD ID
    ============================================================

    BOQ / Proposal relation:

    tbl_client.leads_id
            =
    proposals.lead_id

    ============================================================
    */

    if (empty($client->leads_id)) {
        echo json_encode([
            'status'  => true,
            'message' => 'No BOQ found for this client',

            'client' => [
                'client_id'    => (int)$client->client_id,
                'client_sr_id' => $client->client_sr_id ?? '-',
                'client_name'  => $client->name ?? '-',
                'email'        => $client->email ?? '',
                'mobile'       => $client->mobile ?? ''
            ],

            'page'        => $page,
            'limit'       => $limit,
            'total'       => 0,
            'total_pages' => 0,
            'latest_boq'  => null,
            'old_boq'     => []
        ]);

        return;
    }


    /*
    ============================================================
    PRICE VIEW PERMISSION
    ============================================================
    */

    $show_price = false;

    /*
    Admin OR BOQ price permission
    */

    if (
        $user_type == 1 ||
        check_permission('boq_with_price_view')
    ) {
        $show_price = true;
    }


    /*
    ============================================================
    CHECK LEAD LEVEL PERMISSION
    ============================================================
    */

    $lead = $this->db
        ->select('permission')
        ->where(
            'leads_id',
            $client->leads_id
        )
        ->get('tbl_leads')
        ->row();

    if (
        !empty($lead) &&
        !empty($lead->permission)
    ) {

        $permission_array = json_decode(
            $lead->permission,
            true
        );

        if (
            is_array($permission_array) &&
            isset($permission_array[$user_id])
        ) {
            $show_price = true;
        }
    }


    /*
    ============================================================
    WITHOUT PRICE PDF PERMISSION
    ============================================================

    Mobile operation PDF URL ko direct return kar rahe hain.
    ============================================================
    */

    $can_view_without_price_pdf = true;


    /*
    ============================================================
    TOTAL BOQ COUNT
    ============================================================
    */

    $total_records = $this->db
        ->where(
            'lead_id',
            $client->leads_id
        )
        ->count_all_results('proposals');


    /*
    ============================================================
    FETCH BOQ LIST
    ============================================================

    Latest proposal = highest ID
    ============================================================
    */

    $boq_list = $this->db
        ->where(
            'lead_id',
            $client->leads_id
        )
        ->order_by('id', 'DESC')
        ->limit($limit, $offset)
        ->get('proposals')
        ->result();


    /*
    ============================================================
    FORMAT BOQ DATA
    ============================================================
    */

    $formatted_boq = [];

    foreach ($boq_list as $boq) {

        /*
        --------------------------------------------------------
        STATUS
        --------------------------------------------------------
        */

        $status = !empty($boq->status)
            ? $boq->status
            : '';


        /*
        ========================================================
        PDF WITH PRICE
        ========================================================

        Existing Admin PDF
        ========================================================
        */

        $pdf_with_price = base_url(
            'admin/proposals/pdf/generate_pdf/' .
            $boq->id . '/' .
            $client_id
        );


        /*
        ========================================================
        PDF WITHOUT PRICE
        ========================================================

        FINAL MOBILE URL

        Example:

        https://crm.hcinterior.in/mobileapi/client/
        operation_pdf/14903/395

        14903 = proposals.id
        395   = client_id

        ========================================================
        */

        $pdf_without_price = base_url(
            'mobileapi/client/operation_pdf/' .
            $boq->id . '/' .
            $client_id
        );


        /*
        ========================================================
        BOQ ITEM
        ========================================================
        */

        $item = [

            'id' => (int)$boq->id,

            'client_id' => $client_id,

            'lead_id' => isset($boq->lead_id)
                ? (int)$boq->lead_id
                : (int)$client->leads_id,

            'ref_no' => $boq->ref_no ?? '',

            'proposal_date' =>
                $boq->proposal_date ?? null,

            'phone' =>
                $boq->phone ?? '',

            'status' =>
                $status,

            'exclusive_product' =>
                !empty($boq->exclusive_product)
                    ? true
                    : false,

            /*
            ----------------------------------------------------
            PRICE PERMISSION
            ----------------------------------------------------
            */

            'can_view_price' =>
                $show_price,

            /*
            ----------------------------------------------------
            WITH PRICE PDF
            ----------------------------------------------------
            */

            'pdf_with_price' =>
                $show_price
                    ? $pdf_with_price
                    : null,

            /*
            ----------------------------------------------------
            WITHOUT PRICE PDF
            ----------------------------------------------------

            Always return mobile operation PDF URL
            ----------------------------------------------------
            */

            'pdf_without_price' =>
                $pdf_without_price
        ];


        /*
        ========================================================
        PRICE DATA
        ========================================================
        */

        if ($show_price) {

            $item['grand_total'] =
                isset($boq->grand_total)
                    ? (float)$boq->grand_total
                    : 0;

            $item['site_handling'] =
                isset($boq->siteHandling)
                    ? (float)$boq->siteHandling
                    : 0;

            $item['total_to_be_paid'] =
                isset($boq->totalToBePaid)
                    ? (float)$boq->totalToBePaid
                    : 0;

        } else {

            /*
            Unauthorized users ko price nahi milega
            */

            $item['grand_total'] = null;

            $item['site_handling'] = null;

            $item['total_to_be_paid'] = null;
        }


        /*
        Add BOQ
        */

        $formatted_boq[] = $item;
    }


    /*
    ============================================================
    LATEST BOQ + OLD BOQ
    ============================================================

    Page 1:
        First record = latest BOQ
        Remaining    = old BOQ

    Other pages:
        All records = old BOQ
    ============================================================
    */

    $latest_boq = null;
    $old_boq    = [];

    if (!empty($formatted_boq)) {

        if ($page == 1) {

            /*
            Latest BOQ
            */

            $latest_boq = $formatted_boq[0];


            /*
            Remaining BOQs
            */

            $old_boq = array_slice(
                $formatted_boq,
                1
            );

        } else {

            $old_boq = $formatted_boq;
        }
    }


    /*
    ============================================================
    PAGINATION
    ============================================================
    */

    $total_pages = $limit > 0
        ? (int)ceil($total_records / $limit)
        : 0;

    $has_next_page =
        $page < $total_pages;

    $has_previous_page =
        $page > 1;


    /*
    ============================================================
    FINAL RESPONSE
    ============================================================
    */

    echo json_encode([

        'status' => true,

        'message' =>
            'BOQ list fetched successfully',

        /*
        --------------------------------------------------------
        CLIENT
        --------------------------------------------------------
        */

        'client' => [

            'client_id' =>
                (int)$client->client_id,

            'client_sr_id' =>
                $client->client_sr_id ?? '-',

            'client_name' =>
                $client->name ?? '-',

            'email' =>
                $client->email ?? '',

            'mobile' =>
                $client->mobile ?? '',

            'lead_id' =>
                (int)$client->leads_id
        ],


        /*
        --------------------------------------------------------
        PERMISSIONS
        --------------------------------------------------------
        */

        'permissions' => [

            'can_view_price' =>
                $show_price,

            'can_view_without_price_pdf' =>
                $can_view_without_price_pdf
        ],


        /*
        --------------------------------------------------------
        PAGINATION
        --------------------------------------------------------
        */

        'page' =>
            $page,

        'limit' =>
            $limit,

        'total' =>
            (int)$total_records,

        'total_pages' =>
            $total_pages,

        'has_next_page' =>
            $has_next_page,

        'has_previous_page' =>
            $has_previous_page,


        /*
        --------------------------------------------------------
        BOQ DATA
        --------------------------------------------------------
        */

        'latest_boq' =>
            $latest_boq,

        'old_boq' =>
            $old_boq
    ]);
}

 public function operation_pdf($id = NULL, $client_id = NULL)
{
    /*
    |--------------------------------------------------------------------------
    | VALIDATE INPUT
    |--------------------------------------------------------------------------
    */

    if (empty($id) || empty($client_id)) {
        show_error('Proposal ID and Client ID are required.', 400);
        return;
    }

    $id        = (int)$id;
    $client_id = (int)$client_id;


    /*
    |--------------------------------------------------------------------------
    | GET CLIENT
    |--------------------------------------------------------------------------
    */

    $data['client_details'] = $this->db
        ->where('client_id', $client_id)
        ->get('tbl_client')
        ->row();

    if (empty($data['client_details'])) {
        show_404();
        return;
    }


    /*
    |--------------------------------------------------------------------------
    | GET PROPOSAL
    |--------------------------------------------------------------------------
    */

    $data['proposals_info'] = $this->db
        ->where('id', $id)
        ->get('proposals')
        ->row();

    if (empty($data['proposals_info'])) {
        show_404();
        return;
    }


    /*
    |--------------------------------------------------------------------------
    | SECURITY CHECK
    |--------------------------------------------------------------------------
    |
    | Make sure requested proposal actually belongs to this client's lead.
    |--------------------------------------------------------------------------
    */

    if (
        !empty($data['client_details']->leads_id) &&
        !empty($data['proposals_info']->lead_id) &&
        (int)$data['client_details']->leads_id !==
        (int)$data['proposals_info']->lead_id
    ) {
        show_error(
            'This proposal does not belong to this client.',
            403
        );
        return;
    }


    /*
    |--------------------------------------------------------------------------
    | BASIC PAGE DATA
    |--------------------------------------------------------------------------
    */

    $data['page']       = lang('sales');
    $data['sub_active'] = lang('proposals');
    $data['title']      = lang('proposals');
    $data['proposal_id'] = $id;
    $data['client_id']   = $client_id;


    /*
    |--------------------------------------------------------------------------
    | ALL CLIENTS
    |--------------------------------------------------------------------------
    |
    | Keep this because existing operation_pdf view may use it.
    |--------------------------------------------------------------------------
    */

    $this->proposal_model->_table_name = 'tbl_client';
    $this->proposal_model->_order_by   = 'client_id';

    $data['all_client'] =
        $this->proposal_model->get();


    /*
    |--------------------------------------------------------------------------
    | PERMISSION USERS
    |--------------------------------------------------------------------------
    */

    $data['permission_user'] =
        $this->proposal_model
            ->all_permission_user('140');


    /*
    |--------------------------------------------------------------------------
    | CATEGORY LOCATIONS
    |--------------------------------------------------------------------------
    */

    $this->proposal_model->_table_name =
        'tbl_category_location';

    $this->proposal_model->_order_by =
        'category_location';

    $data['category_location'] =
        $this->proposal_model->get_by([
            'category_location_id >' => 0
        ]);


    /*
    |--------------------------------------------------------------------------
    | MAIN CATEGORIES
    |--------------------------------------------------------------------------
    */

    $this->proposal_model->_table_name =
        'tbl_category';

    $this->proposal_model->_order_by =
        'category_name';

    $data['all_category'] =
        $this->proposal_model->get_by([
            'status'           => 1,
            'main_category_id' => 0
        ]);


    /*
    |--------------------------------------------------------------------------
    | SUB CATEGORIES
    |--------------------------------------------------------------------------
    */

    $data['all_subcategory'] =
        $this->proposal_model->get_by([
            'status'             => 1,
            'main_category_id !=' => 0
        ]);


    /*
    |--------------------------------------------------------------------------
    | LEADS
    |--------------------------------------------------------------------------
    */

    $data['leads'] = $this->db
        ->select('*')
        ->from('tbl_leads')
        ->order_by('contact_name', 'ASC')
        ->get()
        ->result();


    /*
    |--------------------------------------------------------------------------
    | PROPOSAL
    |--------------------------------------------------------------------------
    |
    | Keeping array format because existing PDF view may use:
    | $proposals[0]['...']
    |--------------------------------------------------------------------------
    */

    $data['proposals'] = $this->db
        ->select('*')
        ->from('proposals')
        ->where('id', $id)
        ->get()
        ->result_array();


    /*
    |--------------------------------------------------------------------------
    | PROPOSAL FLOORS
    |--------------------------------------------------------------------------
    */

    $data['proposal_floors'] = $this->db
        ->select('*')
        ->from('proposal_floors')
        ->where('proposal_id', $id)
        ->order_by('id', 'ASC')
        ->get()
        ->result_array();


    /*
    |--------------------------------------------------------------------------
    | FLOOR COUNT
    |--------------------------------------------------------------------------
    */

    $data['proposals_count'] = $this->db
        ->where('proposal_id', $id)
        ->count_all_results('proposal_floors');


    /*
    |--------------------------------------------------------------------------
    | FLOOR CATEGORIES
    |--------------------------------------------------------------------------
    */

    $data['proposal_floor_categories'] =
        $this->db
            ->select('*')
            ->from('proposal_floor_categories')
            ->where('proposal_id', $id)
            ->get()
            ->result_array();


    /*
    |--------------------------------------------------------------------------
    | PROPOSAL ITEMS
    |--------------------------------------------------------------------------
    */

    $data['proposal_items'] = $this->db
        ->select('
            pi.*,
            si.item_name AS saved_item_name,
            si.upload_file
        ')
        ->from('proposal_items pi')
        ->join(
            'tbl_saved_items si',
            'si.saved_items_id = pi.item_id',
            'left'
        )
        ->where('pi.proposal_id', $id)
        ->get()
        ->result_array();


    /*
    |--------------------------------------------------------------------------
    | ITEM IMAGE URL
    |--------------------------------------------------------------------------
    */

    if (!empty($data['proposal_items'])) {

        foreach ($data['proposal_items'] as &$item) {

            $item['image_url'] =
                base_url('uploads/no-image.png');

            if (empty($item['upload_file'])) {
                continue;
            }

            $files = json_decode(
                $item['upload_file'],
                true
            );

            if (
                !empty($files) &&
                is_array($files) &&
                !empty($files[0])
            ) {

                /*
                 * Prefer fileName because we already found
                 * stored fullPath can contain server filesystem path.
                 */

                if (!empty($files[0]['fileName'])) {

                    $item['image_url'] =
                        base_url(
                            'uploads/' .
                            $files[0]['fileName']
                        );

                } elseif (!empty($files[0]['path'])) {

                    $item['image_url'] =
                        base_url(
                            ltrim(
                                $files[0]['path'],
                                '/'
                            )
                        );
                }
            }
        }

        unset($item);
    }


    /*
    |--------------------------------------------------------------------------
    | ITEM ADDONS
    |--------------------------------------------------------------------------
    */

    $data['proposal_item_addons'] =
        $this->db
            ->select('*')
            ->from('proposal_item_addons')
            ->where('proposal_id', $id)
            ->get()
            ->result_array();


    /*
    |--------------------------------------------------------------------------
    | EXCLUSIVE PRODUCTS
    |--------------------------------------------------------------------------
    */

    $data['exclusive_product'] =
        $this->db
            ->select('*')
            ->from('exclusive_product')
            ->where('proposals_id', $id)
            ->get()
            ->result_array();


    /*
    |--------------------------------------------------------------------------
    | DOMPDF OPTIONS
    |--------------------------------------------------------------------------
    */

    $options = new Options();

    $options->set(
        'isHtml5ParserEnabled',
        true
    );

    $options->set(
        'isRemoteEnabled',
        true
    );


    /*
    |--------------------------------------------------------------------------
    | CREATE DOMPDF
    |--------------------------------------------------------------------------
    */

    $dompdf = new Dompdf($options);


    /*
    |--------------------------------------------------------------------------
    | LOAD EXISTING PDF VIEW
    |--------------------------------------------------------------------------
    |
    | Same existing view:
    |
    | application/views/admin/proposals/hcinvoice/operation_pdf.php
    |--------------------------------------------------------------------------
    */

    $html = $this->load->view(
        'admin/proposals/hcinvoice/operation_pdf',
        $data,
        TRUE
    );


    /*
    |--------------------------------------------------------------------------
    | GENERATE PDF
    |--------------------------------------------------------------------------
    */

    $dompdf->loadHtml($html);

    $dompdf->setPaper(
        'A4',
        'portrait'
    );

    $dompdf->render();


    /*
    |--------------------------------------------------------------------------
    | DISPLAY PDF IN BROWSER
    |--------------------------------------------------------------------------
    |
    | Attachment false = browser me open hoga.
    |--------------------------------------------------------------------------
    */

    $dompdf->stream(
        'Proposal_' . $id . '.pdf',
        [
            'Attachment' => false
        ]
    );

    exit;
}


/**
 * API: Execution Timeline List
 *
 * Method: POST
 *
 * Payload:
 * {
 *     "client_id": 395
 * }
 */
public function execution_timeline()
{
    header('Content-Type: application/json');

    $this->load->helper('api_helper');

    /*
    ============================================================
    VALIDATE TOKEN
    ============================================================
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {
        echo json_encode([
            'status'  => false,
            'message' => 'Invalid or expired token'
        ]);
        return;
    }

    $user_id = (int)$user->user_id;


    /*
    ============================================================
    GET USER INFO
    ============================================================
    */

    $user_info = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_users')
        ->row();

    $account_details = $this->db
        ->where('user_id', $user_id)
        ->get('tbl_account_details')
        ->row();

    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;

    $designation_id = !empty($account_details)
        ? (int)$account_details->designations_id
        : 0;


    /*
    ============================================================
    READ PAYLOAD
    ============================================================
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }

    $client_id = $json['client_id']
        ?? $this->input->get_post('client_id', true);


    /*
    ============================================================
    CLIENT ID REQUIRED
    ============================================================
    */

    if (empty($client_id) || !is_numeric($client_id)) {
        echo json_encode([
            'status'  => false,
            'message' => 'client_id is required'
        ]);
        return;
    }

    $client_id = (int)$client_id;


    /*
    ============================================================
    CHECK CLIENT EXISTS
    ============================================================
    */

    $client = $this->db
        ->select('
            client_id,
            client_sr_id,
            name,
            email,
            mobile
        ')
        ->where('client_id', $client_id)
        ->get('tbl_client')
        ->row();

    if (empty($client)) {
        echo json_encode([
            'status'  => false,
            'message' => 'Client not found'
        ]);
        return;
    }


    /*
    ============================================================
    CLIENT VISIBILITY
    ============================================================
    */

    $all_client_designations = [
        45,
        39,
        76,
        71,
        72,
        77,
        128
    ];

    $can_view_all_clients = (
        $user_type == 1 ||
        in_array(
            $designation_id,
            $all_client_designations
        )
    );


    /*
    ============================================================
    CHECK CLIENT ASSIGNMENT
    ============================================================

    Admin / Special Designation
        => Any client

    Normal User
        => Assigned client only
    ============================================================
    */

    if (!$can_view_all_clients) {

        $assigned = $this->db
            ->where('client_id', $client_id)
            ->where('user_id', $user_id)
            ->get('tbl_client_assign_team')
            ->row();

        if (empty($assigned)) {
            echo json_encode([
                'status'  => false,
                'message' => 'You are not assigned to this client'
            ]);
            return;
        }
    }


    /*
    ============================================================
    PERMISSIONS
    ============================================================
    */

    $can_view_timeline = (
        $user_type == 1 ||
        check_permission('execution_timeline_only_view') ||
        check_permission('execution_timeline_edit')
    );

    $can_edit_timeline = (
        $user_type == 1 ||
        check_permission('execution_timeline_edit')
    );


    /*
    ============================================================
    VIEW PERMISSION CHECK
    ============================================================
    */

    // if (!$can_view_timeline) {
        // echo json_encode([
            // 'status'  => false,
            // 'message' => 'You do not have permission to view execution timeline'
        // ]);
        // return;
    // }


    /*
    ============================================================
    CHECK EXISTING TIMELINE
    ============================================================
    */

    $existing = $this->db
        ->where('client_id', $client_id)
        ->count_all_results('tbl_client_timeline');


    /*
    ============================================================
    CREATE DEFAULT TIMELINE
    ============================================================

    Agar client ki timeline nahi bani hai,
    to default tasks automatically create honge.
    ============================================================
    */

    if ($existing == 0) {

        $tasks = [
            'KT meetings done',
            'documentation',
            'call to cx',
            'cx end documenattion done',
            'floor protection order',
            'electrical material order',
            'plumbing material order',
            'Demolition',
            'debris removal',
            'civil material order',
            'brick work + few repairing',
            'plaster',
            'falceiling gypsum with ceiling electrical',
            'Kitchen ceiling (punning)',
            'wall punning',
            'internal plumbing of kitchen',
            'internal plumbing of washrooms 2nos',
            'water proofing other areas on plater',
            'slab casting',
            'PCC of bathroom',
            'Tiling bathroom',
            'tiling of all rooms and living and kitchen',
            'SS gate order',
            'Repairing of chiseling and dhar core',
            'validation',
            'Wall electrical',
            'Aluminium measurement',
            'ceiling light installation',
            'Putty & primer base coat',
            'cleaning of all civil and debris',
            'dispatch',
            'carpenter align same day hardware check with BOM and hardware list',
            'mail to factory if wooden 1st slot and final slot have gap more hen 3 days',
            'kitchen counter top installation & dedo tile isnatllation',
            'handover',
            'deepcleaning',
            'make snag list',
            'closing with final touchup Final touchup'
        ];


        /*
        --------------------------------------------------------
        INSERT DEFAULT TASKS
        --------------------------------------------------------
        */

        $insert_data = [];

        foreach ($tasks as $task) {

            $insert_data[] = [
                'client_id' => $client_id,
                'task_name' => $task
            ];
        }


        if (!empty($insert_data)) {

            $this->db->insert_batch(
                'tbl_client_timeline',
                $insert_data
            );
        }
    }


    /*
    ============================================================
    FETCH TIMELINE
    ============================================================
    */

    $timeline = $this->db
        ->where('client_id', $client_id)
        ->order_by('id', 'ASC')
        ->get('tbl_client_timeline')
        ->result();


    /*
    ============================================================
    FORMAT TIMELINE
    ============================================================
    */

    $timeline_data = [];

    foreach ($timeline as $row) {

        /*
        --------------------------------------------------------
        FORMAT START DATE
        --------------------------------------------------------
        */

        $start_date = null;

        if (
            !empty($row->start_date) &&
            $row->start_date != '0000-00-00'
        ) {
            $start_date = date(
                'Y-m-d',
                strtotime($row->start_date)
            );
        }


        /*
        --------------------------------------------------------
        FORMAT END DATE
        --------------------------------------------------------
        */

        $end_date = null;

        if (
            !empty($row->end_date) &&
            $row->end_date != '0000-00-00'
        ) {
            $end_date = date(
                'Y-m-d',
                strtotime($row->end_date)
            );
        }


        /*
        --------------------------------------------------------
        DURATION
        --------------------------------------------------------
        */

        $duration = !empty($row->duration)
            ? (int)$row->duration
            : 0;


        /*
        --------------------------------------------------------
        VALIDATION SPECIAL ROW
        --------------------------------------------------------
        */

        $is_validation = (
            strtolower(trim($row->task_name)) === 'validation'
        );


        /*
        --------------------------------------------------------
        OUTPUT
        --------------------------------------------------------
        */

        $timeline_data[] = [

            'id' =>
                (int)$row->id,

            'client_id' =>
                (int)$row->client_id,

            'task_name' =>
                $row->task_name,

            'start_date' =>
                $start_date,

            'end_date' =>
                $end_date,

            'duration' =>
                $duration,

            'is_validation' =>
                $is_validation
        ];
    }


    /*
    ============================================================
    RESPONSE
    ============================================================
    */

    echo json_encode([

        'status' => true,

        'message' =>
            'Execution timeline fetched successfully',

        /*
        --------------------------------------------------------
        CLIENT
        --------------------------------------------------------
        */

        'client' => [

            'client_id' =>
                (int)$client->client_id,

            'client_sr_id' =>
                $client->client_sr_id ?? '-',

            'client_name' =>
                $client->name ?? '-',

            'email' =>
                $client->email ?? '',

            'mobile' =>
                $client->mobile ?? ''
        ],


        /*
        --------------------------------------------------------
        PERMISSIONS
        --------------------------------------------------------
        */

        'permissions' => [

            'can_view' =>
                $can_view_timeline,

            'can_edit' =>
                $can_edit_timeline
        ],


        /*
        --------------------------------------------------------
        TOTAL
        --------------------------------------------------------
        */

        'total' =>
            count($timeline_data),


        /*
        --------------------------------------------------------
        TIMELINE
        --------------------------------------------------------
        */

        'data' =>
            $timeline_data
    ]);
}
 
 
 
 /**
 * API: Update Execution Timeline
 *
 * Method: POST
 *
 * Payload:
 * {
 *     "client_id": 395,
 *     "tasks": [
 *         {
 *             "id": 1,
 *             "start_date": "2026-08-01",
 *             "end_date": "2026-08-05"
 *         },
 *         {
 *             "id": 2,
 *             "start_date": "2026-08-06",
 *             "end_date": "2026-08-10"
 *         }
 *     ]
 * }
 */
public function update_timeline()
{
    header('Content-Type: application/json');

    $this->load->helper('api_helper');

    /*
    ============================================================
    VALIDATE TOKEN
    ============================================================
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {
        echo json_encode([
            'status'  => false,
            'message' => 'Invalid or expired token'
        ]);
        return;
    }

    $logged_user_id = (int)$user->user_id;


    /*
    ============================================================
    GET USER ROLE
    ============================================================
    */

    $user_info = $this->db
        ->where('user_id', $logged_user_id)
        ->get('tbl_users')
        ->row();

    $user_type = !empty($user_info)
        ? (int)$user_info->role_id
        : 0;


    /*
    ============================================================
    READ JSON PAYLOAD
    ============================================================
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }

    $client_id = $json['client_id'] ?? null;
    $tasks     = $json['tasks'] ?? [];


    /*
    ============================================================
    VALIDATE CLIENT ID
    ============================================================
    */

    if (empty($client_id) || !is_numeric($client_id)) {

        echo json_encode([
            'status'  => false,
            'message' => 'client_id is required'
        ]);

        return;
    }

    $client_id = (int)$client_id;


    /*
    ============================================================
    VALIDATE TASKS
    ============================================================
    */

    if (empty($tasks) || !is_array($tasks)) {

        echo json_encode([
            'status'  => false,
            'message' => 'tasks are required'
        ]);

        return;
    }


    /*
    ============================================================
    CHECK CLIENT
    ============================================================
    */

    $client = $this->db
        ->select('
            client_id,
            client_sr_id,
            name
        ')
        ->where('client_id', $client_id)
        ->get('tbl_client')
        ->row();


    if (empty($client)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Client not found'
        ]);

        return;
    }


    /*
    ============================================================
    CHECK EDIT PERMISSION
    ============================================================
    */

    $can_edit = (
        $user_type == 1 ||
        check_permission('execution_timeline_edit')
    );


    // if (!$can_edit) {

        // echo json_encode([
            // 'status'  => false,
            // 'message' => 'You do not have permission to update execution timeline'
        // ]);

        // return;
    // }


    /*
    ============================================================
    UPDATE TIMELINE
    ============================================================
    */

    $updated_tasks = [];
    $errors        = [];


    foreach ($tasks as $task) {

        /*
        --------------------------------------------------------
        CHECK TASK ID
        --------------------------------------------------------
        */

        if (empty($task['id']) || !is_numeric($task['id'])) {

            $errors[] = [
                'id'      => $task['id'] ?? null,
                'message' => 'Invalid task id'
            ];

            continue;
        }

        $task_id = (int)$task['id'];


        /*
        --------------------------------------------------------
        MAKE SURE TASK BELONGS TO CLIENT
        --------------------------------------------------------
        */

        $timeline_task = $this->db
            ->where('id', $task_id)
            ->where('client_id', $client_id)
            ->get('tbl_client_timeline')
            ->row();


        if (empty($timeline_task)) {

            $errors[] = [
                'id'      => $task_id,
                'message' => 'Task not found for this client'
            ];

            continue;
        }


        /*
        --------------------------------------------------------
        START / END DATE
        --------------------------------------------------------
        */

        $start = !empty($task['start_date'])
            ? trim($task['start_date'])
            : null;

        $end = !empty($task['end_date'])
            ? trim($task['end_date'])
            : null;


        /*
        --------------------------------------------------------
        VALIDATE START DATE
        --------------------------------------------------------
        */

        if (!empty($start)) {

            $start_check = DateTime::createFromFormat(
                'Y-m-d',
                $start
            );

            if (
                !$start_check ||
                $start_check->format('Y-m-d') !== $start
            ) {

                $errors[] = [
                    'id'      => $task_id,
                    'message' => 'Invalid start_date. Format must be Y-m-d'
                ];

                continue;
            }
        }


        /*
        --------------------------------------------------------
        VALIDATE END DATE
        --------------------------------------------------------
        */

        if (!empty($end)) {

            $end_check = DateTime::createFromFormat(
                'Y-m-d',
                $end
            );

            if (
                !$end_check ||
                $end_check->format('Y-m-d') !== $end
            ) {

                $errors[] = [
                    'id'      => $task_id,
                    'message' => 'Invalid end_date. Format must be Y-m-d'
                ];

                continue;
            }
        }


        /*
        ========================================================
        CALCULATE DURATION
        ========================================================

        Example:

        Start: 2026-08-01
        End:   2026-08-05

        Difference = 4 Days
        ========================================================
        */

        $duration = null;


        if (!empty($start) && !empty($end)) {

            $start_date = new DateTime($start);
            $end_date   = new DateTime($end);


            /*
            ----------------------------------------------------
            END DATE BEFORE START DATE
            ----------------------------------------------------
            */

            if ($end_date < $start_date) {

                $errors[] = [
                    'id'      => $task_id,
                    'message' => 'End date cannot be before start date'
                ];

                continue;
            }


            /*
            ----------------------------------------------------
            DATE DIFFERENCE
            ----------------------------------------------------
            */

            $diff = $start_date->diff($end_date);

            $duration = (int)$diff->days;
        }


        /*
        ========================================================
        UPDATE DATABASE
        ========================================================
        */

        $update_data = [

            'start_date' =>
                $start,

            'end_date' =>
                $end,

            'duration' =>
                $duration
        ];


        $this->db
            ->where('id', $task_id)
            ->where('client_id', $client_id)
            ->update(
                'tbl_client_timeline',
                $update_data
            );


        /*
        --------------------------------------------------------
        CHECK UPDATE
        --------------------------------------------------------
        */

        if ($this->db->error()['code'] != 0) {

            $errors[] = [
                'id'      => $task_id,
                'message' => 'Database update failed'
            ];

            continue;
        }


        /*
        --------------------------------------------------------
        UPDATED TASK RESPONSE
        --------------------------------------------------------
        */

        $updated_tasks[] = [

            'id' =>
                $task_id,

            'task_name' =>
                $timeline_task->task_name,

            'start_date' =>
                $start,

            'end_date' =>
                $end,

            'duration' =>
                $duration
        ];
    }


    /*
    ============================================================
    SEND NOTIFICATIONS
    ============================================================

    Notification only if at least one task updated.
    ============================================================
    */

    if (!empty($updated_tasks)) {

        $team_members =
            get_client_team_members($client_id);


        $allowed_roles = [
            'Designer',
            'Project Coordinator',
            'SPM',
            'Operation Manager'
        ];


        if (!empty($team_members)) {

            foreach ($team_members as $member) {

                $role    = $member->member_profile;
                $user_id = (int)$member->user_id;


                /*
                ------------------------------------------------
                ALLOWED ROLE ONLY
                ------------------------------------------------
                */

                if (!in_array($role, $allowed_roles)) {
                    continue;
                }


                /*
                ------------------------------------------------
                DON'T NOTIFY CURRENT USER
                ------------------------------------------------
                */

                if ($user_id == $logged_user_id) {
                    continue;
                }


                /*
                ------------------------------------------------
                MESSAGE
                ------------------------------------------------
                */

                $clientName =
                    $client->name ?? 'N/A';


                $message =
                    'Execution timeline for ' .
                    $clientName .
                    ' is updated';


                /*
                ------------------------------------------------
                ADD NOTIFICATION
                ------------------------------------------------
                */

                add_notification([

                    'to_user_id' =>
                        $user_id,

                    'from_user_id' =>
                        $logged_user_id,

                    'description' =>
                        $message,

                    'link' =>
                        'admin/client/details/' .
                        $client_id .
                        '/project_timeline',

                    'value' =>
                        $message
                ]);


                /*
                ------------------------------------------------
                SHOW NOTIFICATION
                ------------------------------------------------
                */

                show_notification([
                    $user_id
                ]);
            }
        }
    }


    /*
    ============================================================
    FINAL RESPONSE
    ============================================================
    */

    echo json_encode([

        'status' =>
            !empty($updated_tasks),

        'message' =>
            !empty($updated_tasks)
                ? 'Timeline updated successfully'
                : 'No timeline tasks were updated',

        'client' => [

            'client_id' =>
                (int)$client->client_id,

            'client_sr_id' =>
                $client->client_sr_id ?? '-',

            'client_name' =>
                $client->name ?? '-'
        ],

        'total_updated' =>
            count($updated_tasks),

        'total_errors' =>
            count($errors),

        'updated_tasks' =>
            $updated_tasks,

        'errors' =>
            $errors
    ]);
}



/**
 * API: Create / Save Escalation
 *
 * Method: POST
 *
 * Payload:
 * {
 *     "client_id": 395,
 *     "assigned_to": 25,
 *     "remark": "Client issue regarding site work"
 * }
 */
public function create_escalation()
{
    header('Content-Type: application/json');

    $this->load->helper('api_helper');

    /*
    ============================================================
    VALIDATE TOKEN
    ============================================================
    */

    $user = validate_api_token();

    if (empty($user) || empty($user->user_id)) {
        echo json_encode([
            'status'  => false,
            'message' => 'Invalid or expired token'
        ]);
        return;
    }

    $logged_user_id = (int)$user->user_id;


    /*
    ============================================================
    READ JSON / POST PAYLOAD
    ============================================================
    */

    $json = json_decode(
        file_get_contents('php://input'),
        true
    );

    if (!is_array($json)) {
        $json = [];
    }

    $client_id = $json['client_id']
        ?? $this->input->get_post('client_id', true);

    $assigned_to = $json['assigned_to']
        ?? $this->input->get_post('assigned_to', true);

    $remark = $json['remark']
        ?? $this->input->get_post('remark', true);


    /*
    ============================================================
    VALIDATE CLIENT ID
    ============================================================
    */

    if (empty($client_id) || !is_numeric($client_id)) {
        echo json_encode([
            'status'  => false,
            'message' => 'client_id is required'
        ]);
        return;
    }

    $client_id = (int)$client_id;


    /*
    ============================================================
    VALIDATE ASSIGNED TO
    ============================================================
    */

    if (empty($assigned_to) || !is_numeric($assigned_to)) {
        echo json_encode([
            'status'  => false,
            'message' => 'assigned_to is required'
        ]);
        return;
    }

    $assigned_to = (int)$assigned_to;


    /*
    ============================================================
    VALIDATE REMARK
    ============================================================
    */

    if (empty(trim((string)$remark))) {
        echo json_encode([
            'status'  => false,
            'message' => 'remark is required'
        ]);
        return;
    }

    $remark = trim($remark);


    /*
    ============================================================
    CHECK CLIENT EXISTS
    ============================================================
    */

    $client = $this->db
        ->select('
            client_id,
            client_sr_id,
            name
        ')
        ->where('client_id', $client_id)
        ->get('tbl_client')
        ->row();

    if (empty($client)) {
        echo json_encode([
            'status'  => false,
            'message' => 'Client not found'
        ]);
        return;
    }


    /*
    ============================================================
    CHECK ASSIGNED USER EXISTS
    ============================================================
    */

    $assigned_user = $this->db
        ->select('
            user_id,
            fullname
        ')
        ->where('user_id', $assigned_to)
        ->get('tbl_account_details')
        ->row();

    if (empty($assigned_user)) {
        echo json_encode([
            'status'  => false,
            'message' => 'Assigned user not found'
        ]);
        return;
    }


    /*
    ============================================================
    CHECK ACTIVE ESCALATION
    ============================================================

    Same Client + Same Assigned User

    Active statuses:
    - Open
    - Replied
    - Reopened

    Agar already active escalation hai to new create nahi hogi.
    ============================================================
    */

    $exists = $this->db
        ->where('client_id', $client_id)
        ->where('assigned_to', $assigned_to)
        ->where_in(
            'status',
            [
                'Open',
                'Replied',
                'Reopened'
            ]
        )
        ->order_by('id', 'DESC')
        ->get('tbl_client_escalation')
        ->row();


    if (!empty($exists)) {

        echo json_encode([
            'status'  => false,
            'message' => 'Active escalation already exists. Please reply on it.',

            'existing_escalation' => [
                'id'          => (int)$exists->id,
                'client_id'   => (int)$exists->client_id,
                'raised_by'   => (int)$exists->raised_by,
                'assigned_to' => (int)$exists->assigned_to,
                'remark'      => $exists->remark,
                'status'      => $exists->status,
                'created_at'  => $exists->created_at
            ]
        ]);

        return;
    }


    /*
    ============================================================
    PREPARE ESCALATION DATA
    ============================================================
    */

    $data = [
        'client_id'   => $client_id,
        'raised_by'   => $logged_user_id,
        'assigned_to' => $assigned_to,
        'remark'      => $remark,
        'status'      => 'Open',
        'created_at'  => date('Y-m-d H:i:s')
    ];


    /*
    ============================================================
    INSERT ESCALATION
    ============================================================
    */

    $insert = $this->db->insert(
        'tbl_client_escalation',
        $data
    );


    /*
    ============================================================
    CHECK INSERT
    ============================================================
    */

    if (!$insert) {

        $db_error = $this->db->error();

        echo json_encode([
            'status'  => false,
            'message' => 'Failed to create escalation',
            'error'   => $db_error['message'] ?? ''
        ]);

        return;
    }


    /*
    ============================================================
    GET INSERTED ID
    ============================================================
    */

    $escalation_id = $this->db->insert_id();


    /*
    ============================================================
    FETCH CREATED ESCALATION
    ============================================================
    */

    $escalation = $this->db
        ->select('
            e.*,
            c.name AS client_name,
            c.client_sr_id,
            r.fullname AS raised_by_name,
            a.fullname AS assigned_to_name
        ')
        ->from('tbl_client_escalation e')
        ->join(
            'tbl_client c',
            'c.client_id = e.client_id',
            'left'
        )
        ->join(
            'tbl_account_details r',
            'r.user_id = e.raised_by',
            'left'
        )
        ->join(
            'tbl_account_details a',
            'a.user_id = e.assigned_to',
            'left'
        )
        ->where('e.id', $escalation_id)
        ->get()
        ->row();


    /*
    ============================================================
    SUCCESS RESPONSE
    ============================================================
    */

    echo json_encode([
        'status'  => true,
        'message' => 'Escalation created successfully',

        'data' => [
            'id' => (int)$escalation->id,

            'client_id' => (int)$escalation->client_id,

            'client_sr_id' =>
                $escalation->client_sr_id ?? '-',

            'client_name' =>
                $escalation->client_name ?? '-',

            'raised_by' =>
                (int)$escalation->raised_by,

            'raised_by_name' =>
                $escalation->raised_by_name ?? '-',

            'assigned_to' =>
                (int)$escalation->assigned_to,

            'assigned_to_name' =>
                $escalation->assigned_to_name ?? '-',

            'remark' =>
                $escalation->remark,

            'status' =>
                $escalation->status,

            'created_at' =>
                $escalation->created_at
        ]
    ]);
}


/**
 * API: Create / Update On Site Purchase
 *
 * Method: POST
 *
 * Payload:
 * {
 *     "client_id": 395,
 *     "file_name": "Kitchen Material",
 *     "upload_url": "https://drive.google.com/...",
 *     "files": [
 *         "temp_file_id_1",
 *         "temp_file_id_2"
 *     ]
 * }
 *
 * For update:
 * {
 *     "id": 10,
 *     "client_id": 395,
 *     ...
 * }
 */
 
 public function new_on_site_purchase()
{
    header('Content-Type: application/json');
    $this->load->helper('api_helper');

    // Validate token
    $user = validate_api_token();

    if (!$user) {
        echo json_encode([
            'status' => false,
            'message' => 'Invalid or expired API token'
        ]);
        return;
    }

    $user_id    = $user->user_id;
    $client_id  = $this->input->post('client_id', true);
    $file_name  = $this->input->post('file_name', true);
    $brand  = $this->input->post('brand', true);
    $site_message  = $this->input->post('message', true);
    $upload_url = $this->input->post('upload_url', true);

    // Validate client
    if (empty($client_id)) {
        echo json_encode([
            'status' => false,
            'message' => 'client_id is required'
        ]);
        return;
    }

    $client = $this->db
        ->where('client_id', $client_id)
        ->get('tbl_client')
        ->row();

    if (!$client) {
        echo json_encode([
            'status' => false,
            'message' => 'Client not found'
        ]);
        return;
    }

    // Upload directory
    $upload_path = FCPATH . 'uploads/';

    if (!is_dir($upload_path)) {
        mkdir($upload_path, 0777, true);
    }

    $upload_file = [];

    // File upload
    if (isset($_FILES['files']) && !empty($_FILES['files']['name'])) {

        $file = $_FILES['files'];

        if ($file['error'] !== UPLOAD_ERR_OK) {
            echo json_encode([
                'status' => false,
                'message' => 'File upload failed',
                'error' => $file['error']
            ]);
            return;
        }

        $original_name = $file['name'];
        $extension = pathinfo($original_name, PATHINFO_EXTENSION);
        $new_file_name = uniqid('', true) . '.' . $extension;
        $destination = $upload_path . $new_file_name;

        if (!move_uploaded_file($file['tmp_name'], $destination)) {
            echo json_encode([
                'status' => false,
                'message' => 'Unable to move uploaded file'
            ]);
            return;
        }

        $image_extensions = ['jpg', 'jpeg', 'png', 'gif', 'webp'];
        $is_image = in_array(strtolower($extension), $image_extensions) ? 1 : 0;

        $upload_file[] = [
            'fileName'  => $new_file_name,
            'path'      => 'uploads/' . $new_file_name,
            'fullPath'  => $destination,
            'ext'       => '.' . strtolower($extension),
            'size'      => round($file['size'] / 1000, 2),
            'is_image'  => $is_image,
            'file_url'  => base_url('uploads/' . $new_file_name)
        ];
    }

    // Save record
    $save_data = [
        'client_id'   => $client_id,
        'file_name'   => $file_name,
        'brand'   => $brand,
        'message'   => $site_message,
        'upload_url'  => $upload_url,
        'upload_file' => !empty($upload_file) ? json_encode($upload_file) : null,
        'created_date'=> date('Y-m-d H:i:s'),
        'updated_date'=> date('Y-m-d H:i:s')
    ];

    $this->db->insert('tbl_client_on_site_purchase', $save_data);
    $insert_id = $this->db->insert_id();

    if (!$insert_id) {
        echo json_encode([
            'status' => false,
            'message' => 'Unable to create on site purchase request'
        ]);
        return;
    }

    // Notifications
    $team_members = get_client_team_members($client_id);
    $allowed_roles = [
        'SPM',
        'Factory Purchase Team',
        'Project Manager',
        'Factory Store'
    ];

    foreach ($team_members as $member) {

        if (!in_array($member->member_profile, $allowed_roles)) {
            continue;
        }

        if ($member->user_id == $user_id) {
            continue;
        }

        $message = 'On site purchase request has been issued for '
            . ($client->name ?? 'N/A');

        add_notification([
            'to_user_id'   => $member->user_id,
            'from_user_id' => $user_id,
            'description'  => $message,
            'link'         => 'admin/client/details/' . $client_id . '/purchase_request',
            'value'        => $message
        ]);

        show_notification([$member->user_id]);
    }

    // Response file URL
    $response_files = [];

    foreach ($upload_file as $file) {
        $response_files[] = [
            'fileName' => $file['fileName'],
            'path'     => $file['path'],
           // 'fullPath' => $file['fullPath'],
            'ext'      => $file['ext'],
            'size'     => $file['size'],
            'is_image' => $file['is_image'],
            'file_url' => base_url($file['path'])
        ];
    }

    echo json_encode([
        'status'  => true,
        'message' => 'On site purchase request created successfully',
        'data'    => [
            'id'           => (int)$insert_id,
            'client_id'    => (int)$client_id,
            'file_name'    => $file_name,
            'site_message'    => $site_message,
            'brand'    => $brand,
            'upload_url'   => $upload_url,
            'upload_file'  => $response_files,
            'created_date' => $save_data['created_date'],
            'updated_date' => $save_data['updated_date'],
            'client_name'  => $client->name ?? '-',
            'client_sr_id' => $client->client_sr_id ?? '-'
        ]
    ]);
}
 
}