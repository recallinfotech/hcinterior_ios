<?php
defined('BASEPATH') OR exit('No direct script access allowed');

require_once FCPATH . 'vendor/autoload.php'; 
use Google\Client as Google_Client;

class Notification_lib {

    protected $CI;
    private $serviceAccountKeyPath;
    private $projectId;

    public function __construct() {
        $this->CI =& get_instance();
        $this->serviceAccountKeyPath = APPPATH . 'third_party/firebase-key.json';
        $this->projectId = 'hc-interior';
    }

    public function send_app_notification($title, $body, $image_url = null, $token = null)
    {
        if (empty($token)) return ['status' => 'error', 'message' => 'FCM token missing'];
        $image_url = $image_url ?? "https://hcinterior.in/static-images/promo.jpg";

        try {
            $client = new Google_Client();
            $client->setAuthConfig($this->serviceAccountKeyPath);
            $client->addScope('https://www.googleapis.com/auth/firebase.messaging');
            $accessToken = $client->fetchAccessTokenWithAssertion();
            $bearerToken = $accessToken['access_token'];
        } catch (Exception $e) {
            return ['status' => 'error', 'message' => 'Auth Failed: ' . $e->getMessage()];
        }

        $messagePayload = [
            'message' => [
                'token' => $token,
                'notification' => [
                    'title' => $title,
                    'body' => $body,
                    'image' => $image_url
                ],
                'data' => [
                    'click_action' => 'FLUTTER_NOTIFICATION_CLICK',
                    'sound' => 'default'
                ]
            ]
        ];

        $curl = curl_init();
        curl_setopt_array($curl, [
            CURLOPT_URL => "https://fcm.googleapis.com/v1/projects/{$this->projectId}/messages:send",
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_CUSTOMREQUEST => 'POST',
            CURLOPT_POSTFIELDS => json_encode($messagePayload),
            CURLOPT_HTTPHEADER => [
                "Authorization: Bearer $bearerToken",
                'Content-Type: application/json'
            ],
        ]);

        $response_fcm = curl_exec($curl);
        $curl_error = curl_error($curl);
        curl_close($curl);

        if ($curl_error) {
            return ['status' => 'error', 'message' => $curl_error];
        }

        $decoded = json_decode($response_fcm, true);
        return isset($decoded['name'])
            ? ['status' => 'success', 'message' => 'Notification sent successfully ✅', 'fcm_response' => $decoded]
            : ['status' => 'error', 'message' => 'Unexpected FCM response', 'fcm_response' => $decoded];
    }
}
